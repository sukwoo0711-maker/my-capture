<Project>
  <PropertyGroup>
    <!-- This opt-in build tool has no product or package dependency. -->
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <BaseIntermediateOutputPath>$(ProbeBuildRoot)\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(ProbeBuildRoot)\bin\</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>WindowsProjectionProbe</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestoreSources>$(ProbeBuildRoot)\packages</RestoreSources>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <Target Name="RequireIsolatedProbeBuild" BeforeTargets="Restore;PrepareForBuild">
    <Error Condition="'$(ProbeBuildRoot)' == ''" Text="ProbeBuildRoot is required; use this run's isolated temporary directory." />
    <MakeDir Directories="$(ProbeBuildRoot)\packages" />
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
