<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store package manifest template. build\package-store.ps1 replaces the braced
  placeholders with the Partner Center product identity and the release version; real
  identity values are passed on the command line and never committed here.

  The app runs as a packaged full-trust desktop app. Its AppData and HKCU writes are
  virtualized, so the app keeps its library in the package's LocalState, registers
  launch-at-login through the startup task below, and leaves updates to the Store.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:uap11="http://schemas.microsoft.com/appx/manifest/uap/windows10/11"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 uap11 desktop rescap">

  <Identity
    Name="{IdentityName}"
    Publisher="{Publisher}"
    Version="{PackageVersion}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{DisplayName}</DisplayName>
    <PublisherDisplayName>{PublisherDisplayName}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="{MaxVersionTested}" />
  </Dependencies>

  <Resources>
    <Resource Language="ko-KR" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application
      Id="MyCapture"
      Executable="MyCapture.exe"
      uap10:RuntimeBehavior="packagedClassicApp"
      uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        DisplayName="{DisplayName}"
        Description="Screenshots, pins, local OCR, annotation and screen recording."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Ships disabled: only the user turns launch-at-login on, in MyCapture settings or
             Windows Settings. TaskId must match PackagedStartupRegistration.TaskId. -->
        <desktop:Extension
          Category="windows.startupTask"
          Executable="MyCapture.exe"
          EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="MyCaptureStartup" Enabled="false" DisplayName="{DisplayName}" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- General-use (no Store approval). Required for GraphicsCaptureAccess.RequestAccessAsync(Borderless)
         and GraphicsCaptureSession.IsBorderRequired = false, so Windows Graphics Capture recordings run
         without the yellow capture border. graphicsCaptureProgrammatic is not declared: it is only
         required to create a capture item from a WindowId or DisplayId, and recordings use
         IGraphicsCaptureItemInterop.CreateForMonitor. -->
    <uap11:Capability Name="graphicsCaptureWithoutBorder" />
  </Capabilities>
</Package>
