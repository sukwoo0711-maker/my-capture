[
  {"text": "The device operates from a 1.8 V to 3.6 V power supply and consumes 2.1 µA in Stop mode with RTC enabled.", "ids": [21, 779, 7854, 37, 10, 7226, 491, 7, 14963, 491, 297, 1604, 9, 7109, 6, 8123, 15, 0, 220, 11, 3573, 1926, 22, 11735, 230, 5525, 3]},
  {"text": "The ADC supports up to 16 external channels with a maximum sampling rate of 2.4 MSPS at 12-bit resolution.", "ids": [21, 66, 5987, 2945, 92, 7, 409, 2298, 3293, 22, 10, 2012, 20568, 1086, 8, 7948, 3921, 6145, 46, 13906, 2291, 3543, 3]},
  {"text": "Each GPIO pin can sink or source up to 8 mA, but the total current must not exceed 120 mA.", "ids": [1332, 13193, 8551, 6030, 38, 8761, 42, 1280, 92, 7, 237, 22134, 4, 70, 5, 1259, 928, 233, 30, 9407, 2985, 22134, 3]},
  {"text": "The internal RC oscillator is factory-trimmed to 16 MHz ±1% at 25 °C.", "ids": [21, 2868, 11484, 3139, 6, 2124, 182, 3149, 12, 1689, 19, 4013, 295, 64, 7, 409, 16065, 11300, 6616, 46, 546, 4885, 230, 3]},
  {"text": "Flash memory is organized in 2 KB pages and can be erased page by page or by mass erase.", "ids": [3917, 1284, 12, 5046, 11, 86, 10998, 2385, 9, 38, 26, 15348, 424, 45, 424, 42, 45, 2782, 13690, 3]},
  {"text": "The SPI interface supports full-duplex transfers at up to 50 Mbit/s in master mode.", "ids": [21, 4084, 164, 2204, 2945, 455, 19, 4529, 16771, 15225, 46, 92, 7, 595, 392, 2291, 96, 6, 11, 2258, 1926, 3]},
  {"text": "When VDD drops below the BOR threshold of 2.7 V, the device is held in reset.", "ids": [186, 491, 11091, 11155, 1051, 5, 245, 3902, 14824, 8, 14872, 491, 4, 5, 779, 12, 1290, 11, 9182, 3]},
  {"text": "The watchdog timer is clocked by the 32 kHz LSI oscillator and cannot be stopped once enabled.", "ids": [21, 1150, 14258, 82, 235, 12, 4577, 64, 45, 5, 1363, 15, 18976, 28642, 3139, 6, 2124, 182, 3149, 9, 458, 26, 3490, 575, 5525, 3]},
  {"text": "Absolute maximum ratings: VDD = -0.3 V to 4.0 V, storage temperature = -65 °C to 150 °C.", "ids": [17580, 2012, 10654, 20, 491, 11091, 2186, 51, 10667, 491, 7, 7889, 491, 4, 1168, 1220, 2186, 51, 2129, 4885, 230, 7, 2529, 4885, 230, 3]},
  {"text": "The DMA controller has 8 channels, each with a 4-word FIFO and programmable priority.", "ids": [21, 395, 3069, 4593, 58, 237, 3293, 4, 234, 22, 10, 1540, 9945, 8019, 14769, 9, 24969, 6614, 3]},
  {"text": "I2C1 and I2C2 support Fast-mode Plus (1 MHz) with 20 mA output drive on the SDA and SCL pins.", "ids": [14, 208, 230, 281, 9, 14, 208, 230, 208, 405, 3999, 19, 16098, 2915, 933, 16065, 40, 22, 265, 22134, 2359, 465, 28, 5, 3011, 220, 9, 251, 7534, 6030, 6, 3]},
  {"text": "The UART baud rate is derived from PCLK1 and must be set before the TE bit is written.", "ids": [21, 357, 13375, 1489, 19751, 1086, 12, 8974, 37, 1159, 474, 408, 281, 9, 233, 26, 315, 185, 5, 13397, 1072, 12, 1283, 3]},
