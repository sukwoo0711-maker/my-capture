  {"text": "Bits 15:8 PSC[7:0]: Prescaler value. The counter clock frequency is f_CK_PSC / (PSC + 1).", "ids": [5339, 6, 303, 4112, 5579, 230, 2653, 749, 20, 1294, 161, 20, 2620, 5965, 235, 746, 3, 21, 4993, 4577, 5042, 12, 2598, 594, 10179, 594, 6145, 230, 178, 29, 6145, 230, 888, 4619, 3]},
  {"text": "Bit 7 TXE: Transmit data register empty. This bit is set by hardware when the content of the USART_TDR register has been transferred into the shift register.", "ids": [5339, 242, 17275, 410, 20, 7145, 5226, 201, 4652, 3478, 3, 84, 1072, 12, 315, 45, 3357, 99, 5, 797, 8, 5, 412, 13375, 594, 352, 7462, 4652, 58, 111, 7310, 127, 5, 5486, 4652, 3]},
