<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
    <RootNamespace>MyCapture.App.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Render selected glyphs with SelectionTextBrush instead of painting an adorner over them. -->
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Controls.Text.UseAdornerForTextboxSelectionRendering" Value="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MyCapture.App\MyCapture.App.csproj" />
    <ProjectReference Include="..\..\src\MyCapture.Setup\MyCapture.Setup.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <Compile Include="..\Shared\TestRecycleBin.cs" Link="TestRecycleBin.cs" />
    <Compile Include="..\Shared\RecordingClipboard.cs" Link="RecordingClipboard.cs" />
    <Using Include="MyCapture.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures\video-shorter-than-audio.mp4" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\opus-mt-en-ko-source.spm" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\opus-mt-en-ko-source-spm-cases.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\opus-mt-en-ko-probe-translations.json" CopyToOutputDirectory="PreserveNewest" />
    <Page Remove="Fixtures\SettingsStructure.Before.xaml" />
    <EmbeddedResource Include="Fixtures\SettingsStructure.Before.xaml" LogicalName="SettingsStructure.Before.xaml" />
    <Page Remove="Fixtures\VioletIntegrationBaseline.xaml" />
    <EmbeddedResource Include="Fixtures\VioletIntegrationBaseline.xaml" LogicalName="AccentFixture.VioletIntegrationBaseline.xaml" />
    <!-- Use the exact product markup in isolated theme fixtures, with its static
         dependencies present at parse time and without a process-wide Application. -->
    <EmbeddedResource Include="..\..\src\MyCapture.App\Themes\Tokens.xaml" LogicalName="ThemeFixture.Tokens.xaml" />
    <EmbeddedResource Include="..\..\src\MyCapture.App\Themes\Symbols.xaml" LogicalName="ThemeFixture.Symbols.xaml" />
    <EmbeddedResource Include="..\..\src\MyCapture.App\Themes\Controls.xaml" LogicalName="ThemeFixture.Controls.xaml" />
    <EmbeddedResource Include="..\..\src\MyCapture.App\Gallery\GalleryWindow.xaml" LogicalName="GalleryFixture.Window.xaml" />
    <EmbeddedResource Include="..\..\src\MyCapture.App\Settings\SettingsWindow.xaml" LogicalName="SettingsFixture.Window.xaml" />
    <EmbeddedResource Include="..\..\src\MyCapture.App\ShortcutHelpWindow.cs" LogicalName="ShortcutFixture.Help.cs" />
    <EmbeddedResource Include="..\..\src\MyCapture.App\TutorialCatalog.cs" LogicalName="ShortcutFixture.Tutorial.cs" />
  </ItemGroup>

  <!-- The pin preview host is compiled only in Debug builds of the app, so are its tests. -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="PreviewCopyCommandsTests.cs;PreviewLaunchOptionsTests.cs;PreviewPinInputTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="RapidOcrNet" />
  </ItemGroup>

</Project>
