                    AutomationProperties.Name="{loc:Text Text_205C50A145BA}"
                    AutomationProperties.HelpText="{loc:Text Text_D8A23CD47E7A}"
                    Click="OnResetDefaults" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="ApplyButton"
                        Style="{StaticResource Button.Primary}"
                        Content="{loc:Text Text_99CBBE7CFB4C}"
                        MinWidth="88"
                        IsDefault="True"
                        AutomationProperties.Name="{loc:Text Text_6A1C963D5BC5}"
                        AutomationProperties.HelpText="{loc:Text Text_B89071D80D8F}"
                        Click="OnApply" />
                <Button x:Name="CancelButton"
                        Style="{StaticResource Button.Secondary}"
                        Content="{loc:Text Text_7F7A6F648B25}"
                        MinWidth="88"
                        Margin="6,0,0,0"
                        IsCancel="True"
                        AutomationProperties.Name="{loc:Text Text_BE876433993A}"
                        Click="OnCancel" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
