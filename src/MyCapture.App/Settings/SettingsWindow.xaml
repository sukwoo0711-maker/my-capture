<Window x:Class="MyCapture.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:MyCapture.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Style="{StaticResource Window.Standard}"
        Title="{loc:Text Text_60CBF2E08D0D}"
        Width="940" Height="700"
        MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Ui}"
        Background="{StaticResource Surface.Base}"
        Foreground="{StaticResource Text.Primary}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>

        <!-- Category and command glyphs come from the shared Symbols.xaml resource dictionary
             (Icon.Settings / Icon.Capture / Icon.Shortcuts / Icon.Storage / Icon.Export /
             Icon.Pin / Icon.Ocr), referenced by key so the icon vocabulary stays centralised. -->

        <!-- Shared label above a field. -->
        <Style x:Key="Settings.Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <!-- Secondary description under a label. Muted on sunken surfaces stays AA. -->
        <Style x:Key="Settings.Description" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Group heading inside a page. -->
        <Style x:Key="Settings.GroupHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Subtitle}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>

        <!-- One labelled field block. -->
        <Style x:Key="Settings.Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- Text input built on the shared TextBox style. Only the validation additions
             (error border colour, tooltip, automation help text) are layered on top; the
             base look, focus, and hover come from the theme so there is no duplication. -->
        <Style x:Key="Settings.TextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <AdornedElementPlaceholder />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource State.Danger}" />
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self},
                                            Path=(Validation.Errors)[0].ErrorContent}" />
                    <Setter Property="AutomationProperties.HelpText"
                            Value="{Binding RelativeSource={RelativeSource Self},
                                            Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Checkbox built on the shared CheckBox style. -->
        <Style x:Key="Settings.CheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- ===================== Category navigation =====================
             Icon + label rows. The container border keeps a constant 1px thickness in every
             state; selection and focus change colour and reveal the accent bar only, so the
             row never resizes or shifts its neighbours (stable focus). -->
        <Style x:Key="Settings.TabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Md}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AccentBar" Visibility="Hidden"
                                        Width="3"
                                        Background="{StaticResource Accent.Default}"
                                        CornerRadius="2" />
                                <Viewbox Grid.Column="1" Width="18" Height="18"
                                         Margin="10,0,0,0" VerticalAlignment="Center">
                                    <Path x:Name="Glyph"
                                          Data="{Binding Path=Tag,
                                                         RelativeSource={RelativeSource TemplatedParent}}"
                                          Width="20" Height="20"
                                          Stretch="Uniform"
                                          Stroke="{StaticResource Text.Secondary}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent" />
                                </Viewbox>
                                <ContentPresenter Grid.Column="2" ContentSource="Header"
                                                  Margin="10,0,0,0"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent.Subtle}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Border.Accent}" />
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource Accent.Cool}" />
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface.Hover}" />
                                <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource Text.Primary}" />
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                            </Trigger>
                            <!-- Focus changes only the border colour, never the thickness. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Border.Focus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Settings.TabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="10">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Top" Margin="10,8,10,14">
                                        <TextBlock Text="{loc:Text Text_F5BF49635D43}" Style="{StaticResource Text.Section}" />
                                        <TextBlock Text="{loc:Text Text_BDA4A255187A}"
                                                   Style="{StaticResource Text.MutedBlock}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="False"
                                                  Focusable="False">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="1" Margin="16,0,0,0"
                                    Style="{StaticResource Card}" Padding="0">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="24,18,18,18" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A neutral information card: raised surface + subtle border, no accent wash. -->
        <Style x:Key="Settings.InfoCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,11" />
        </Style>

        <!-- Browse button reuses the shared secondary button, just narrower with a gap. -->
        <Style x:Key="Settings.BrowseButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Product header. The duplicate "Ctrl+S 적용" badge is omitted; the Apply button in
             the command bar already carries and communicates the shortcut. -->
        <StackPanel Grid.Row="0" Margin="2,0,2,20" Orientation="Horizontal">
            <Image Style="{StaticResource Brand.AppIcon}" Margin="0,1,12,0"
                   AutomationProperties.Name="MyCapture" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{loc:Text Text_115BCED49291}" Style="{StaticResource Text.Display}" />
                <TextBlock Text="{loc:Text Text_FEAA5199651D}"
                           Style="{StaticResource Text.MutedBlock}" Margin="0,5,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- ===================== Category navigation via TabControl =====================
             Each TabItem carries its glyph geometry in Tag, which the template's Path binds to.
             The visible Header stays the plain Korean label so the
             accessible name and shown text agree. -->
        <TabControl x:Name="CategoryTabs"
                    Grid.Row="1"
                    Style="{StaticResource Settings.TabControl}"
                    AutomationProperties.Name="{loc:Text Text_CFC51550591E}">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource Settings.TabItem}" />
            </TabControl.Resources>

            <!-- General -->
            <TabItem Header="{loc:Text Text_512989791C19}" AutomationProperties.Name="{loc:Text Text_6D74F9324ACB}"
                     Tag="{StaticResource Icon.Settings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,12,4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Settings.GroupHeading}" Text="{loc:Text Text_512989791C19}" />

                        <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Settings.Language}" />
                        <ComboBox x:Name="LanguageSelector" SelectedValue="{Binding Language}" SelectedValuePath="Tag"
                                  AutomationProperties.Name="{loc:Text Settings.Language}" MinWidth="220" HorizontalAlignment="Left" Margin="0,4,0,4">
                            <ComboBoxItem Tag="" Content="{loc:Text Settings.LanguageSystem}" />
                            <ComboBoxItem Tag="ko-KR" Content="한국어" />
                            <ComboBoxItem Tag="en-US" Content="English" />
                        </ComboBox>
                        <TextBlock Style="{StaticResource Settings.Description}" Text="{loc:Text Settings.LanguageHint}" />
                        <CheckBox x:Name="LaunchAtLoginCheck"
                                  Style="{StaticResource Settings.CheckBox}"
                                  Content="{loc:Text Text_98F1681CB686}"
                                  AutomationProperties.Name="{loc:Text Text_98F1681CB686}"
                                  AutomationProperties.HelpText="{loc:Text Text_F3C7FE27A258}"
                                  IsChecked="{Binding LaunchAtLogin}" />
                        <TextBlock Style="{StaticResource Settings.Description}"
                                   Text="{loc:Text Text_963745AB00F4}" />

                        <Border Style="{StaticResource Settings.InfoCard}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Text Text_DD2EFE395A75}" Style="{StaticResource Text.Section}" />
                                <TextBlock Text="{loc:Text Text_BCEDE50E5248}"
                                           Style="{StaticResource Text.MutedBlock}" Margin="0,4,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="122" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ctrl+Shift+C" FontFamily="{StaticResource Font.Mono}"
                                               Foreground="{StaticResource Accent.Cool}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{loc:Text Text_574815F8C801}" Foreground="{StaticResource Text.Secondary}" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="122" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ctrl+Shift+X" FontFamily="{StaticResource Font.Mono}"
                                               Foreground="{StaticResource Accent.Cool}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{loc:Text Text_4DAE3A1EEAE4}" Foreground="{StaticResource Text.Secondary}" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="122" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ctrl+Shift+Z" FontFamily="{StaticResource Font.Mono}"
                                               Foreground="{StaticResource Accent.Cool}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{loc:Text Text_66BA5DCDA810}" Foreground="{StaticResource Text.Secondary}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Capture -->
            <TabItem Header="{loc:Text Text_50EE4EA7C243}" AutomationProperties.Name="{loc:Text Text_F5416FA54E13}"
                     Tag="{StaticResource Icon.Capture}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,12,4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Settings.GroupHeading}" Text="{loc:Text Text_50EE4EA7C243}" />

                        <CheckBox Style="{StaticResource Settings.CheckBox}"
                                  Content="{loc:Text Text_4BE214FF10B0}"
                                  AutomationProperties.Name="{loc:Text Text_4BE214FF10B0}"
                                  IsChecked="{Binding IncludeCursor}" />

                        <Border Style="{StaticResource Settings.InfoCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{loc:Text Text_D116685C040E}" Style="{StaticResource Text.Section}" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource Text.MutedBlock}"
                                           Text="{loc:Text Text_756622E6954E}" />
                            </StackPanel>
                        </Border>

                        <CheckBox Style="{StaticResource Settings.CheckBox}"
                                  Content="{loc:Text Text_B9D242426446}"
                                  AutomationProperties.Name="{loc:Text Text_B9D242426446}"
                                  IsChecked="{Binding ShowMagnifier}" />

                        <CheckBox Style="{StaticResource Settings.CheckBox}"
                                  Content="{loc:Text Text_BD975387F343}"
                                  AutomationProperties.Name="{loc:Text Text_B36A1FC25CCE}"
                                  IsChecked="{Binding AbortOnFocusLoss}" />

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_8839D136ACA2}" />
                            <TextBlock Style="{StaticResource Settings.Description}" Text="{loc:Text Text_85C1E3734392}" />
                            <TextBox Style="{StaticResource Settings.TextBox}" Width="120" HorizontalAlignment="Left"
                                     AutomationProperties.Name="{loc:Text Text_8839D136ACA2}"
                                     Text="{Binding DelaySeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_337B5BC36C27}" />
                            <TextBlock Style="{StaticResource Settings.Description}" Text="{loc:Text Text_C4656CD904CA}" />
                            <TextBox Style="{StaticResource Settings.TextBox}" Width="120" HorizontalAlignment="Left"
                                     AutomationProperties.Name="{loc:Text Text_337B5BC36C27}"
                                     Text="{Binding RegionHistoryLimit, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Recording -->
            <TabItem Header="{loc:Text Text_BFA39DD9B85B}" AutomationProperties.Name="{loc:Text Text_FADDD953571F}"
                     Tag="{StaticResource Icon.Capture}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,12,4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Settings.GroupHeading}" Text="{loc:Text Text_4F5AF20FAA6E}" />

                        <Border Style="{StaticResource Settings.InfoCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{loc:Text Text_93EB8FA7F9BC}" Style="{StaticResource Text.Section}" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource Text.MutedBlock}"
                                           Text="{loc:Text Text_2F12FF262AAC}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_9C49B0923292}" />
                            <TextBlock Style="{StaticResource Settings.Description}"
                                       Text="{loc:Text Text_AE6C1447BA99}" />
                            <TextBox Style="{StaticResource Settings.TextBox}"
                                     Width="120"
                                     HorizontalAlignment="Left"
                                     AutomationProperties.Name="{loc:Text Text_BC1D92BC8EFA}"
                                     Text="{Binding RecordingFrameRate, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </StackPanel>

                        <CheckBox Style="{StaticResource Settings.CheckBox}"
                                  Content="{loc:Text Text_F1C1BB1D5771}"
                                  AutomationProperties.Name="{loc:Text Text_F1C1BB1D5771}"
                                  IsChecked="{Binding UseRecordingStartDelay}" />

                        <StackPanel Style="{StaticResource Settings.Field}"
                                    IsEnabled="{Binding UseRecordingStartDelay}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_1D9A98A69018}" />
                            <TextBlock Style="{StaticResource Settings.Description}" Text="{loc:Text Text_94A8B744467B}" />
                            <TextBox Style="{StaticResource Settings.TextBox}"
                                     Width="120"
                                     HorizontalAlignment="Left"
                                     AutomationProperties.Name="{loc:Text Text_1C856E8BF798}"
                                     Text="{Binding RecordingStartDelaySeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </StackPanel>

                        <CheckBox Style="{StaticResource Settings.CheckBox}"
                                  Content="{loc:Text Text_F0CFD62F0971}"
                                  AutomationProperties.Name="{loc:Text Text_F0CFD62F0971}"
                                  IsChecked="{Binding RecordingIncludeCursor}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Hotkeys -->
            <TabItem Header="{loc:Text Text_086F41200B47}" AutomationProperties.Name="{loc:Text Text_FA339B8FA77F}"
                     Tag="{StaticResource Icon.Shortcuts}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,12,4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Settings.GroupHeading}" Text="{loc:Text Text_0DFC300AD94D}" />
                        <TextBlock Style="{StaticResource Settings.Description}"
                                   Text="{loc:Text Text_669D90D96A45}" />

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_096A13A757DB}" />
                            <TextBox Style="{StaticResource Settings.TextBox}" Width="240" HorizontalAlignment="Left"
                                     AutomationProperties.Name="{loc:Text Text_AF588C59EB7B}"
                                     Text="{Binding CaptureHotkey, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_66BA5DCDA810}" />
                            <TextBox Style="{StaticResource Settings.TextBox}" Width="240" HorizontalAlignment="Left"
                                     AutomationProperties.Name="{loc:Text Text_6F1D1FE90E37}"
                                     Text="{Binding OpenLibraryHotkey, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_1FBCF51E2FF5}" />
                            <TextBox Style="{StaticResource Settings.TextBox}" Width="240" HorizontalAlignment="Left"
                                     AutomationProperties.Name="{loc:Text Text_B53D43740F41}"
                                     Text="{Binding PasteToScreenHotkey, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_4FED89116C1F}" />
                            <TextBox Style="{StaticResource Settings.TextBox}" Width="240" HorizontalAlignment="Left"
                                     AutomationProperties.Name="{loc:Text Text_D6E142D9293C}"
                                     Text="{Binding HideAllPinsHotkey, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_67FE4AF7D334}" />
                            <TextBox Style="{StaticResource Settings.TextBox}" Width="240" HorizontalAlignment="Left"
                                     AutomationProperties.Name="{loc:Text Text_7116B7156511}"
                                     Text="{Binding ToggleClickThroughHotkey, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_7A4FE9D482AD}" />
                            <TextBox Style="{StaticResource Settings.TextBox}" Width="240" HorizontalAlignment="Left"
                                     AutomationProperties.Name="{loc:Text Text_7F2ED132EA3B}"
                                     Text="{Binding RepeatLastRegionHotkey, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_36458FABBDBB}" />
                            <TextBox Style="{StaticResource Settings.TextBox}" Width="240" HorizontalAlignment="Left"
                                     AutomationProperties.Name="{loc:Text Text_C2A254402263}"
                                     Text="{Binding CaptureWindowHotkey, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_254C836B9ED2}" />
                            <TextBox Style="{StaticResource Settings.TextBox}" Width="240" HorizontalAlignment="Left"
                                     AutomationProperties.Name="{loc:Text Text_E7770F293C4C}"
                                     Text="{Binding CaptureFullScreenHotkey, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_75306DAE2E60}" />
                            <TextBox Style="{StaticResource Settings.TextBox}" Width="240" HorizontalAlignment="Left"
                                     AutomationProperties.Name="{loc:Text Text_6FF5C7B32202}"
                                     Text="{Binding RecordRegionHotkey, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Storage -->
            <TabItem Header="{loc:Text Text_514880F82297}" AutomationProperties.Name="{loc:Text Text_B3D3A625A748}"
                     Tag="{StaticResource Icon.Storage}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,12,4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Settings.GroupHeading}" Text="{loc:Text Text_514880F82297}" />
                        <TextBlock Style="{StaticResource Settings.Description}" Margin="0,0,0,16"
                                   Text="{loc:Text Text_295F3F963B4A}" />

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_71FBF04B7201}" />
                            <TextBlock Style="{StaticResource Settings.Description}" Text="{loc:Text Text_80FD8A8BF5F2}" />
                            <TextBox Style="{StaticResource Settings.TextBox}" Width="140" HorizontalAlignment="Left"
                                     AutomationProperties.Name="{loc:Text Text_71FBF04B7201}"
                                     Text="{Binding MaxItems, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_284A54C660EC}" />
                            <TextBlock Style="{StaticResource Settings.Description}" Text="0.125 ~ 512 GiB." />
                            <TextBox Style="{StaticResource Settings.TextBox}" Width="140" HorizontalAlignment="Left"
                                     AutomationProperties.Name="{loc:Text Text_FC05BD860043}"
                                     Text="{Binding MaxGiB, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_1218314DD9C8}" />
                            <TextBlock Style="{StaticResource Settings.Description}" Text="96 ~ 1024px." />
                            <TextBox Style="{StaticResource Settings.TextBox}" Width="140" HorizontalAlignment="Left"
                                     AutomationProperties.Name="{loc:Text Text_92EBA2788912}"
                                     Text="{Binding ThumbnailLongEdge, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_99A2B3E1BD9D}" />
                            <TextBlock Style="{StaticResource Settings.Description}"
                                       Text="{loc:Text Text_B62C5C65821E}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource Settings.TextBox}"
                                         AutomationProperties.Name="{loc:Text Text_F6C3295E346E}"
                                         Text="{Binding CapturesDirectoryOverride, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                <Button Grid.Column="1" Style="{StaticResource Settings.BrowseButton}"
                                        Content="{loc:Text Text_C536D125279E}"
                                        AutomationProperties.Name="{loc:Text Text_1145FCF19412}"
                                        Click="OnBrowseCapturesDirectory" />
                            </Grid>
