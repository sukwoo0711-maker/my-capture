                                       Text="{loc:Text Text_A00997F45D07}" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- OCR -->
            <TabItem Header="OCR" AutomationProperties.Name="{loc:Text Text_5E3720825B85}"
                     Tag="{StaticResource Icon.Ocr}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,12,4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Settings.GroupHeading}" Text="{loc:Text Text_9E5A499FF162}" />

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_9C208B575A0D}" />
                            <TextBlock Style="{StaticResource Settings.Description}" Text="{loc:Text Text_2D7399F90B4F}" />
                            <TextBox Style="{StaticResource Settings.TextBox}"
                                     AutomationProperties.Name="{loc:Text Text_D7FF669E0B69}"
                                     Text="{Binding PreferredLanguages, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_99B8BDC92E9D}" />
                            <TextBlock Style="{StaticResource Settings.Description}" Text="{loc:Text Text_5C6A8668C3C0}" />
