<Window x:Class="MyCapture.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:settings="clr-namespace:MyCapture.App.Settings"
        xmlns:coreSettings="clr-namespace:MyCapture.Core.Settings;assembly=MyCapture.Core"
        xmlns:loc="clr-namespace:MyCapture.App.Localization"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Style="{StaticResource Window.Standard}"
        Title="{loc:Text Text_60CBF2E08D0D}"
        Width="940" Height="700"
        MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Ui}"
        Background="{DynamicResource Surface.Base}"
        Foreground="{DynamicResource Text.Primary}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>

        <!-- Category and command glyphs come from the shared Symbols.xaml resource dictionary
             (Icon.Settings / Icon.Capture / Icon.Record / Icon.Edit / Icon.Shortcuts /
             Icon.Storage), referenced by key so the icon vocabulary stays centralised. Every
             category has its own glyph; the about glyph has no shared counterpart yet. -->
        <GeometryGroup x:Key="Settings.Icon.About">
            <EllipseGeometry Center="10,10" RadiusX="7.25" RadiusY="7.25" />
            <PathGeometry Figures="M10,9.25 L10,14 M10,6.25 L10,6.35" />
        </GeometryGroup>

        <!-- Shared label above a field. -->
        <Style x:Key="Settings.Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <!-- Secondary description under a label. Muted on sunken surfaces stays AA. -->
        <Style x:Key="Settings.Description" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Heading of a second or later group inside a page. The first group of a page has
             no heading: the category name already says what it is, and the window title bar is
             the only window title. With the 12 below the field before it, groups sit 24 apart. -->
        <Style x:Key="Settings.GroupHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Subtitle}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,12,0,8" />
        </Style>

        <!-- One labelled field block: 12 between fields. -->
        <Style x:Key="Settings.Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Text input built on the shared TextBox style, at the 32 height of the settings
             ComboBoxes. The validation additions (error border colour, tooltip, automation help
             text) are layered on top. The template repeats the shared one except that the content
             host takes no margin: TextBoxBase already copies Padding onto that host, so the
             shared template's Margin="{TemplateBinding Padding}" applies the padding twice
             (a 53-high box with the text pushed 24 in). -->
        <Style x:Key="Settings.TextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            <Setter Property="MinHeight" Value="{DynamicResource Size.HitTarget.Compact}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource Radius.Md}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <Border x:Name="FocusRing"
                                    Margin="1"
                                    BorderBrush="{DynamicResource Border.Focus}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Sm}"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.Raised}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <AdornedElementPlaceholder />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource State.Danger}" />
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self},
                                            Path=(Validation.Errors)[0].ErrorContent}" />
                    <Setter Property="AutomationProperties.HelpText"
                            Value="{Binding RelativeSource={RelativeSource Self},
                                            Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A short number: wide enough for "0.125" or "7680". -->
        <Style x:Key="Settings.NumberBox" TargetType="TextBox" BasedOn="{StaticResource Settings.TextBox}">
            <Setter Property="Width" Value="80" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- Body-size text between inputs on one line ("Width", "×", "px"); dims with them. -->
        <Style x:Key="Settings.InlineText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>


        <!-- One short value per row: label | input | range or unit, with an optional note on
             the line below. Rows on one page share the label column (the page sets
             Grid.IsSharedSizeScope), so every input starts at the same x. A disabled row dims
             its label and range with the input. -->
        <Style TargetType="settings:SettingsField">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="settings:SettingsField">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsFieldLabel" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="FieldLabel" Style="{StaticResource Settings.Label}"
                                       Margin="0,0,16,0" MaxWidth="240" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            <TextBlock x:Name="FieldHint" Grid.Column="2" Style="{StaticResource Settings.Description}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{TemplateBinding Hint}" />
                            <!-- Text notes take the description look; an element note (a named
                                 TextBlock kept current by code-behind) is shown as it is. -->
                            <ContentPresenter x:Name="FieldNote" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,4,0,0"
                                              Content="{TemplateBinding Note}">
                                <ContentPresenter.Resources>
                                    <DataTemplate DataType="{x:Type sys:String}">
                                        <TextBlock Style="{StaticResource Settings.Description}" Margin="0" Text="{Binding}" />
                                    </DataTemplate>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Hint" Value="{x:Null}">
                                <Setter TargetName="FieldHint" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Note" Value="{x:Null}">
                                <Setter TargetName="FieldNote" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldLabel" Property="Opacity" Value="0.5" />
                                <Setter TargetName="FieldHint" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secret input with the same chrome as Settings.TextBox. A PasswordBox never exposes
             its value through UI Automation, and the window never logs it. Like TextBoxBase, the
             PasswordBox copies Padding onto its content host, so the host takes no margin. -->
        <Style x:Key="Settings.PasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent.Default}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="{DynamicResource Size.HitTarget.Compact}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource Radius.Md}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <Border x:Name="FocusRing"
                                    Margin="1"
                                    BorderBrush="{DynamicResource Border.Focus}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Sm}"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Collapsible group for rarely used options. The header is a themed toggle with a
             chevron; the Expander keeps the expand/collapse automation pattern. -->
        <Style x:Key="Settings.Expander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="IsExpanded" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton x:Name="HeaderToggle" DockPanel.Dock="Top"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding Header}"
                                          Foreground="{TemplateBinding Foreground}"
                                          AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                          HorizontalAlignment="Left"
                                          Padding="6,6,10,6"
                                          Cursor="Hand"
                                          FocusVisualStyle="{x:Null}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource Radius.Md}"
                                                Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="Chevron"
                                                      Data="{StaticResource Icon.ChevronDown}"
                                                      Width="12" Height="12" Stretch="Uniform"
                                                      Stroke="{DynamicResource Text.Secondary}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      VerticalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="-90" />
                                                    </Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                                                  TextElement.FontSize="{StaticResource FontSize.Subtitle}"
                                                                  TextElement.FontWeight="Bold" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.Hover}" />
                                                <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Text.Primary}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="0,8,0,0" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkbox built on the shared CheckBox style. -->
        <Style x:Key="Settings.CheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Radio button built on the shared RadioButton style, at the checkbox text size. -->
        <Style x:Key="Settings.RadioButton" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- ===================== Category navigation =====================
             Icon + label rows. The container border keeps a constant 1px thickness in every
             state; selection and focus change colour and reveal the accent bar only, so the
             row never resizes or shifts its neighbours (stable focus). -->
        <Style x:Key="Settings.TabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Md}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AccentBar" Visibility="Hidden"
                                        Width="3"
                                        Background="{DynamicResource Accent.Default}"
                                        CornerRadius="2" />
                                <Viewbox Grid.Column="1" Width="18" Height="18"
                                         Margin="10,0,0,0" VerticalAlignment="Center">
                                    <Path x:Name="Glyph"
                                          Data="{Binding Path=Tag,
                                                         RelativeSource={RelativeSource TemplatedParent}}"
                                          Width="20" Height="20"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource Text.Secondary}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent" />
                                </Viewbox>
                                <ContentPresenter Grid.Column="2" ContentSource="Header"
                                                  Margin="10,0,0,0"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent.Subtle}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Border.Accent}" />
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Accent.Cool}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.Hover}" />
                                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Text.Primary}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                            </Trigger>
                            <!-- Focus changes only the border colour, never the thickness. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The category list has no heading of its own: the title bar already names the
             window, so the first thing in the navigation is the first category. -->
        <Style x:Key="Settings.TabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="10">
                                <ScrollViewer x:Name="CategoryScroll"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="False"
                                              Focusable="False">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </ScrollViewer>
                            </Border>
                            <Border Grid.Column="1" Margin="16,0,0,0"
                                    Style="{StaticResource Card}" Padding="0">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="24,18,18,18" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A neutral information card: raised surface + subtle border, no accent wash. -->
        <Style x:Key="Settings.InfoCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,11" />
        </Style>

        <!-- Browse button reuses the shared secondary button, just narrower with a gap, and as
             high as the folder box beside it. -->
        <Style x:Key="Settings.BrowseButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="MinHeight" Value="{DynamicResource Size.HitTarget.Compact}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

    </Window.Resources>

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Category navigation via TabControl =====================
             Each TabItem carries its glyph geometry in Tag, which the template's Path binds to.
             The visible Header is also the accessible name; the tooltip lists what the
             category holds so a setting is found without opening every page. -->
        <TabControl x:Name="CategoryTabs"
                    Grid.Row="0"
                    Style="{StaticResource Settings.TabControl}"
                    AutomationProperties.Name="{loc:Text Text_CFC51550591E}">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource Settings.TabItem}" />
            </TabControl.Resources>

            <!-- General -->
            <TabItem Header="{loc:Text SettingsUx_TabGeneral}" AutomationProperties.Name="{loc:Text SettingsUx_TabGeneral}"
                     ToolTip="{loc:Text SettingsUx_TabGeneralHelp}" AutomationProperties.HelpText="{loc:Text SettingsUx_TabGeneralHelp}"
                     Tag="{StaticResource Icon.Settings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,12,4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Settings.Language}" />
                        <ComboBox x:Name="LanguageSelector" SelectedValue="{Binding Language}" SelectedValuePath="Tag"
                                  AutomationProperties.Name="{loc:Text Settings.Language}" MinWidth="220" HorizontalAlignment="Left" Margin="0,4,0,4">
                            <ComboBoxItem Tag="" Content="{loc:Text Settings.LanguageSystem}" />
                            <ComboBoxItem Tag="ko-KR" Content="한국어" />
                            <ComboBoxItem Tag="en-US" Content="English" />
                        </ComboBox>
                        <TextBlock Style="{StaticResource Settings.Description}" Text="{loc:Text Settings.LanguageHint}" />

                        <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Settings.Theme}" Margin="0,12,0,0" />
                        <ComboBox x:Name="ThemeSelector" SelectedValue="{Binding Theme}" SelectedValuePath="Tag"
                                  AutomationProperties.Name="{loc:Text Settings.Theme}" MinWidth="320" HorizontalAlignment="Left" Margin="0,4,0,4">
                            <ComboBoxItem Tag="glass" Content="{loc:Text Settings.ThemeGlass}" />
                            <ComboBoxItem Tag="glass-light" Content="{loc:Text Settings.ThemeGlassLight}" />
                            <ComboBoxItem Tag="workspace" Content="{loc:Text Settings.ThemeWorkspace}" />
                            <ComboBoxItem Tag="daylight" Content="{loc:Text Settings.ThemeDaylight}" />
                            <ComboBoxItem Tag="midnight" Content="{loc:Text Settings.ThemeMidnight}" />
                            <ComboBoxItem Tag="high-contrast" Content="{loc:Text Settings.ThemeHighContrast}" />
                        </ComboBox>
                        <TextBlock Style="{StaticResource Settings.Description}" Text="{loc:Text Settings.ThemeHint}" />

                        <CheckBox x:Name="LaunchAtLoginCheck"
                                  Style="{StaticResource Settings.CheckBox}"
                                  Margin="0,12,0,0"
                                  Content="{loc:Text Text_98F1681CB686}"
                                  AutomationProperties.Name="{loc:Text Text_98F1681CB686}"
                                  AutomationProperties.HelpText="{loc:Text Text_F3C7FE27A258}"
                                  IsChecked="{Binding LaunchAtLogin}" />
                        <TextBlock Style="{StaticResource Settings.Description}"
                                   Text="{loc:Text Text_963745AB00F4}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Capture -->
            <TabItem Header="{loc:Text SettingsUx_TabCapture}" AutomationProperties.Name="{loc:Text SettingsUx_TabCapture}"
                     ToolTip="{loc:Text SettingsUx_TabCaptureHelp}" AutomationProperties.HelpText="{loc:Text SettingsUx_TabCaptureHelp}"
                     Tag="{StaticResource Icon.Capture}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,12,4">
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Capture.AfterAction}" />
                        <ComboBox SelectedValue="{Binding AfterCapture}" SelectedValuePath="Tag" MinWidth="250" HorizontalAlignment="Left"
                                  AutomationProperties.Name="{loc:Text Capture.AfterAction}" Margin="0,4,0,8">
                            <ComboBoxItem Tag="{x:Static coreSettings:AfterCaptureAction.Editor}" Content="{loc:Text Capture.AfterEditor}" />
                            <ComboBoxItem Tag="{x:Static coreSettings:AfterCaptureAction.QuickAccess}" Content="{loc:Text Capture.AfterCard}" />
                            <ComboBoxItem Tag="{x:Static coreSettings:AfterCaptureAction.ClipboardOnly}" Content="{loc:Text Capture.AfterClipboard}" />
                        </ComboBox>
                        <CheckBox Style="{StaticResource Settings.CheckBox}" Content="{loc:Text QuickAccess.Sound}"
                                  AutomationProperties.Name="{loc:Text QuickAccess.Sound}"
                                  IsChecked="{Binding PlayCaptureSound}" />

                        <CheckBox Style="{StaticResource Settings.CheckBox}"
                                  Content="{loc:Text Text_4BE214FF10B0}"
                                  AutomationProperties.Name="{loc:Text Text_4BE214FF10B0}"
                                  IsChecked="{Binding IncludeCursor}" />

                        <Border Style="{StaticResource Settings.InfoCard}" Margin="0,8,0,16">
                            <StackPanel>
                                <TextBlock Text="{loc:Text Text_D116685C040E}" Style="{StaticResource Text.Section}" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource Text.MutedBlock}"
                                           Text="{Binding CaptureHotkey, StringFormat={loc:Text Text_756622E6954E}}" />
                            </StackPanel>
                        </Border>

                        <CheckBox Style="{StaticResource Settings.CheckBox}"
                                  Content="{loc:Text Text_B9D242426446}"
                                  AutomationProperties.Name="{loc:Text Text_B9D242426446}"
                                  IsChecked="{Binding ShowMagnifier}" />

