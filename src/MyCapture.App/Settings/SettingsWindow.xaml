            <TabItem x:Name="UpdateTab">
                <StackPanel Margin="20">
                    <TextBlock x:Name="UpdateVersionLabel" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" />
                    <TextBlock x:Name="UpdateDescription" TextWrapping="Wrap" Margin="0,12,0,20" Foreground="{StaticResource Text.Primary}" />
                    <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource Text.Primary}" AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar x:Name="UpdateDownloadProgress" Height="8" Minimum="0" Maximum="100" Margin="0,0,0,20" />
                    <WrapPanel>
                        <Button x:Name="UpdateAction" Style="{StaticResource Button.Primary}" Click="OnUpdateAction" MinWidth="140" />
                        <Button x:Name="UpdateCancel" Style="{StaticResource Button.Secondary}" Click="OnUpdateCancel" IsEnabled="False" Margin="8,0,0,0" MinWidth="120" />
                    </WrapPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- ===================== Error summary ===================== -->
        <Border x:Name="ErrorSummary"
                Grid.Row="2"
                Margin="0,8,0,0"
                Padding="12,8"
                CornerRadius="6"
                Background="{StaticResource Surface.Sunken}"
                BorderBrush="{StaticResource State.Danger}"
                BorderThickness="1"
                Visibility="Collapsed"
                AutomationProperties.LiveSetting="Assertive">
            <StackPanel>
                <TextBlock x:Name="ErrorSummaryHeading"
                           Foreground="{StaticResource State.Danger}"
                           FontWeight="Bold"
                           FontSize="{StaticResource FontSize.Body}"
                           Text="{loc:Text Text_EF7DD8DA5437}"
                           AutomationProperties.Name="{loc:Text Text_FAE3A646286D}" />
                <ItemsControl x:Name="ErrorList" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="{StaticResource Text.Primary}"
                                       FontSize="{StaticResource FontSize.Caption}"
                                       TextWrapping="Wrap"
                                       Margin="0,1,0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ===================== Command bar ===================== -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
