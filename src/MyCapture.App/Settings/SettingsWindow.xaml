            <!-- Annotation -->
            <TabItem Header="{loc:Text Text_E6A0E3D10B47}" AutomationProperties.Name="{loc:Text Text_931CB240652A}"
                     Tag="{StaticResource Icon.Settings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,12,4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Settings.GroupHeading}" Text="{loc:Text Text_E6A0E3D10B47}" />

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_70EC2D232B4F}" />
