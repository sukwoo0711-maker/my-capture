                        <settings:SettingsField Header="{loc:Text SettingsUx_PreviewSize}" Hint="{loc:Text SettingsUx_PreviewSizeRange}">
                            <TextBox Style="{StaticResource Settings.NumberBox}"
                                     AutomationProperties.Name="{loc:Text SettingsUx_PreviewSize}"
                                     Text="{Binding ThumbnailLongEdge, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </settings:SettingsField>

                        <!-- The note reads the typed value, so it always states the period that will
                             apply instead of a fixed number of days. -->
                        <settings:SettingsField Header="{loc:Text SettingsUx_Retention}">
                            <TextBox x:Name="RetentionHoursBox" Style="{StaticResource Settings.NumberBox}"
                                     AutomationProperties.Name="{loc:Text SettingsUx_Retention}"
                                     Text="{Binding ImageRetentionHours, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <settings:SettingsField.Note>
                                <TextBlock x:Name="RetentionSummary" Style="{StaticResource Settings.Description}" Margin="0"
                                           AutomationProperties.LiveSetting="Polite" />
                            </settings:SettingsField.Note>
                        </settings:SettingsField>

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_99A2B3E1BD9D}" />
                            <TextBlock Style="{StaticResource Settings.Description}"
                                       Text="{loc:Text Text_B62C5C65821E}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource Settings.TextBox}"
                                         AutomationProperties.Name="{loc:Text Text_F6C3295E346E}"
                                         Text="{Binding CapturesDirectoryOverride, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                <Button Grid.Column="1" Style="{StaticResource Settings.BrowseButton}"
                                        Content="{loc:Text Text_C536D125279E}"
                                        AutomationProperties.Name="{loc:Text Text_1145FCF19412}"
                                        Click="OnBrowseCapturesDirectory" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Folder410.PrefixLabel}" />
                            <TextBlock Style="{StaticResource Settings.Description}" Text="{loc:Text Folder410.PrefixHint}" />
                            <TextBox Style="{StaticResource Settings.TextBox}" MaxLength="40"
                                     AutomationProperties.Name="{loc:Text Folder410.PrefixLabel}"
                                     Text="{Binding FolderFilePrefix, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <CheckBox Content="{loc:Text LibraryFolder_KeepAfterClose}" Margin="0,12,0,0"
                                      AutomationProperties.Name="{loc:Text LibraryFolder_KeepAfterClose}"
                                      IsChecked="{Binding UseCurrentFolderForNewCaptures}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Settings.GroupHeading}" Text="{loc:Text SettingsUx_SaveFilesHeading}" />

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_5A932820414F}" />
                            <TextBlock Style="{StaticResource Settings.Description}" Text="{loc:Text Text_95B00006092B}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource Settings.TextBox}"
                                         AutomationProperties.Name="{loc:Text Text_C315173385E0}"
                                         Text="{Binding QuickSaveDirectoryOverride, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                <Button Grid.Column="1" Style="{StaticResource Settings.BrowseButton}"
                                        Content="{loc:Text Text_C536D125279E}"
                                        AutomationProperties.Name="{loc:Text Text_4C561D57BFCE}"
                                        Click="OnBrowseQuickSaveDirectory" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.Field}">
                            <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Text_72147902C22E}" />
                            <TextBlock Style="{StaticResource Settings.Description}"
                                       Text="{loc:Text Text_3185888F798A}" />
                            <TextBox Style="{StaticResource Settings.TextBox}"
                                     AutomationProperties.Name="{loc:Text Text_72147902C22E}"
                                     Text="{Binding FileNamePattern, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </StackPanel>

                        <CheckBox x:Name="ShowSourceWindowTitleCheck"
                                  Style="{StaticResource Settings.CheckBox}"
                                  Content="{loc:Text Settings.ShowSourceWindowTitle}"
                                  AutomationProperties.Name="{loc:Text Settings.ShowSourceWindowTitle}"
                                  IsChecked="{Binding ShowSourceWindowTitle}" />
                        <TextBlock Style="{StaticResource Settings.Description}"
                                   Text="{loc:Text Settings.ShowSourceWindowTitleHint}" />

                        <!-- GitHub upload is optional and rare: it stays folded until opened. The
                             header starts at the page edge; pulled further left, the page clipped
                             the left side of its hover fill and keyboard focus border. -->
                        <Expander x:Name="AdvancedExpander" Style="{StaticResource Settings.Expander}" Margin="0,12,0,0"
                                  Header="{loc:Text SettingsUx_AdvancedHeading}"
                                  AutomationProperties.Name="{loc:Text SettingsUx_AdvancedHeading}"
                                  AutomationProperties.HelpText="{loc:Text SettingsUx_AdvancedHint}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Settings.Description}" Margin="0,0,0,12"
                                           Text="{loc:Text SettingsUx_AdvancedHint}" />
                                <StackPanel Style="{StaticResource Settings.Field}">
                                    <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text Settings.GitHubIssueUrl}" />
                                    <TextBlock Style="{StaticResource Settings.Description}" Text="{loc:Text SettingsUx_GitHubIssueUrlHint}" />
                                    <TextBox x:Name="GitHubIssueUrlBox" Style="{StaticResource Settings.TextBox}"
                                             AutomationProperties.Name="{loc:Text Settings.GitHubIssueUrl}"
                                             Text="{Binding GitHubIssueUrl, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource Settings.Field}">
                                    <TextBlock Style="{StaticResource Settings.Label}" Text="{loc:Text GitHub_TokenMode}" />
                                    <TextBlock Style="{StaticResource Settings.Description}" Text="{loc:Text GitHub_TokenHint}" />
                                    <PasswordBox x:Name="GitHubTokenBox" Style="{StaticResource Settings.PasswordBox}"
                                                 AutomationProperties.Name="{loc:Text GitHub_TokenLabel}"
                                                 AutomationProperties.HelpText="{loc:Text GitHub_TokenHint}"
                                                 PasswordChanged="OnGitHubTokenChanged" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- About: version and updates, then the settings backup. -->
            <TabItem x:Name="UpdateTab"
                     Header="{loc:Text SettingsUx_TabAbout}" AutomationProperties.Name="{loc:Text SettingsUx_TabAbout}"
                     ToolTip="{loc:Text SettingsUx_TabAboutHelp}" AutomationProperties.HelpText="{loc:Text SettingsUx_TabAboutHelp}"
                     Tag="{StaticResource Settings.Icon.About}">
                <!-- The unpackaged guidance and the status line can outgrow the minimum window. -->
                <ScrollViewer x:Name="UpdateScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,12,12,4">
                        <TextBlock x:Name="UpdateVersionLabel" Style="{StaticResource Settings.Label}" />
                        <TextBlock x:Name="UpdateDescription" TextWrapping="Wrap" Margin="0,6,0,12"
                                   Foreground="{DynamicResource Text.Secondary}" />
                        <!-- Secondary: the window's one filled button is Apply. -->
                        <WrapPanel>
                            <Button x:Name="UpdateAction" Style="{StaticResource Button.Secondary}" Click="OnUpdateAction" MinWidth="140" Margin="0,0,8,8" />
                            <Button x:Name="StoreRatingButton" Style="{StaticResource Button.Secondary}" Visibility="Collapsed"
                                    MinWidth="140" Margin="0,0,8,8"
                                    Content="{loc:Text StoreRating_Button}"
                                    AutomationProperties.Name="{loc:Text StoreRating_Button}"
                                    AutomationProperties.HelpText="{loc:Text StoreRating_ButtonHelp}"
                                    Click="OnStoreRatingClick" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource Settings.GroupHeading}" Text="{loc:Text SettingsUx_BackupHeading}" />
                        <TextBlock Style="{StaticResource Settings.Description}" Margin="0,0,0,10"
                                   Text="{loc:Text SettingsUx_BackupHint}" />
                        <WrapPanel>
                            <Button x:Name="ExportSettingsButton" Style="{StaticResource Button.Secondary}"
                                    Content="{loc:Text Settings_Export}"
                                    MinWidth="140" Margin="0,0,8,8"
                                    AutomationProperties.Name="{loc:Text Settings_Export}"
                                    Click="OnExportSettings" />
                            <Button x:Name="ImportSettingsButton" Style="{StaticResource Button.Secondary}"
                                    Content="{loc:Text Settings_Import}"
                                    MinWidth="140" Margin="0,0,8,8"
                                    AutomationProperties.Name="{loc:Text Settings_Import}"
                                    Click="OnImportSettings" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ===================== Error summary ===================== -->
        <Border x:Name="ErrorSummary"
                Grid.Row="1"
                Margin="0,8,0,0"
                Padding="12,8"
                CornerRadius="6"
                Background="{DynamicResource Surface.Sunken}"
                BorderBrush="{DynamicResource State.Danger}"
                BorderThickness="1"
                Visibility="Collapsed"
                AutomationProperties.LiveSetting="Assertive">
            <StackPanel>
                <TextBlock x:Name="ErrorSummaryHeading"
                           Foreground="{DynamicResource State.Danger}"
                           FontWeight="Bold"
                           FontSize="{StaticResource FontSize.Body}"
                           Text="{loc:Text Text_EF7DD8DA5437}"
                           AutomationProperties.Name="{loc:Text Text_FAE3A646286D}" />
                <ItemsControl x:Name="ErrorList" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="{DynamicResource Text.Primary}"
                                       FontSize="{StaticResource FontSize.Caption}"
                                       TextWrapping="Wrap"
                                       Margin="0,1,0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border x:Name="SettingsStatusRegion" Grid.Row="2" Margin="0,8,0,0"
                Padding="12,8" CornerRadius="6" Visibility="Collapsed"
                Background="{DynamicResource Surface.Raised}"
                BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
            <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="SettingsStatus" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text.Secondary}"
                           FontSize="{StaticResource FontSize.Caption}"
                           AutomationProperties.LiveSetting="Polite" />
            </ScrollViewer>
        </Border>

        <!-- ===================== Command bar =====================
             One filled button (Apply). Keys live in tooltips and accelerator properties, not in
             the labels. Cancel discards deliberately; Esc and the title bar close ask first when
             something is unapplied. -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="DefaultsButton"
                    Style="{StaticResource Button.Secondary}"
                    Content="{loc:Text Text_205C50A145BA}"
                    MinWidth="120"
                    ToolTip="{loc:Text Text_D8A23CD47E7A}"
                    AutomationProperties.Name="{loc:Text Text_205C50A145BA}"
                    AutomationProperties.HelpText="{loc:Text Text_D8A23CD47E7A}"
                    Click="OnResetDefaults" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="ApplyButton"
                        Style="{StaticResource Button.Primary}"
                        Content="{loc:Text Text_6A1C963D5BC5}"
                        MinWidth="88"
                        IsDefault="True"
                        ToolTip="{loc:Text Text_B89071D80D8F}"
                        AutomationProperties.Name="{loc:Text Text_6A1C963D5BC5}"
                        AutomationProperties.HelpText="{loc:Text Text_B89071D80D8F}"
                        AutomationProperties.AcceleratorKey="Ctrl+S"
                        Click="OnApply" />
                <Button x:Name="CancelButton"
                        Style="{StaticResource Button.Secondary}"
                        Content="{loc:Text Text_BE876433993A}"
                        MinWidth="88"
                        Margin="8,0,0,0"
                        ToolTip="{loc:Text SettingsUx_CancelTip}"
                        AutomationProperties.Name="{loc:Text Text_BE876433993A}"
                        AutomationProperties.HelpText="{loc:Text SettingsUx_CancelTip}"
                        Click="OnCancel" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
