<Window x:Class="MyCapture.App.Gallery.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:MyCapture.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:themes="clr-namespace:MyCapture.App.Themes"
        xmlns:gallery="clr-namespace:MyCapture.App.Gallery"
        x:ClassModifier="internal"
        Style="{DynamicResource Window.Standard}"
        Title="{loc:Text Text_37AD4F28D422}"
        Width="1280" Height="760"
        MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface.Base}"
        Foreground="{DynamicResource Text.Primary}">

    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <themes:GalleryWorkspaceResources />
        </ResourceDictionary.MergedDictionaries>

        <!-- Local, so hosts that supply only the shared converters still load this window. -->
        <gallery:GalleryThumbnailHeightConverter x:Key="Gallery.ThumbnailHeight" />
        <gallery:IsFolderRowConverter x:Key="IsFolderRow" />
        <gallery:HasValueToVisibilityConverter x:Key="LibraryUx.HasValue" />
        <sys:Double x:Key="Gallery.SearchFolderBadgeWidth">96</sys:Double>

        <!-- Tile action glyphs come from the shared Symbols.xaml resource dictionary
             (Icon.Copy / Icon.Pin / Icon.More / Icon.Ocr / Icon.Delete), referenced by key. -->

        <!-- Gallery actions inherit the shared icon-only states and retain a compact grid fit. -->
        <Style x:Key="Gallery.IconButton" TargetType="Button" BasedOn="{StaticResource Button.GhostCompact}">
            <Setter Property="MinWidth" Value="{DynamicResource CommandButton.Height.Compact}" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <Style x:Key="Gallery.SelectionCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="28" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="SelectionBox" Width="18" Height="18" HorizontalAlignment="Left"
                                    Background="{DynamicResource Surface.Sunken}" BorderBrush="{DynamicResource Border.Control}"
                                    BorderThickness="1" CornerRadius="4">
                                <Path x:Name="SelectionCheck" Data="M 3,8 L 7,12 L 14,4" Visibility="Collapsed"
                                      Stroke="{DynamicResource Text.OnAccent}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Border>
                            <Border x:Name="SelectionFocus" Width="22" Height="22" HorizontalAlignment="Left" Margin="-2,0,0,0"
                                    BorderBrush="{DynamicResource Border.Focus}" BorderThickness="2" CornerRadius="6"
                                    Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionBox" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionBox" Property="Background" Value="{DynamicResource Accent.Default}" />
                                <Setter TargetName="SelectionBox" Property="BorderBrush" Value="{DynamicResource Accent.Default}" />
                                <Setter TargetName="SelectionCheck" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SelectionFocus" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Library states follow the shared control templates (Themes/Controls.xaml): hover and
             selection are layers over the rest chrome whose opacity triggers move through
             FluidMotion.FadeTo (hover and press over Motion.Fast, selection over Motion.Normal),
             snapping when Windows animation effects are off. Brushes are never animated. -->
        <!-- The library's hover wash. A Windows contrast theme draws Surface.Hover in the Window
             colour, so the hover shows through StateLayer's Border.Hover edge (Highlight there,
             transparent in every app palette). A layer without a BorderThickness pairs it with a
             separate StateLayer outline. -->
        <Style x:Key="LibraryUx.HoverWash" TargetType="Border" BasedOn="{StaticResource StateLayer.Hover}" />
        <!-- A selected navigation row keeps its wash and accent pill without a card outline. -->
        <Style x:Key="LibraryUx.SelectedWash" TargetType="Border" BasedOn="{StaticResource StateLayer}">
            <Setter Property="Background" Value="{DynamicResource Surface.Selected}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="themes:FluidMotion.Transition" Value="Normal" />
        </Style>
        <!-- A rest outline that hands over to a hover outline: it fades out while the hover copy
             fades in, so the hovered edge is the hover colour alone, never one over the other. -->
        <Style x:Key="LibraryUx.RestEdge" TargetType="FrameworkElement">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="themes:FluidMotion.FadeTo" Value="1" />
        </Style>

        <ContextMenu x:Key="Gallery.EmptyContextMenu" x:Shared="False" Opened="OnEmptyContextMenuOpened">
            <MenuItem Header="{loc:Text Folder410.NewFolder}" InputGestureText="Ctrl+Shift+N" Click="OnNewFolderClick" />
            <MenuItem Header="{loc:Text Folder410.Sort}">
                <MenuItem Header="{loc:Text Folder410.Newest}" Tag="0" IsCheckable="True" Click="OnEmptySortClick" />
                <MenuItem Header="{loc:Text Folder410.Oldest}" Tag="1" IsCheckable="True" Click="OnEmptySortClick" />
                <MenuItem Header="{loc:Text Folder410.ByName}" Tag="2" IsCheckable="True" Click="OnEmptySortClick" />
            </MenuItem>
            <MenuItem Header="{loc:Text Library453.SelectAll}" InputGestureText="Ctrl+A" Click="OnSelectAllVisibleClick" />
            <Separator />
            <MenuItem Header="{loc:Text Library.Import.Command}" Click="OnImportClick" />
        </ContextMenu>

        <ContextMenu x:Key="Gallery.FolderContextMenu" x:Shared="False" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{loc:Text Folder410.NewFolder}" CommandParameter="{Binding}"
                      InputGestureText="Ctrl+Shift+N" Click="OnNewFolderClick" />
            <MenuItem Header="{loc:Text Folder410.Rename}" CommandParameter="{Binding}"
                      IsEnabled="{Binding IsFolder}" InputGestureText="F2" Click="OnRenameFolderClick" />
            <MenuItem Header="{loc:Text Folder410.MoveFolder}" CommandParameter="{Binding}"
                      IsEnabled="{Binding IsFolder}" InputGestureText="M" Click="OnMoveFolderClick" />
            <Separator />
            <MenuItem Header="{loc:Text Folder410.FolderExport}" CommandParameter="{Binding}" Click="OnExportFolderClick" />
            <MenuItem Header="{loc:Text Folder410.ZipExport}" CommandParameter="{Binding}" Click="OnExportFolderZipClick" />
            <Separator />
            <MenuItem Header="{Binding DeleteLabel, FallbackValue={loc:Text Folder410.Delete}}" CommandParameter="{Binding}"
                      InputGestureText="Del" Foreground="{DynamicResource Text.Primary}"
                      Click="OnDeleteFolderClick" />
        </ContextMenu>

        <!-- The capture card's menu: one instance for the whole library, built the first time a menu opens
             (GalleryWindow.TileMenu.cs), not one per card. It inherits the DataContext of the card or More
             button it opens from (the tile view model) via PlacementTarget, and each item carries the tile as
             CommandParameter so the handler always resolves the right record even though menu items are
             outside the visual tree. -->
        <ContextMenu x:Key="Gallery.TileContextMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <!-- Open actions, copy/export, organize, source, delete/rename, then properties. -->
            <MenuItem Tag="Play" Header="{loc:Text Text_D43A776C5E28}" CommandParameter="{Binding}" Click="OnPlayMenuClick"
                      InputGestureText="Enter" AutomationProperties.Name="{loc:Text Text_D43A776C5E28}"
                      Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Tag="Edit" Header="{loc:Text Text_1003CFC78E66}" CommandParameter="{Binding}" Click="OnEditClick" InputGestureText="{Binding EditGestureText}"
                      AutomationProperties.Name="{loc:Text Text_1003CFC78E66}" />
            <MenuItem Tag="Preview" Header="{loc:Text LibraryUx_Preview}" CommandParameter="{Binding}" Click="OnPreviewMenuClick" InputGestureText="Space"
                      AutomationProperties.Name="{loc:Text LibraryUx_Preview}" />
            <MenuItem Tag="Pin" Header="{loc:Text Gallery.Float}" CommandParameter="{Binding}" Click="OnFloatClick" InputGestureText="P"
                      AutomationProperties.Name="{loc:Text Gallery.Float}"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Icon>
                    <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Pin}" Stroke="{DynamicResource Text.Secondary}" Fill="Transparent" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Tag="Recognize" Header="{loc:Text Text_854582314EBD}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="{loc:Text Text_854582314EBD}"
                      InputGestureText="T"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}"
                      Click="OnOcrMenuClick">
                <MenuItem.Icon>
                    <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Ocr}"
                          Stroke="{DynamicResource Text.Secondary}" Fill="Transparent" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Tag="Compare" Header="{loc:Text Gallery.Compare}"
                      Command="{x:Static gallery:GalleryWindow.CompareCommand}"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Tag="Copy" Header="{loc:Text Text_42A667BC71B0}" CommandParameter="{Binding}" Click="OnCopyClick" InputGestureText="Ctrl+C"
                      AutomationProperties.Name="{loc:Text Text_42A667BC71B0}"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Icon>
                    <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Copy}" Stroke="{DynamicResource Text.Secondary}" Fill="Transparent" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Tag="ExportImage" Header="{loc:Text Library.ExportImage}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="{loc:Text Library.ExportImage}"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}"
                      Click="OnReducedExportClick" />
            <MenuItem Tag="CreatePdf" Header="{loc:Text ContactSheet.Action}" CommandParameter="{Binding}"
                      AutomationProperties.Name="{loc:Text ContactSheet.Action}" Click="OnContactSheetClick" />
            <MenuItem Tag="ExportGif" Header="{loc:Text Library.ExportGif}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="{loc:Text Library.ExportGif}"
                      InputGestureText="G"
                      Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}"
                      Click="OnGifMenuClick" />
            <Separator />
            <MenuItem Tag="Move" Header="{loc:Text Folder410.MoveCaptures}" CommandParameter="{Binding}"
                      InputGestureText="M" Click="OnMoveCapturesClick" />
            <MenuItem Tag="Tags" Header="{loc:Text Library.Tags.Edit}" CommandParameter="{Binding}" Click="OnBatchTagsClick" />
            <MenuItem Tag="Keep" Header="{loc:Text LibraryUx_Keep}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="{loc:Text LibraryUx_KeepToggleName}"
                      InputGestureText="K"
                      Click="OnPinMenuClick" />
            <Separator Tag="SeparatorSource" />
            <MenuItem Tag="OpenSource" Header="{loc:Text Source.Open}" CommandParameter="{Binding}" Click="OnOpenSourceMenuClick"
                      AutomationProperties.Name="{loc:Text Source.Open}"
                      Visibility="{Binding SourceProvenance.CanOpen, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Tag="SameSource" Header="{loc:Text Source.ShowSame}" CommandParameter="{Binding}" Click="OnSameSourceMenuClick"
                      AutomationProperties.Name="{loc:Text Source.ShowSame}"
                      Visibility="{Binding HasSourceBadge, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Tag="SourceDetails" Header="{loc:Text LibraryUx_SourceDetails}" CommandParameter="{Binding}" Click="OnSourceDetailsMenuClick"
                      AutomationProperties.Name="{loc:Text LibraryUx_SourceDetails}"
                      Visibility="{Binding HasSourceBadge, Converter={StaticResource BoolToVisibility}}" />
            <Separator />
            <MenuItem Tag="Delete" Header="{loc:Text Text_6139B6C3ED73}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="{loc:Text Text_6139B6C3ED73}"
                      InputGestureText="Del"
                      Foreground="{DynamicResource Text.Primary}"
                      Click="OnDeleteMenuClick">
                <MenuItem.Icon>
                    <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Delete}"
                          Stroke="{DynamicResource Text.Primary}" Fill="Transparent" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Tag="Rename" Header="{loc:Text Library453.Rename}" CommandParameter="{Binding}" Click="OnRenameCaptureClick"
                      InputGestureText="F2" AutomationProperties.Name="{loc:Text Library453.Rename}" />
            <Separator />
        </ContextMenu>

        <!-- Declared ahead of the card templates, which use it for the folder badge. -->
        <PathGeometry x:Key="LibraryUx.Icon.Folder"
                      Figures="M2.75,5.25 A1.25,1.25 0 0 1 4,4 L7.6,4 L9.4,5.75 L16,5.75 A1.25,1.25 0 0 1 17.25,7 L17.25,14.75 A1.25,1.25 0 0 1 16,16 L4,16 A1.25,1.25 0 0 1 2.75,14.75 Z" />

        <!-- A search or the image, video and kept views list captures from every folder; a card
             filed in a folder other than the one open names it, so the result says where it lives. -->
        <Style x:Key="Gallery.FolderBadge" TargetType="Border">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource Surface.BadgeStrong}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="{Binding HasFolderBadge, Converter={StaticResource BoolToVisibility}}" />
        </Style>

        <DataTemplate x:Key="Gallery.FolderBadgeContent" DataType="{x:Type gallery:GalleryItemViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <themes:SymbolIcon StrokeThickness="0" Size="12" Data="{StaticResource LibraryUx.Icon.Folder}"
                      Fill="{DynamicResource Accent.Folder}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding FolderBadge}" Margin="4,0,0,0"
                           Foreground="{DynamicResource Text.Badge}" FontSize="{DynamicResource FontSize.Caption}"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <Style x:Key="Gallery.SourceBadge" TargetType="Button" BasedOn="{StaticResource Button.GhostCompact}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="MaxWidth" Value="24" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="600" />
            <Setter Property="ToolTipService.ShowDuration" Value="120000" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="Gallery.TileTemplate" DataType="{x:Type gallery:GalleryItemViewModel}">
            <DataTemplate.Resources>
                <gallery:GalleryCardNameConverter x:Key="Card.SelectionName" Format="LibraryUx_SelectCard" />
                <gallery:HasTextConverter x:Key="Card.HasText" />
                <!-- The selection box over the thumbnail's top left: a 32 x 32 target around a 20 x 20 box,
                     6 DIPs in from the corner. Opaque fill and edge, so it reads over any image; no shadow or
                     effect. It is hidden (and out of the pointer's way, but not of UI Automation) until the card
                     is hovered, selected, keyboard-focused, or something is selected. -->
                <Style x:Key="Card.SelectionBox" TargetType="CheckBox">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Setter Property="IsTabStop" Value="False" />
                    <!-- Never a focus target: a hidden box must not become an invisible stop for the keyboard
                         or a screen reader's cursor. A click, a touch and UI Automation's Toggle still work. -->
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Cursor" Value="Arrow" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="CheckBox">
                                <Grid Background="Transparent">
                                    <Border x:Name="SelectionBox" Width="20" Height="20" CornerRadius="5" BorderThickness="1" SnapsToDevicePixels="True"
                                            Background="{DynamicResource Surface.Raised}" BorderBrush="{DynamicResource Border.Control}">
                                        <Path x:Name="SelectionCheck" Data="{StaticResource Icon.Check}" Visibility="Collapsed"
                                              Stroke="{DynamicResource Text.OnAccent}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SelectionBox" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="SelectionBox" Property="Background" Value="{DynamicResource Accent.Default}" />
                                        <Setter TargetName="SelectionBox" Property="BorderBrush" Value="{DynamicResource Accent.Default}" />
                                        <Setter TargetName="SelectionCheck" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <!-- Pin, copy and more: always on the card, quiet until the pointer is over them. They skip Tab
                     (the grid is one Tab stop); the keys and Shift+F10 reach the same commands. -->
                <Style x:Key="Card.Action" TargetType="Button" BasedOn="{StaticResource Button.GhostCompact}">
                    <Setter Property="Width" Value="28" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="MinWidth" Value="28" />
                    <Setter Property="MinHeight" Value="28" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Cursor" Value="Arrow" />
                    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataTemplate.Resources>
            <!-- Contain preserves screenshot text and edges; overlays keep a fixed DIP size. -->
            <Border x:Name="TileCard" Background="{DynamicResource Surface.Raised}"
                    BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Lg}" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="TilePreview" Background="{DynamicResource Surface.Sunken}" ClipToBounds="True"
                            Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource Gallery.ThumbnailHeight}}">
                        <Grid>
                            <!-- A thumbnail that arrives after the card is on screen fades in; a cached one does not. -->
                            <gallery:GalleryThumbnailImage Source="{Binding Thumbnail}" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{Binding AccessibleName}" />
                            <TextBlock Text="{Binding PreviewUnavailableText}" Margin="6" TextWrapping="Wrap" TextAlignment="Center"
                                       FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Text.Secondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsBroken, Converter={StaticResource BoolToVisibility}}" />
                            <Grid VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="VideoBadge" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="5" Padding="5,2" CornerRadius="4" Background="{DynamicResource Surface.Raised}"
                                        IsHitTestVisible="False" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <themes:SymbolIcon Size="12" Data="{StaticResource Icon.Play}" Margin="0,0,4,0"
                                                           Fill="{DynamicResource Text.Primary}" Stroke="{DynamicResource Text.Primary}" />
                                        <TextBlock Text="{Binding DurationCaption}" FontSize="{DynamicResource FontSize.Caption}"
                                                   Foreground="{DynamicResource Text.Primary}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <CheckBox x:Name="SelectBox" Style="{StaticResource Card.SelectionBox}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                      Click="OnTileCheckClick" Checked="OnTileCheckToggled" Unchecked="OnTileCheckToggled"
                                      AutomationProperties.Name="{Binding ContextLabel, Converter={StaticResource Card.SelectionName}}" />
                        </Grid>
                    </Border>
                    <!-- Row 1: the title and, at its right end, when the capture was taken. Row 2: where it came
                         from, what is known about it, and the card's three commands. -->
                    <Grid x:Name="TileInformation" Grid.Row="1" Margin="8,8,6,8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.ColumnSpan="2" Margin="0,0,8,2" VerticalAlignment="Center">
                            <TextBlock x:Name="TileTitle" Text="{Binding Caption}" gallery:GalleryCaptionPreview.IsEnabled="True"
                                       Foreground="{DynamicResource Text.Primary}" FontWeight="SemiBold"
                                       FontSize="{DynamicResource FontSize.Body}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="TileRenameInput" Text="{Binding RenameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="{DynamicResource FontSize.Body}" Padding="1,0" MinHeight="0" MinWidth="0"
                                     MaxLength="140" IsReadOnly="{Binding IsRenameSaving}"
                                     AutomationProperties.Name="{loc:Text Library453.Rename}"
                                     Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}"
                                     PreviewKeyDown="OnCaptureRenameKeyDown" LostKeyboardFocus="OnCaptureRenameLostFocus" />
                        </Grid>
                        <TextBlock x:Name="TileTime" Grid.Column="2" Text="{Binding TimeCaption}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,2"
                                   ToolTip="{loc:Text MediaInfo.Title}" ToolTipOpening="OnMediaDetailsToolTipOpening"
                                   FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Text.Secondary}" />
                        <Button x:Name="SourceBadge" Grid.Row="1" Style="{StaticResource Gallery.SourceBadge}"
                                gallery:GallerySourceBadge.Provenance="{Binding SourceProvenance}"
                                AutomationProperties.AutomationId="LibrarySourceBadge"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                Visibility="{Binding HasSourceBadge, Converter={StaticResource BoolToVisibility}}" />
                        <Grid x:Name="TileMetadata" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="TileStatusBadges" HorizontalAlignment="Left" ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="KeepBadge" Padding="4,1" CornerRadius="3" Margin="0,0,4,0"
                                        Background="{DynamicResource Surface.Sunken}" ToolTip="{loc:Text LibraryUx_KeptBadge}"
                                        AutomationProperties.Name="{loc:Text LibraryUx_KeptBadge}"
                                        Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}">
                                    <themes:SymbolIcon Size="12" Data="{DynamicResource LibraryUx.Icon.Kept}" Stroke="{DynamicResource Text.Secondary}" Fill="Transparent" />
                                </Border>
                                <Border x:Name="FolderBadge" Grid.Column="1" Style="{StaticResource Gallery.FolderBadge}"
                                        Padding="4,1" CornerRadius="3" HorizontalAlignment="Left" MaxWidth="96"
                                        MinWidth="20" IsHitTestVisible="True" ToolTip="{Binding FolderBadge}">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Gallery.FolderBadgeContent}" />
                                </Border>
                            </Grid>
                            <!-- A search match or an approaching deletion takes priority over status badges. -->
                            <TextBlock x:Name="TileMetadataText" Grid.Column="1" Text="{Binding MetadataCaption}"
                                       FontSize="{DynamicResource FontSize.Caption}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding MetadataCaption}" ToolTipOpening="OnMediaDetailsToolTipOpening"
                                       Visibility="{Binding MetadataCaption, Converter={StaticResource Card.HasText}}" />
                        </Grid>
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PinButton" Style="{StaticResource Card.Action}" Click="OnFloatClick"
                                    ToolTip="{loc:Text LibraryUx_PinHint}" AutomationProperties.Name="{loc:Text Gallery.Float}"
                                    Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                                <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Pin}" Fill="Transparent"
                                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button x:Name="CopyButton" Style="{StaticResource Card.Action}" Click="OnCopyClick"
                                    ToolTip="{loc:Text Text_59D43391538F}" AutomationProperties.Name="{loc:Text Text_42A667BC71B0}"
                                    Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                                <Grid VerticalAlignment="Center">
                                    <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Copy}" Fill="Transparent"
                                                       gallery:GalleryCopyFeedback.Part="Glyph" themes:FluidMotion.FadeTo="1"
                                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Check}" Opacity="0" Fill="Transparent"
                                                       gallery:GalleryCopyFeedback.Part="Check"
                                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Grid>
                            </Button>
                            <Button x:Name="MoreButton" Style="{StaticResource Card.Action}" Click="OnMoreClick"
                                    ToolTip="{loc:Text LibraryUx_TileMoreHint}" AutomationProperties.Name="{loc:Text Text_5E8959D18390}">
                                <themes:SymbolIcon Size="16" Data="{StaticResource Icon.More}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- The selection box shows while the card is hovered, selected or keyboard-focused, and on every
                     card while anything is selected; it fades in over the fast motion token. -->
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="SelectBox" Property="themes:FluidMotion.FadeTo" Value="1" />
                    <Setter TargetName="SelectBox" Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
                <Trigger SourceName="TileCard" Property="gallery:GalleryCardInput.SelectionActive" Value="True">
                    <Setter TargetName="SelectBox" Property="themes:FluidMotion.FadeTo" Value="1" />
                    <Setter TargetName="SelectBox" Property="IsHitTestVisible" Value="True" />
                </Trigger>
                <Trigger SourceName="TileCard" Property="gallery:GalleryCardInput.ShowsKeyboardFocus" Value="True">
                    <Setter TargetName="SelectBox" Property="themes:FluidMotion.FadeTo" Value="1" />
                    <Setter TargetName="SelectBox" Property="IsHitTestVisible" Value="True" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="SelectBox" Property="themes:FluidMotion.FadeTo" Value="1" />
                    <Setter TargetName="SelectBox" Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
                <!-- The optional kept mark yields to a reason; the folder remains because it
                     tells the user where a result lives. -->
                <DataTrigger Binding="{Binding MetadataCaption, Converter={StaticResource Card.HasText}}" Value="True">
                    <Setter TargetName="KeepBadge" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <!-- A card in an opened folder: a smaller title and narrower folder badge. -->
                <Trigger SourceName="TileCard" Property="gallery:GalleryCardStyle.IsCompact" Value="True">
                    <Setter TargetName="TileTitle" Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
                    <Setter TargetName="TileRenameInput" Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
                    <Setter TargetName="FolderBadge" Property="MaxWidth" Value="48" />
                </Trigger>
                <!-- This follows the compact trigger: filed search results need a readable folder
                     name beside their reason even on compact cards. Row width reserves both lanes. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasFolderBadge}" Value="True" />
                        <Condition Binding="{Binding MetadataCaption, Converter={StaticResource Card.HasText}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="FolderBadge" Property="MinWidth" Value="{DynamicResource Gallery.SearchFolderBadgeWidth}" />
                    <Setter TargetName="FolderBadge" Property="MaxWidth" Value="{DynamicResource Gallery.SearchFolderBadgeWidth}" />
                    <Setter TargetName="FolderBadge" Property="Margin" Value="0,0,4,0" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="Gallery.TileRowList" TargetType="ListBox">
            <!-- Rows have no independent scrolling surface: wheel input reaches RowsList. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
            <Setter Property="ItemTemplate" Value="{StaticResource Gallery.TileTemplate}" />
            <!-- Equal cells over the row's whole width; the card height follows its width. -->
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <gallery:GalleryCardRowPanel Columns="{Binding Columns}"
                                                     TitleFontSize="{DynamicResource FontSize.Body}" CaptionFontSize="{DynamicResource FontSize.Caption}"
                                                     BaseCardWidth="244" BaseCardHeight="220" HeightPerWidth="0.625" CardInset="16" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        <Setter Property="AutomationProperties.HelpText" Value="{Binding ExportToolTip}" />
                        <Setter Property="gallery:GalleryCaptionPreview.IsEnabled" Value="True" />
                        <Setter Property="gallery:GalleryCardInput.Track" Value="True" />
                        <Setter Property="IsTabStop" Value="False" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <!-- The transparent outline takes the pointer; hover and selection fade in
                                         over it. Selection sits above hover, so a hovered selected card keeps
                                         its neutral selected edge. -->
                                    <Grid>
                                        <Border x:Name="Outline"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="2"
                                                CornerRadius="{StaticResource Radius.Lg}" />
                                        <Border x:Name="HoverLayer"
                                                Style="{StaticResource LibraryUx.HoverWash}"
                                                BorderThickness="2"
                                                CornerRadius="{StaticResource Radius.Lg}" />
                                        <Border x:Name="SelectedLayer"
                                                Style="{StaticResource StateLayer.Selected}"
                                                Background="Transparent" BorderBrush="{DynamicResource Accent.Default}"
                                                BorderThickness="2"
                                                CornerRadius="{StaticResource Radius.Lg}" />
                                        <ContentPresenter Margin="8" />
                                        <Border x:Name="FocusRing" Margin="3" BorderThickness="{DynamicResource Focus.RingThickness}" Opacity="0"
                                                BorderBrush="{DynamicResource Text.Primary}" IsHitTestVisible="False"
                                                CornerRadius="{StaticResource Radius.Lg}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="SelectedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                                            <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="0" />
                                        </DataTrigger>
                                        <!-- Keyboard focus recolours the fixed edge at once, on the layers too. A click also
                                             focuses the card, but only the keyboard draws the ring. -->
                                        <Trigger Property="gallery:GalleryCardInput.ShowsKeyboardFocus" Value="True">
                                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                            <Setter TargetName="HoverLayer" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />

                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A day heading reads as text (semibold, no chrome, a hairline after it), the way a list's group heading
             does. It stays a Button: clicking selects the day's captures (Ctrl adds), Enter and Space do the same from
             the keyboard, and screen readers announce a button. -->
        <Style x:Key="Gallery.DayHeading" TargetType="Button" BasedOn="{StaticResource Button.GhostCompact}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <DataTemplate x:Key="Gallery.HeaderRowTemplate" DataType="{x:Type gallery:GalleryHeaderRow}">
            <Grid Margin="8,16,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="{Binding Heading}" Style="{StaticResource Gallery.DayHeading}" Click="OnDayClick" IsTabStop="False" PreviewKeyDown="OnDayKeyDown" AutomationProperties.Name="{Binding Heading}" ToolTip="{loc:Text LibrarySelection_SelectDay}" />
                <Border Grid.Column="1" Height="1" Margin="14,0,0,0"
                        Background="{DynamicResource Border.Subtle}"
                        VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Gallery.TileRowTemplate" DataType="{x:Type gallery:GalleryTileRow}">
            <ListBox Style="{StaticResource Gallery.TileRowList}"
                     ItemsSource="{Binding Tiles}"
                     PreviewMouseLeftButtonDown="OnTileMouseLeftButtonDown"
                     MouseDoubleClick="OnTileDoubleClick" />
        </DataTemplate>

        <!-- Compact cards are the same template; the list says so and the card follows (see the template's triggers). -->
        <Style x:Key="Gallery.CompactTileRowList" TargetType="ListBox" BasedOn="{StaticResource Gallery.TileRowList}">
            <Setter Property="gallery:GalleryCardStyle.IsCompact" Value="True" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <gallery:GalleryCardRowPanel Columns="{Binding Columns}"
                                                     TitleFontSize="{DynamicResource FontSize.Caption}" BaseTitleFontSize="12" CaptionFontSize="{DynamicResource FontSize.Caption}"
                                                     BaseCardWidth="148" BaseCardHeight="160" HeightPerWidth="0.625" CardInset="16" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="Gallery.CompactTileRowTemplate" DataType="{x:Type gallery:GalleryTileRow}">
            <ListBox Style="{StaticResource Gallery.CompactTileRowList}"
                     ItemsSource="{Binding Tiles}"
                     PreviewMouseLeftButtonDown="OnTileMouseLeftButtonDown"
                     MouseDoubleClick="OnTileDoubleClick" />
        </DataTemplate>

        <!-- Library icons on the shared 20x20 symbol grid, local so the shared Symbols.xaml stays untouched. -->
        <PathGeometry x:Key="LibraryUx.Icon.AllItems"
                      Figures="M4,3.25 L8,3.25 A0.75,0.75 0 0 1 8.75,4 L8.75,8 A0.75,0.75 0 0 1 8,8.75 L4,8.75 A0.75,0.75 0 0 1 3.25,8 L3.25,4 A0.75,0.75 0 0 1 4,3.25 Z M12,3.25 L16,3.25 A0.75,0.75 0 0 1 16.75,4 L16.75,8 A0.75,0.75 0 0 1 16,8.75 L12,8.75 A0.75,0.75 0 0 1 11.25,8 L11.25,4 A0.75,0.75 0 0 1 12,3.25 Z M4,11.25 L8,11.25 A0.75,0.75 0 0 1 8.75,12 L8.75,16 A0.75,0.75 0 0 1 8,16.75 L4,16.75 A0.75,0.75 0 0 1 3.25,16 L3.25,12 A0.75,0.75 0 0 1 4,11.25 Z M12,11.25 L16,11.25 A0.75,0.75 0 0 1 16.75,12 L16.75,16 A0.75,0.75 0 0 1 16,16.75 L12,16.75 A0.75,0.75 0 0 1 11.25,16 L11.25,12 A0.75,0.75 0 0 1 12,11.25 Z" />
        <PathGeometry x:Key="LibraryUx.Icon.Video"
                      Figures="M3.25,4.75 L16.75,4.75 A1.25,1.25 0 0 1 18,6 L18,14 A1.25,1.25 0 0 1 16.75,15.25 L3.25,15.25 A1.25,1.25 0 0 1 2,14 L2,6 A1.25,1.25 0 0 1 3.25,4.75 Z M8.25,7.5 L12.75,10 L8.25,12.5 Z" />
        <PathGeometry x:Key="LibraryUx.Icon.Kept"
                      Figures="M5.25,3.25 L14.75,3.25 L14.75,17 L10,13.5 L5.25,17 Z" />
        <PathGeometry x:Key="LibraryUx.Icon.Add" Figures="M10,4.25 L10,15.75 M4.25,10 L15.75,10" />
        <PathGeometry x:Key="LibraryUx.Icon.Pdf"
                      Figures="M5,2.5 L11.5,2.5 L16,7 L16,17.5 L5,17.5 Z M11.5,2.5 L11.5,7 L16,7 M8,10 L13,10 M8,13 L13,13" />
        <PathGeometry x:Key="LibraryUx.Icon.Calendar"
                      Figures="M4.25,4.75 L15.75,4.75 A1,1 0 0 1 16.75,5.75 L16.75,15.75 A1,1 0 0 1 15.75,16.75 L4.25,16.75 A1,1 0 0 1 3.25,15.75 L3.25,5.75 A1,1 0 0 1 4.25,4.75 Z M3.25,8.5 L16.75,8.5 M7,3 L7,6.25 M13,3 L13,6.25" />
        <PathGeometry x:Key="LibraryUx.Icon.Chevron" Figures="M7.75,5.25 L12.5,10 L7.75,14.75" />
        <PathGeometry x:Key="LibraryUx.Icon.Info"
                      Figures="M10,2.75 A7.25,7.25 0 1 1 9.99,2.75 Z M10,9 L10,13.75 M10,6.25 L10,6.3" />
        <!-- A window with a pane on its right: the details pane, as File Explorer draws it. -->
        <PathGeometry x:Key="LibraryUx.Icon.DetailsPane"
                      Figures="M3.75,4.25 L16.25,4.25 A1.5,1.5 0 0 1 17.75,5.75 L17.75,14.25 A1.5,1.5 0 0 1 16.25,15.75 L3.75,15.75 A1.5,1.5 0 0 1 2.25,14.25 L2.25,5.75 A1.5,1.5 0 0 1 3.75,4.25 Z M12.25,4.25 L12.25,15.75" />
        <!-- The card silhouette: a manila-folder tab on the top left, then the 12-DIP card radius. -->
        <PathGeometry x:Key="LibraryUx.FolderCardShape"
                      Figures="M0,10 A10,10 0 0 1 10,0 L84,0 C90,0 92,3 95,7 L97,10 C99,13 101,14 106,14 L232,14 A12,12 0 0 1 244,26 L244,280 A12,12 0 0 1 232,292 L12,292 A12,12 0 0 1 0,280 Z" />

        <!-- Folder cards fill the same cells as capture cards (GalleryCardRowPanel), so they share
             the capture card's size. Both apply their 8-DIP inset in one layout step, avoiding
             separate rounding of 6-DIP margins and a 2-DIP outline at fractional DPI. The
             folder tab, warm Surface.Folder fill, Border.Folder outline and a large folder glyph
             keep them apart from captures in every palette. -->
        <Style x:Key="Gallery.FolderCardButton" TargetType="Button">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="12,22,12,12" />
            <Setter Property="Background" Value="{DynamicResource Surface.Folder}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Folder}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Hover hands the folder edge over to an Accent.Folder edge and fades the wash in;
                             press deepens the wash. Every state part moves only its opacity. The fill keeps a
                             transparent stroke so it fills, and takes the pointer, exactly as the stroked shape did. -->
                        <Grid>
                            <Path x:Name="Chrome" Data="{StaticResource LibraryUx.FolderCardShape}" Stretch="Fill"
                                  Fill="{TemplateBinding Background}" Stroke="Transparent"
                                  StrokeThickness="1" SnapsToDevicePixels="True" />
                            <Path x:Name="SelectedLayer" Data="{StaticResource LibraryUx.FolderCardShape}" Stretch="Fill"
                                  Style="{StaticResource StatePart.Normal}"
                                  Fill="{DynamicResource Surface.Selected}" Opacity="0" IsHitTestVisible="False" />
                            <Path x:Name="Edge" Data="{StaticResource LibraryUx.FolderCardShape}" Stretch="Fill"
                                  Style="{StaticResource LibraryUx.RestEdge}"
                                  Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" SnapsToDevicePixels="True" />
                            <!-- Border.FolderHover and Surface.FolderHoverWash are Accent.Folder and Surface.Hover
                                 in every app palette. A Windows contrast theme draws the rest and hover edges both
                                 in WindowText, so the hover edge takes Highlight there and the wash, which would
                                 dim it, turns clear (ThemeService.ApplyFolderHoverResources). -->
                            <Grid x:Name="HoverEdge" Opacity="0" IsHitTestVisible="False">
                                <Path Data="{StaticResource LibraryUx.FolderCardShape}" Stretch="Fill"
                                      Stroke="{DynamicResource Border.FolderHover}" StrokeThickness="1" SnapsToDevicePixels="True" />
                            </Grid>
                            <Path x:Name="Wash" Data="{StaticResource LibraryUx.FolderCardShape}" Stretch="Fill"
                                  Fill="{DynamicResource Surface.FolderHoverWash}" Opacity="0" IsHitTestVisible="False" />
                            <Path x:Name="DropRing" Data="{StaticResource LibraryUx.FolderCardShape}" Stretch="Fill"
                                  Stroke="{DynamicResource Accent.Folder}" StrokeThickness="2" StrokeDashArray="3 2"
                                  Opacity="0" IsHitTestVisible="False" />
                            <Path x:Name="FocusRing" Data="{StaticResource LibraryUx.FolderCardShape}" Stretch="Fill"
                                  Stroke="{DynamicResource Border.Focus}" StrokeThickness="2" Margin="2"
                                  Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Edge" Property="themes:FluidMotion.FadeTo" Value="0" />
                                <Setter TargetName="HoverEdge" Property="themes:FluidMotion.FadeTo" Value="1" />
                                <Setter TargetName="Wash" Property="themes:FluidMotion.FadeTo" Value="0.35" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Wash" Property="themes:FluidMotion.FadeTo" Value="0.6" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="SelectedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </DataTrigger>
                            <!-- While captures are dragged, every folder that can take them shows a dashed edge. -->
                            <DataTrigger Binding="{Binding IsDropAvailable}" Value="True">
                                <Setter TargetName="DropRing" Property="Opacity" Value="1" />
                            </DataTrigger>
                            <!-- The folder under the pointer: accent edge and wash, like Explorer's drop highlight. -->
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="SelectedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                                <Setter TargetName="DropRing" Property="Stroke" Value="{DynamicResource Text.Primary}" />
                                <Setter TargetName="DropRing" Property="StrokeThickness" Value="3" />
                                <Setter TargetName="DropRing" Property="StrokeDashArray" Value="{x:Null}" />
                                <Setter TargetName="DropRing" Property="Opacity" Value="1" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="Gallery.FolderStripButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDropAvailable}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent.Folder}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent.Default}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True"><Setter Property="Background" Value="{DynamicResource Surface.Selected}" /><Setter Property="BorderThickness" Value="2" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="Gallery.FolderCardTemplate" DataType="{x:Type gallery:GalleryFolderCardViewModel}">
            <Button Style="{StaticResource Gallery.FolderStripButton}" ContextMenu="{StaticResource Gallery.FolderContextMenu}"
                    AutomationProperties.Name="{Binding AccessibleName}" ToolTip="{Binding ToolTipText}"
                    Click="OnFolderCardClick" PreviewKeyDown="OnFolderCardKeyDown">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <themes:SymbolIcon x:Name="FolderGlyph" StrokeThickness="0" Size="16" Data="{StaticResource LibraryUx.Icon.Folder}" Fill="{DynamicResource Accent.Folder}" VerticalAlignment="Center" />
                    <CheckBox Style="{StaticResource Gallery.SelectionCheckBox}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                              Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" Width="18" MinHeight="18"
                              IsHitTestVisible="False" Focusable="False" IsTabStop="False" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding CaptureCount}" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="FolderGlyph" Property="Visibility" Value="Hidden" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="Gallery.FolderRowTemplate" DataType="{x:Type gallery:GalleryFolderRow}">
            <ItemsControl ItemsSource="{Binding Folders}" ItemTemplate="{StaticResource Gallery.FolderCardTemplate}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate>
                    <gallery:GalleryCardRowPanel Columns="{Binding Columns}" BaseCardWidth="244" BaseCardHeight="40"
                        HeightPerWidth="0" CardInset="16" TitleFontSize="{DynamicResource FontSize.Body}" CaptionFontSize="{DynamicResource FontSize.Caption}" />
                </ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <Style x:Key="Gallery.RowContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MaxWidth" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContentTemplate" Value="{StaticResource Gallery.TileRowTemplate}" />
            <!-- Later triggers win: a compact folder row takes the compact folder template. -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource Gallery.CompactTileRowTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={StaticResource IsHeaderRow}}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource Gallery.HeaderRowTemplate}" />

                    <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={StaticResource IsFolderRow}}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource Gallery.FolderRowTemplate}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Converter={StaticResource IsFolderRow}}" Value="True" />
                        <Condition Binding="{Binding IsCompact}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="ContentTemplate" Value="{StaticResource Gallery.FolderRowTemplate}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Gallery.RowsList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <!-- Keep the track reserved in the actual layout as well as the column budget.
                 A short folder must not widen its compact cards when scrolling is unnecessary. -->
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
            <!-- This list is the one Tab stop. Its arrow-focused descendants must not become
                 ListBox's cached Once entry target, which can skip the grid on reverse Tab. -->
            <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
            <Setter Property="gallery:GalleryCardInput.SelectionActive" Value="{Binding HasSelection}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource Gallery.RowContainer}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ============================================================= -->
        <!-- Navigation pane: views, folders and dates share one selection, -->
        <!-- like a Windows navigation view (icon, name, count; accent pill).-->
        <!-- ============================================================= -->
        <!-- The views share one parent panel, which groups them per window. A GroupName would be
             shared by every library window, so a closed or not yet shown window could uncheck the
             view of another. -->
        <Style x:Key="LibraryUx.NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <!-- The checked wash sits above the hover wash; the accent pill fades in with it. -->
                        <Grid Background="Transparent">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource Radius.Md}" />
                            <Border x:Name="HoverLayer" Style="{StaticResource LibraryUx.HoverWash}" BorderThickness="1" />
                            <Border x:Name="SelectedLayer" Style="{StaticResource LibraryUx.SelectedWash}" BorderThickness="1" />
                            <Border x:Name="Indicator" Style="{StaticResource StatePart.Normal}" Width="3" Height="16" Margin="1,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource Text.Primary}" CornerRadius="{DynamicResource Radius.Pill}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter Margin="12,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                            <Border x:Name="FocusRing" Margin="1" BorderBrush="{DynamicResource Text.Primary}" BorderThickness="{DynamicResource Focus.RingThickness}"
                                    CornerRadius="{DynamicResource Radius.Sm}" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                                <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="0" />
                                <Setter TargetName="Indicator" Property="themes:FluidMotion.FadeTo" Value="1" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                <Setter TargetName="HoverLayer" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryUx.NavGlyph" TargetType="themes:SymbolIcon" BasedOn="{StaticResource Icon.Symbol}">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LibraryUx.NavCount" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LibraryUx.SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Tree rows read like navigation items: hover wash, subtle selection with the accent pill. -->
        <Style x:Key="LibraryUx.TreeExpander" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <!-- The chevron turns over Motion.Normal (FluidMotion.RotateTo) as the row expands. -->
                        <Border Background="Transparent">
                            <themes:SymbolIcon Size="16" x:Name="Chevron" Style="{StaticResource StatePart.Normal}"
                                               Data="{StaticResource LibraryUx.Icon.Chevron}" Stroke="{DynamicResource Text.Secondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="themes:FluidMotion.RotateTo" Value="90" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryUx.TreeItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="ContextMenu" Value="{StaticResource Gallery.FolderContextMenu}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Grid x:Name="Row" MinHeight="34" Background="Transparent">
                                <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Md}" />
                                <Border x:Name="HoverLayer" Style="{StaticResource LibraryUx.HoverWash}" BorderThickness="1" />
                                <Border x:Name="SelectedLayer" Style="{StaticResource LibraryUx.SelectedWash}" BorderBrush="{DynamicResource Accent.Default}" BorderThickness="2" />
                                <Border x:Name="Indicator" Style="{StaticResource StatePart.Normal}" Width="3" Height="16" Margin="1,0,0,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{DynamicResource Text.Primary}" CornerRadius="{DynamicResource Radius.Pill}"
                                        Opacity="0" IsHitTestVisible="False" />
                                <DockPanel Margin="4,0,10,0">
                                    <ToggleButton x:Name="Expander" DockPanel.Dock="Left" Style="{StaticResource LibraryUx.TreeExpander}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                    <ContentPresenter x:Name="PART_Header" ContentSource="Header" Margin="2,0,0,0"
                                                      VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                                </DockPanel>
                                <Border x:Name="FocusRing" Margin="1" BorderBrush="{DynamicResource Text.Primary}" BorderThickness="{DynamicResource Focus.RingThickness}"
                                        CornerRadius="{DynamicResource Radius.Sm}" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                            <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                                <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="0" />
                                <Setter TargetName="Indicator" Property="themes:FluidMotion.FadeTo" Value="1" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <!-- Drop feedback stays immediate, as File Explorer's does: it follows the pointer
                                 during a drag. -->
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.Selected}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Text.Primary}" />
                                <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SelectedLayer" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                <Setter TargetName="HoverLayer" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate x:Key="Gallery.FolderNodeTemplate" DataType="{x:Type gallery:GalleryFolderNode}"
                                  ItemsSource="{Binding Children}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <themes:SymbolIcon x:Name="FolderGlyph" StrokeThickness="0" Size="16" Data="{StaticResource LibraryUx.Icon.Folder}"
                      Fill="{DynamicResource Accent.Folder}" VerticalAlignment="Center" />
                <CheckBox Style="{StaticResource Gallery.SelectionCheckBox}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                          Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" Width="18" MinHeight="18"
                          IsHitTestVisible="False" Focusable="False" IsTabStop="False" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Caption}" Margin="8,0,8,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource LibraryUx.NavCount}" />
            </Grid>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="FolderGlyph" Property="Visibility" Value="Hidden" /></DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <DataTemplate x:Key="LibraryUx.DateItemTemplate" DataType="{x:Type gallery:GalleryFolderNode}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <themes:SymbolIcon x:Name="DateGlyph" Size="20" Data="{StaticResource LibraryUx.Icon.Calendar}" Style="{StaticResource LibraryUx.NavGlyph}" />
                <CheckBox Style="{StaticResource Gallery.SelectionCheckBox}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                          Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" Width="18" MinHeight="18"
                          IsHitTestVisible="False" Focusable="False" IsTabStop="False" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,8,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource LibraryUx.NavCount}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="DateGlyph" Property="Visibility" Value="Hidden" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="LibraryUx.DateItem" TargetType="ListBoxItem">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Caption}" />
            <Setter Property="ContextMenu" Value="{StaticResource Gallery.FolderContextMenu}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- The same layers as a folder row. -->
                        <Grid MinHeight="34" Background="Transparent">
                            <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Md}" />
                            <Border x:Name="HoverLayer" Style="{StaticResource LibraryUx.HoverWash}" BorderThickness="1" />
                            <Border x:Name="SelectedLayer" Style="{StaticResource LibraryUx.SelectedWash}" BorderBrush="{DynamicResource Accent.Default}" BorderThickness="2" />
                            <Border x:Name="Indicator" Style="{StaticResource StatePart.Normal}" Width="3" Height="16" Margin="1,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource Text.Primary}" CornerRadius="{DynamicResource Radius.Pill}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter Margin="12,0,10,0" VerticalAlignment="Center" />
                            <Border x:Name="FocusRing" Margin="1" BorderBrush="{DynamicResource Text.Primary}" BorderThickness="{DynamicResource Focus.RingThickness}"
                                    CornerRadius="{DynamicResource Radius.Sm}" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                                <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="0" />
                                <Setter TargetName="Indicator" Property="themes:FluidMotion.FadeTo" Value="1" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.Selected}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Text.Primary}" />
                                <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SelectedLayer" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                <Setter TargetName="HoverLayer" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Collapsible pane section ("날짜"): an Expander keeps the expand/collapse automation pattern. -->
        <Style x:Key="LibraryUx.Section" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top" MinHeight="32" Cursor="Hand"
                                          FocusVisualStyle="{x:Null}"
                                          AutomationProperties.Name="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <!-- The hover wash fades; the chevron turns over Motion.Normal as the section opens. -->
                                        <Grid Background="Transparent">
                                            <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent"
                                                    BorderThickness="1" CornerRadius="{DynamicResource Radius.Md}" />
                                            <Border x:Name="HoverLayer" Style="{StaticResource LibraryUx.HoverWash}" BorderThickness="1" />
                                            <DockPanel Margin="12,0,8,0">
                                                <themes:SymbolIcon Size="16" x:Name="Chevron" Style="{StaticResource StatePart.Normal}" DockPanel.Dock="Right"
                                                                   Data="{StaticResource LibraryUx.Icon.Chevron}" Stroke="{DynamicResource Text.Secondary}"
                                                                   VerticalAlignment="Center" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </DockPanel>
                                            <Border x:Name="FocusRing" Margin="1" BorderBrush="{DynamicResource Text.Primary}"
                                                    BorderThickness="{DynamicResource Focus.RingThickness}" CornerRadius="{DynamicResource Radius.Sm}" Opacity="0"
                                                    IsHitTestVisible="False" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="themes:FluidMotion.RotateTo" Value="90" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                                <Setter TargetName="HoverLayer" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                           Style="{StaticResource LibraryUx.SectionLabel}" />
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================= -->
        <!-- Command bar and location header                               -->
        <!-- ============================================================= -->
        <Style x:Key="LibraryUx.CommandButton" TargetType="Button" BasedOn="{StaticResource Button.Command}" />
        <Style x:Key="LibraryUx.CommandGhost" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="Padding" Value="{DynamicResource CommandButton.Padding.Standard}" />
            <Setter Property="FontSize" Value="{DynamicResource CommandButton.FontSize}" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LibraryUx.CommandIcon" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
            <Setter Property="Padding" Value="{DynamicResource CommandButton.Padding.Standard}" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LibraryUx.CommandGlyph" TargetType="themes:SymbolIcon" BasedOn="{StaticResource Icon.Symbol}">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LibraryUx.CommandSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="4,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Border.Subtle}" />
        </Style>

        <!-- One toggle chip beside the folder name: checked = new captures join this folder. -->
        <!-- "Save new captures here" is a setting of the open folder, not part of its name: a
             quiet switch at the far end of the header, the way Windows shows an on/off option. -->
        <Style x:Key="LibraryUx.SaveHereSwitch" TargetType="CheckBox">
            <Setter Property="themes:FluidMotion.SwitchMotion" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <StackPanel Orientation="Horizontal" Margin="8,0,6,0" VerticalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center" Margin="0,0,10,0" />
                                <!-- FluidMotion.SwitchMotion slides the thumb and fades the fill. Hover hands the
                                     track edge and the off thumb over to Text.Primary copies that fade in while
                                     the rest parts fade out; the label's colour changes with the pointer. -->
                                <Grid x:Name="PART_SwitchTrack" Width="36" Height="20" VerticalAlignment="Center">
                                    <Border x:Name="Track" CornerRadius="10" BorderThickness="1" Style="{StaticResource LibraryUx.RestEdge}"
                                            BorderBrush="{DynamicResource Text.Secondary}" Background="Transparent" />
                                    <Border x:Name="TrackHover" CornerRadius="10" BorderThickness="1" Opacity="0" IsHitTestVisible="False"
                                            BorderBrush="{DynamicResource Text.Primary}" />
                                    <Border x:Name="PART_SwitchFill" CornerRadius="10" Opacity="0"
                                            Background="{DynamicResource Text.Primary}" />
                                    <Grid x:Name="PART_SwitchThumb" Width="12" Height="12" Margin="4,0,0,0"
                                          HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Ellipse x:Name="ThumbOff" Style="{StaticResource LibraryUx.RestEdge}" Fill="{DynamicResource Text.Secondary}" />
                                        <Ellipse x:Name="ThumbHover" Opacity="0" IsHitTestVisible="False" Fill="{DynamicResource Text.Primary}" />
                                        <Ellipse x:Name="PART_SwitchThumbOn" Fill="{DynamicResource Surface.Raised}" Opacity="0" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                            <Border x:Name="FocusRing" BorderBrush="{DynamicResource Text.Primary}" BorderThickness="{DynamicResource Focus.RingThickness}"
                                    CornerRadius="{DynamicResource Radius.Md}" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                <Setter TargetName="Track" Property="themes:FluidMotion.FadeTo" Value="0" />
                                <Setter TargetName="TrackHover" Property="themes:FluidMotion.FadeTo" Value="1" />
                                <Setter TargetName="ThumbOff" Property="themes:FluidMotion.FadeTo" Value="0" />
                                <Setter TargetName="ThumbHover" Property="themes:FluidMotion.FadeTo" Value="1" />
                            </Trigger>
                            <!-- On, the track keeps its neutral edge whether or not the pointer is over it. -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Text.Primary}" />
                                <Setter TargetName="Track" Property="themes:FluidMotion.FadeTo" Value="1" />
                                <Setter TargetName="TrackHover" Property="themes:FluidMotion.FadeTo" Value="0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LibraryUx.BreadcrumbTemplate" DataType="{x:Type gallery:GalleryBreadcrumb}">
            <StackPanel Orientation="Horizontal">
                <Button Content="{Binding Name}" Style="{StaticResource Button.GhostCompact}" Click="OnBreadcrumbClick"
                        FontSize="{StaticResource FontSize.Body}" FontWeight="Normal" Padding="6,4" MaxWidth="220"
                        Foreground="{DynamicResource Text.Secondary}" AutomationProperties.Name="{Binding Name}"
                        Visibility="{Binding IsLink, Converter={StaticResource BoolToVisibility}}" />
                <themes:SymbolIcon Size="16" Data="{StaticResource LibraryUx.Icon.Chevron}" Margin="2,0"
                      Stroke="{DynamicResource Text.Muted}" VerticalAlignment="Center"
                      Visibility="{Binding IsLink, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" Margin="6,0,0,0"
                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                    <themes:SymbolIcon StrokeThickness="0" Size="16" Data="{StaticResource LibraryUx.Icon.Folder}"
                          Fill="{DynamicResource Accent.Folder}" VerticalAlignment="Center"
                          Visibility="{Binding Scope.FolderId, Converter={StaticResource LibraryUx.HasValue}}" />
                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" MaxWidth="280" TextTrimming="CharacterEllipsis"
                               FontSize="{StaticResource FontSize.Subtitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
      </ResourceDictionary>
    </Window.Resources>

    <!-- Global capture and search stay in place while the content command row changes selection state. -->
    <Grid x:Name="LibraryRoot" Margin="12,4,12,6" Background="Transparent" AllowDrop="True"
          DragEnter="OnLibraryDragOver" DragOver="OnLibraryDragOver" DragLeave="OnLibraryDragLeave" Drop="OnLibraryDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="LibraryGlobalCommandSurface" Grid.Row="0" Padding="8,0" Margin="0,0,0,8"
                Background="{DynamicResource Surface.Raised}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
            <Grid x:Name="LibraryCommandBar" Height="48"
                  AutomationProperties.Name="{loc:Text LibraryUx_CommandBarName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Keep labelled capture commands available in every selection state. -->
                    <StackPanel x:Name="CaptureCommands" Orientation="Horizontal">
                        <Button x:Name="CaptureRegionButton" Style="{StaticResource Button.Primary}" Margin="3,0,0,0"
                                VerticalAlignment="Center"
                                themes:ButtonSizing.SplitPart="Main"
                                AutomationProperties.Name="{loc:Text Text_2C20ADDA2018}"
                                Click="OnCaptureRegionClick">
                            <StackPanel Orientation="Horizontal">
                                <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Capture}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Fill="Transparent" />
                                <TextBlock Text="{loc:Text Text_2C20ADDA2018}" Margin="{DynamicResource CommandButton.IconLabelGap}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CaptureOptionsButton" Style="{StaticResource Button.Primary}" Margin="0,0,3,0"
                                MinWidth="28" Padding="5,0" VerticalAlignment="Center"
                                themes:ButtonSizing.SplitPart="Options"
                                ToolTip="{loc:Text CaptureEntry.MoreOptions}"
                                AutomationProperties.Name="{loc:Text CaptureEntry.MoreOptions}"
                                Click="OnNewCaptureClick">
                            <themes:SymbolIcon Size="16" Data="{StaticResource Icon.ChevronDown}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Fill="Transparent" />
                        </Button>
                        <Button x:Name="RecordRegionButton" Style="{StaticResource LibraryUx.CommandButton}"
                                AutomationProperties.Name="{loc:Text Text_4F5AF20FAA6E}"
                                Click="OnRecordRegionClick">
                            <StackPanel Orientation="Horizontal">
                                <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Record}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{loc:Text Text_4F5AF20FAA6E}" Margin="{DynamicResource CommandButton.IconLabelGap}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </StackPanel>

                <!-- An input boundary, not a decorative card line: it takes the control outline, hands it
                     over to the stronger outline on hover (the two fade, like the shared TextBox), and takes
                     the focus colour at once while the search box inside has keyboard focus. -->
                <Grid x:Name="SearchField" Grid.Column="1" Margin="6,0,12,0"
                      MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <!-- Transparent hit surface; each fading chrome copy draws its fill and edge together. -->
                    <Border x:Name="SearchWell" Style="{StaticResource Card.Sunken}" BorderBrush="Transparent" Background="Transparent" />
                    <Border x:Name="SearchEdge" BorderThickness="1" CornerRadius="{DynamicResource Radius.Lg}" SnapsToDevicePixels="True">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource LibraryUx.RestEdge}">
                                <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}" />
                                <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=SearchField}" Value="True">
                                        <Setter Property="themes:FluidMotion.FadeTo" Value="0" />
                                    </DataTrigger>
                                    <!-- Focus keeps this edge whole, so the outline never dims while the pointer crosses it. -->
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchField}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                        <Setter Property="themes:FluidMotion.FadeTo" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                <Border x:Name="SearchHoverLayer" BorderThickness="1" CornerRadius="{DynamicResource Radius.Lg}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StateLayer}">
                            <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
                            <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=SearchField}" Value="True">
                                    <Setter Property="themes:FluidMotion.FadeTo" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchField}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                    <Setter Property="themes:FluidMotion.FadeTo" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Grid Margin="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <themes:SymbolIcon Size="16" Grid.Column="0" Data="{StaticResource Icon.Search}"
                          Style="{StaticResource Icon.Symbol.Muted}"
                          Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBox x:Name="SearchBox" Grid.Column="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="4,4" MinHeight="32"
                             ToolTip="{Binding SearchToolTip}"
                             AutomationProperties.Name="{loc:Text Text_4B8D541EBE6D}"
                             TextChanged="OnSearchTextChanged" />
                    <gallery:LibrarySearchPlaceholder x:Name="SearchPlaceholderText" Grid.Column="1" IsHitTestVisible="False"
                               FullText="{Binding SearchPlaceholder}" CompactText="{Binding CompactSearchPlaceholder}"
                               Foreground="{DynamicResource Text.Muted}"
                               Margin="6,0"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding FittedText, RelativeSource={RelativeSource Self}}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </gallery:LibrarySearchPlaceholder>
                </Grid>
            </Grid>


        </Grid>
        </Border>

        <StackPanel Grid.Row="1">
            <DockPanel Margin="6,0,6,8" LastChildFill="True"
                       Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVisibility}}">
                <Button DockPanel.Dock="Right" Content="{loc:Text Library.Search.ClearAll}"
                        Style="{StaticResource Button.Secondary}" Background="Transparent" BorderThickness="0"
                        VerticalAlignment="Top" Margin="8,0,0,0" Click="OnClearSearchConditionsClick" />
                <ItemsControl ItemsSource="{Binding SearchConditions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Button.Secondary}" Margin="0,0,6,4"
                                    MaxWidth="360" ToolTip="{Binding RemoveToolTip}"
                                    AutomationProperties.Name="{Binding RemoveToolTip}" Click="OnRemoveSearchConditionClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" MaxWidth="300" TextTrimming="CharacterEllipsis" />
                                    <themes:SymbolIcon Size="12" Data="{StaticResource Icon.Close}" Margin="6,0,0,0"
                                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

        <!-- OCR full-text search coverage banner (Row 1). Shown only when part of the
             library is not yet searchable by the text inside the images, or when no OCR
             language pack is installed. Collapsed by default; the code-behind sets its
             state when the gallery opens and after an indexing pass. -->
        <Border x:Name="OcrCoverageBanner" Grid.Row="1"
                Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="OcrCoverageHeadline"
                               Foreground="{DynamicResource Text.Primary}"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource FontSize.Body}" />
                    <TextBlock x:Name="OcrCoverageDetail"
                               Foreground="{DynamicResource Text.Secondary}"
                               FontSize="{StaticResource FontSize.Caption}"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap" MaxWidth="760"
                               HorizontalAlignment="Left" />
                </StackPanel>
                <!-- Outlined: the command bar already carries this screen's one filled button. -->
                <Button x:Name="OcrIndexButton" Grid.Column="1"
                        Style="{StaticResource Button.Secondary}"
                        Content="{loc:Text Text_C5364F392040}" MinHeight="34"
                        VerticalAlignment="Center" Margin="14,0,0,0"
                        ToolTip="{loc:Text Text_C8FFDDF126A8}"
                        AutomationProperties.Name="{loc:Text Text_4D5F7094119C}"
                        Click="OnOcrIndexClick" />
            </Grid>
        </Border>
        </StackPanel>

        <Grid Grid.Row="2" x:Name="GalleryWorkspace">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="184" />
                <ColumnDefinition Width="*" />
                <!-- The details pane (240 with its gap) or, while it is hidden, its 56-DIP rail. -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="LibraryNavigationSurface" Grid.Column="0" IsHitTestVisible="False"
                    Background="{DynamicResource Surface.Base}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,1,0" />
            <Grid x:Name="GalleryFilterRail" Margin="0,8,12,0" AutomationProperties.Name="{loc:Text LibraryUx_NavName}"
                  SizeChanged="OnTagNavigationSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="96" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <RadioButton x:Name="AllLibraryFilter" Tag="All"
                                 IsChecked="{Binding IsAllItemsView, Mode=OneWay}" Checked="OnLibraryFilterChanged"
                                 ToolTip="{loc:Text LibraryUx_NavAllHint}" AutomationProperties.Name="{Binding AllItemsAccessibleName}">
                        <!-- Captures dropped here leave their folder; the item lights up like a folder target. -->
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource LibraryUx.NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAllItemsDropTarget}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Surface.Selected}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Text.Primary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <themes:SymbolIcon Size="16" Data="{StaticResource LibraryUx.Icon.AllItems}" Style="{StaticResource LibraryUx.NavGlyph}" />
                            <TextBlock Grid.Column="1" Text="{loc:Text LibraryUx_NavAll}" Margin="10,0,8,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding AllItemsCount}" Style="{StaticResource LibraryUx.NavCount}" />
                        </Grid>
                    </RadioButton>
                    <RadioButton Style="{StaticResource LibraryUx.NavItem}" Tag="Images"
                                 IsChecked="{Binding IsImagesView, Mode=OneWay}" Checked="OnLibraryFilterChanged"
                                 AutomationProperties.Name="{Binding ImagesAccessibleName}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Image}" Style="{StaticResource LibraryUx.NavGlyph}" />
                            <TextBlock Grid.Column="1" Text="{loc:Text LibraryUx_NavImages}" Margin="10,0,8,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding ImageCount}" Style="{StaticResource LibraryUx.NavCount}" />
                        </Grid>
                    </RadioButton>
                    <RadioButton Style="{StaticResource LibraryUx.NavItem}" Tag="Videos"
                                 IsChecked="{Binding IsVideosView, Mode=OneWay}" Checked="OnLibraryFilterChanged"
                                 AutomationProperties.Name="{Binding VideosAccessibleName}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <themes:SymbolIcon Size="16" Data="{StaticResource LibraryUx.Icon.Video}" Style="{StaticResource LibraryUx.NavGlyph}" />
                            <TextBlock Grid.Column="1" Text="{loc:Text LibraryUx_NavVideos}" Margin="10,0,8,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding VideoCount}" Style="{StaticResource LibraryUx.NavCount}" />
                        </Grid>
                    </RadioButton>
                    <RadioButton Style="{StaticResource LibraryUx.NavItem}" Tag="Pinned"
                                 IsChecked="{Binding IsKeptView, Mode=OneWay}" Checked="OnLibraryFilterChanged"
                                 ToolTip="{loc:Text LibraryUx_NavKeptHint}" AutomationProperties.Name="{Binding KeptAccessibleName}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <themes:SymbolIcon Size="16" Data="{StaticResource LibraryUx.Icon.Kept}" Style="{StaticResource LibraryUx.NavGlyph}" />
                            <TextBlock Grid.Column="1" Text="{loc:Text LibraryUx_NavKept}" Margin="10,0,8,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding KeptCount}" Style="{StaticResource LibraryUx.NavCount}" />
                        </Grid>
                    </RadioButton>
                </StackPanel>

                <Expander Grid.Row="2" Style="{StaticResource LibraryUx.Section}"
                          Header="{loc:Text Library.SavedSearch.Title}" IsExpanded="True" Margin="0,0,0,4">
                    <DockPanel>
                        <!-- Saving needs a query, so the command appears only while one is typed; flat like the folder [+]. -->
                        <Button x:Name="SaveSearchButton" DockPanel.Dock="Top" Style="{StaticResource Button.GhostCompact}"
                                HorizontalAlignment="Left" Margin="4,0,0,2" Click="OnSaveSearchClick"
                                AutomationProperties.Name="{loc:Text Library.SavedSearch.Save}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <themes:SymbolIcon Size="16" Data="{StaticResource LibraryUx.Icon.Add}" Style="{StaticResource LibraryUx.CommandGlyph}" />
                                <TextBlock Text="{loc:Text Library.SavedSearch.Save}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="SavedSearchEmptyHint" DockPanel.Dock="Top" Text="{loc:Text Library453.SavedSearchHint}"
                                   Margin="12,2,10,4" TextWrapping="Wrap" FontSize="{StaticResource FontSize.Caption}"
                                   Foreground="{DynamicResource Text.Secondary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0" />
                                                <Condition Binding="{Binding HasItems, ElementName=SavedSearchList}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer MaxHeight="144" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="SavedSearchList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Flat rows like the tag and folder lists above and below. -->
                                        <Button Style="{StaticResource Button.GhostCompact}" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left" MinHeight="36" Padding="12,0,10,0" Margin="0,1"
                                                Click="OnApplySavedSearchClick" ToolTip="{Binding Query}" AutomationProperties.Name="{Binding Name}">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{loc:Text Library.SavedSearch.Rename}" Click="OnRenameSavedSearchClick" />
                                                    <MenuItem Header="{loc:Text Library.SavedSearch.Delete}" Click="OnDeleteSavedSearchClick" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Expander>

                <Expander x:Name="TagSection" Grid.Row="1" Style="{StaticResource LibraryUx.Section}"
                          Header="{loc:Text Library.Tags.Title}" IsExpanded="True" Margin="0,0,0,4">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="{loc:Text Library.Tags.More}" Style="{StaticResource LibraryUx.CommandButton}" HorizontalAlignment="Left"
                                Click="OnMoreTagsClick" Visibility="{Binding HasMoreTags, Converter={StaticResource BoolToVisibility}}" />
                        <ScrollViewer MaxHeight="304" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding VisibleTags}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource LibraryUx.NavItem}"
                                                     IsChecked="{Binding IsSelected, Mode=OneWay}" Click="OnTagClick"
                                                     ToolTip="{Binding Name}" AutomationProperties.Name="{Binding AccessibleName}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Margin="0,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Count}" Style="{StaticResource LibraryUx.NavCount}" />
                                            </Grid>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Expander>

                <!-- "폴더" section head: the retention rule is a tooltip, [+] creates a folder here. -->
                <Grid Grid.Row="3" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" Background="Transparent"
                                ToolTip="{Binding FolderSectionToolTip}">
                        <TextBlock Text="{loc:Text Folder410.Title}" Style="{StaticResource LibraryUx.SectionLabel}" />
                        <themes:SymbolIcon Size="16" Data="{StaticResource LibraryUx.Icon.Info}" Style="{StaticResource Icon.Symbol.Muted}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="NewFolderPaneButton" Grid.Column="1" Style="{StaticResource Button.GhostCompact}"
                            ToolTip="{loc:Text LibraryUx_NewFolderHint}" AutomationProperties.Name="{loc:Text Folder410.NewFolder}"
                            Click="OnNewFolderClick">
                        <themes:SymbolIcon Size="16" Data="{StaticResource LibraryUx.Icon.Add}" Style="{StaticResource LibraryUx.CommandGlyph}" />
                    </Button>
                </Grid>

                <TreeView x:Name="FolderTree" Grid.Row="4" ItemsSource="{Binding FolderRoots}" Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource Text.Primary}"
                          AutomationProperties.Name="{loc:Text Folder410.Title}"
                          AutomationProperties.HelpText="{loc:Text LibraryUx_FoldersHint}"
                          ItemTemplate="{StaticResource Gallery.FolderNodeTemplate}"
                          ItemContainerStyle="{StaticResource LibraryUx.TreeItem}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                          SelectedItemChanged="OnFolderSelected" PreviewKeyDown="OnFolderTreeKeyDown"
                          PreviewMouseLeftButtonDown="OnFolderPointerDown" />

                <Expander x:Name="DateSection" Grid.Row="5" Style="{StaticResource LibraryUx.Section}" Margin="0,6,0,0"
                          Header="{loc:Text LibraryUx_DatesHeader}" IsExpanded="False">
                    <ListBox x:Name="DateList" ItemsSource="{Binding FolderNodes}" MaxHeight="220"
                             ItemTemplate="{StaticResource LibraryUx.DateItemTemplate}"
                             ItemContainerStyle="{StaticResource LibraryUx.DateItem}"
                             AutomationProperties.Name="{loc:Text LibraryUx_DatesHeader}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="False"
                             SelectionChanged="OnDateSelected" PreviewKeyDown="OnFolderTreeKeyDown" />
                </Expander>
            </Grid>


            <Grid x:Name="LibraryItemsSurface" Grid.Column="1" Margin="8,0,8,0" Background="{DynamicResource Surface.Sunken}"
                  ContextMenu="{StaticResource Gallery.EmptyContextMenu}"
                  PreviewKeyDown="OnLibraryItemsKeyDown" PreviewMouseRightButtonDown="OnLibraryItemsRightButtonDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- A stable one-row content toolbar keeps list geometry unchanged as selection changes: at narrow widths
                     the command labels collapse to icons (then the count and sort narrow) instead of wrapping to a second row,
                     and its overflow menu retains every secondary command. -->
                <Grid x:Name="LibraryContentCommandBar" Margin="0,0,0,8"
                      Background="{DynamicResource Surface.Raised}"
                      AutomationProperties.Name="{loc:Text LibraryUx_CommandBarName}">
                    <Grid.RowDefinitions><RowDefinition Height="44" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="SelectionCommands" Orientation="Horizontal" VerticalAlignment="Center" MinHeight="44"
                                AutomationProperties.Name="{loc:Text LibraryUx_SelectionBarName}">
                        <Button x:Name="ClearSelectionButton" Style="{StaticResource LibraryUx.CommandIcon}"
                                IsEnabled="{Binding HasSelection}" ToolTip="{loc:Text LibraryUx_ClearSelectionHint}"
                                AutomationProperties.Name="{loc:Text LibraryUx_ClearSelection}" Click="OnClearSelectionClick">
                            <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Close}" Style="{StaticResource LibraryUx.CommandGlyph}" />
                        </Button>
                        <TextBlock x:Name="SelectionCountLabel" Text="{Binding SelectionText}" Width="96" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="2,0,8,0" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                        <!-- Open actions precede copy and organizing; labels collapse when space is limited. -->
                        <Button x:Name="EditSelectedButton" Style="{StaticResource LibraryUx.CommandButton}"
                                IsEnabled="{Binding HasSingleSelection}" CommandParameter="{Binding SingleSelectedTile}" Click="OnEditClick"
                                ToolTip="{loc:Text LibraryUx_EditHint}" AutomationProperties.Name="{loc:Text Text_1003CFC78E66}">
                            <StackPanel Orientation="Horizontal">
                                <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Edit}" Style="{StaticResource LibraryUx.CommandGlyph}" Fill="Transparent" />
                                <TextBlock x:Name="EditSelectedLabel" Text="{loc:Text Text_1003CFC78E66}" Margin="{DynamicResource CommandButton.IconLabelGap}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PreviewSelectedButton" Style="{StaticResource LibraryUx.CommandButton}"
                                IsEnabled="{Binding HasSingleSelection}" Click="OnPreviewSelectedClick" ToolTip="{loc:Text LibraryUx_PreviewHint}"
                                AutomationProperties.Name="{loc:Text LibraryUx_Preview}">
                            <StackPanel Orientation="Horizontal">
                                <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Image}" Style="{StaticResource LibraryUx.CommandGlyph}" Fill="Transparent" />
                                <TextBlock x:Name="PreviewSelectedLabel" Text="{loc:Text LibraryUx_Preview}" Margin="{DynamicResource CommandButton.IconLabelGap}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="FloatSelectedButton" Style="{StaticResource LibraryUx.CommandButton}"
                                IsEnabled="{Binding CanReduceSelected}" CommandParameter="{Binding SingleSelectedTile}" Click="OnFloatClick"
                                ToolTip="{loc:Text LibraryUx_PinHint}" AutomationProperties.Name="{loc:Text Gallery.Float}">
                            <StackPanel Orientation="Horizontal">
                                <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Pin}" Style="{StaticResource LibraryUx.CommandGlyph}" Fill="Transparent" />
                                <TextBlock x:Name="FloatSelectedLabel" Text="{loc:Text QuickAccess.Pin}" Margin="{DynamicResource CommandButton.IconLabelGap}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CopySelectedButton" Style="{StaticResource LibraryUx.CommandButton}"
                                IsEnabled="{Binding CanReduceSelected}" CommandParameter="{Binding SingleSelectedTile}" Click="OnCopyClick"
                                ToolTip="{loc:Text Text_59D43391538F}" AutomationProperties.Name="{loc:Text Text_42A667BC71B0}">
                            <StackPanel Orientation="Horizontal">
                                <Grid VerticalAlignment="Center">
                                    <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Copy}" Style="{StaticResource LibraryUx.CommandGlyph}" Fill="Transparent"
                                                       gallery:GalleryCopyFeedback.Part="Glyph" themes:FluidMotion.FadeTo="1" />
                                    <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Check}" Style="{StaticResource LibraryUx.CommandGlyph}" Fill="Transparent"
                                                       Opacity="0" gallery:GalleryCopyFeedback.Part="Check" />
                                </Grid>
                                <TextBlock x:Name="CopySelectedLabel" Text="{loc:Text QuickAccess.Copy}" Margin="{DynamicResource CommandButton.IconLabelGap}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CreatePdfSelectedButton" Style="{StaticResource LibraryUx.CommandButton}"
                                IsEnabled="{Binding CanCreatePdfSelected}" Click="OnContactSheetClick"
                                ToolTip="{loc:Text ContactSheet.Action}" AutomationProperties.Name="{loc:Text ContactSheet.Action}">
                            <StackPanel Orientation="Horizontal">
                                <themes:SymbolIcon Size="16" Data="{StaticResource LibraryUx.Icon.Pdf}" Style="{StaticResource LibraryUx.CommandGlyph}" Fill="Transparent" />
                                <TextBlock x:Name="CreatePdfSelectedLabel" Text="{loc:Text ContactSheet.Action}" Margin="{DynamicResource CommandButton.IconLabelGap}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="KeepSelectedButton" Style="{StaticResource LibraryUx.CommandButton}"
                                IsEnabled="{Binding HasSelection}" Click="OnKeepSelectedClick" ToolTip="{loc:Text LibraryUx_KeepHint}"
                                AutomationProperties.Name="{loc:Text LibraryUx_Keep}">
                            <StackPanel Orientation="Horizontal">
                                <themes:SymbolIcon Size="16" Data="{StaticResource LibraryUx.Icon.Kept}" Style="{StaticResource LibraryUx.CommandGlyph}" Fill="Transparent" />
                                <TextBlock x:Name="KeepSelectedLabel" Text="{loc:Text LibraryUx_Keep}" Margin="{DynamicResource CommandButton.IconLabelGap}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="SortCommands" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="SortBox" Width="112" Margin="8,0,4,0" SelectedIndex="{Binding SortIndex, Mode=TwoWay}"
                              AutomationProperties.Name="{loc:Text Folder410.Sort}">
                        <ComboBoxItem Content="{loc:Text Folder410.Newest}" /><ComboBoxItem Content="{loc:Text Folder410.Oldest}" /><ComboBoxItem Content="{loc:Text Folder410.ByName}" />
                    </ComboBox>
                    <Button x:Name="MoreCommandsButton" Style="{StaticResource LibraryUx.CommandIcon}"
                            ToolTip="{loc:Text Text_5E8959D18390}" AutomationProperties.Name="{loc:Text Text_5E8959D18390}"
                            Click="OnMoreCommandsClick">
                        <themes:SymbolIcon Size="16" Data="{StaticResource Icon.More}" Style="{StaticResource LibraryUx.CommandGlyph}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <!-- Open actions, export, organize and delete precede library-wide commands. -->
                                <MenuItem x:Name="FloatSelectedMenu" Header="{loc:Text Gallery.Float}" InputGestureText="P"
                                          IsEnabled="{Binding CanReduceSelected}" CommandParameter="{Binding SingleSelectedTile}"
                                          AutomationProperties.Name="{loc:Text Gallery.Float}" Click="OnFloatClick" />
                                <MenuItem x:Name="CompareSelectedMenu" Header="{loc:Text Gallery.Compare}" IsEnabled="{Binding CanCompareSelected}" Command="{x:Static gallery:GalleryWindow.CompareCommand}"
                                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem x:Name="ReduceSelectedMenu" Header="{loc:Text LibrarySelection_Reduce}" Click="OnReducedExportClick"
                                          CommandParameter="{Binding SingleSelectedTile}"
                                          Visibility="{Binding CanReduceSelected, Converter={StaticResource BoolToVisibility}}" />
                                <MenuItem x:Name="GifSelectedMenu" Header="{loc:Text LibrarySelection_Gif}" Click="OnGifMenuClick"
                                          CommandParameter="{Binding SingleSelectedTile}"
                                          Visibility="{Binding CanGifSelected, Converter={StaticResource BoolToVisibility}}" />
                                <MenuItem x:Name="ArchiveOverflowMenu" Header="{loc:Text Library.Archive.Action}" Click="OnExportArchiveClick" />
                                <MenuItem x:Name="ContactSheetMenu" Header="{loc:Text ContactSheet.Action}" Click="OnContactSheetClick"
                                          IsEnabled="{Binding CanCreatePdfSelected}" AutomationProperties.Name="{loc:Text ContactSheet.Action}"
                                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />
                                <Separator />
                                <MenuItem x:Name="MoveOverflowMenu" Header="{loc:Text Folder410.MoveCaptures}" Click="OnMoveCapturesClick"
                                          InputGestureText="M" />
                                <MenuItem x:Name="BatchTagsMenu" Header="{loc:Text Library.Tags.Edit}" Click="OnBatchTagsClick"
                                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />
                                <Separator />
                                <MenuItem x:Name="DeleteSelectedMenu" Header="{loc:Text LibrarySelection_Delete}" IsEnabled="{Binding HasSelection}" InputGestureText="Del" Click="OnDeleteSelectedClick" />
                                <Separator />
                                <MenuItem x:Name="NewFolderOverflowMenu" Header="{loc:Text Folder410.NewFolder}"
                                          InputGestureText="Ctrl+Shift+N" Click="OnNewFolderClick" />
                                <MenuItem x:Name="ImportMenu" Header="{loc:Text Library.Import.Command}" Click="OnImportClick" />
                                <MenuItem x:Name="RestoreDeletedMenu" Header="{loc:Text LibraryRecovery_Recent}" />
                                <MenuItem x:Name="OpenLibraryFolderMenu" Header="{loc:Text LibraryFolder_OpenLibrary}" Click="OnOpenLibraryFolderClick" />
                                <Separator />
                                <MenuItem Header="{loc:Text LibrarySelection_ClearHint}" Click="OnClearLibraryClick"
                                          Foreground="{DynamicResource Text.Primary}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    </StackPanel>
                </Grid>

                <!-- Location header inside a folder or date: the way back and the name on the left,
                     the folder's "save new captures here" switch at the right end. -->
                <Grid x:Name="LocationHeader" Grid.Row="1" Height="44" Margin="2,0,0,4" ClipToBounds="True"
                      Visibility="{Binding ShowLocationHeader, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ItemsControl x:Name="LocationBreadcrumb" ItemsSource="{Binding Breadcrumb}" Focusable="False"
                                      ItemTemplate="{StaticResource LibraryUx.BreadcrumbTemplate}"
                                      AutomationProperties.Name="{loc:Text LibraryUx_BreadcrumbName}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <CheckBox x:Name="CurrentFolderCaptureCheck" Grid.Column="1" Style="{StaticResource LibraryUx.SaveHereSwitch}" Margin="12,0,4,0"
                              Content="{loc:Text LibraryUx_SaveHere}" ToolTip="{Binding SaveHereToolTip}"
                              IsEnabled="{Binding CanChangeNewCaptureFolder}"
                              IsChecked="{Binding SavesNewCapturesHere, Mode=OneWay}" Click="OnFolderCaptureTargetClick"
                              Visibility="{Binding ShowSaveHere, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <Border x:Name="ImportOverlay" Grid.Row="2" Panel.ZIndex="10" Visibility="Collapsed"
                        IsHitTestVisible="False" Background="{DynamicResource Surface.Raised}"
                        BorderBrush="{DynamicResource Text.Secondary}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Lg}" Padding="24">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                        <TextBlock x:Name="ImportOverlayTitle" Text="{loc:Text Library.Import.DropTitle}"
                                   Style="{DynamicResource Text.Title}" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Text="{loc:Text Library.Import.DropDetail}" Margin="0,8,0,0"
                                   Style="{DynamicResource Text.MutedBlock}" TextWrapping="Wrap" TextAlignment="Center" />
                        <ProgressBar x:Name="ImportProgress" Visibility="Collapsed" Height="6" Margin="0,16,0,0"
                                     Foreground="{DynamicResource Text.Primary}" Background="{DynamicResource Surface.Sunken}" />
                        <Button x:Name="ImportCancelButton" Content="{loc:Text Library.Action.Cancel}"
                                Visibility="Collapsed" Click="OnCancelImportClick" Margin="0,16,0,0"
                                Style="{StaticResource Button.Secondary}" />
                    </StackPanel>
                </Border>
                <ListBox x:Name="RowsList" Grid.Row="2"
                         Style="{StaticResource Gallery.RowsList}"
                         ItemsSource="{Binding Rows}" IsTabStop="True"
                         GotKeyboardFocus="OnRowsListGotKeyboardFocus"
                         PreviewKeyDown="OnRowsListPreviewKeyDown"
                         ContextMenuOpening="OnTileContextMenuOpening"
                         SizeChanged="OnRowsListSizeChanged" />

                <Border Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource Card}" Padding="42,30"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel MaxWidth="380">
                        <TextBlock Text="{Binding EmptyStateTitle}"
                                   Style="{DynamicResource Text.Title}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyStateLabel"
                                   Text="{Binding EmptyStateText}"
                                   Style="{DynamicResource Text.MutedBlock}"
                                   Margin="0,8,0,0"
                                   TextAlignment="Center"
                                   AutomationProperties.Name="{Binding EmptyStateText}" TextWrapping="Wrap" />
                        <!-- Outlined: the command bar's capture is this screen's filled button. -->
                        <Button Content="{loc:Text Text_2C20ADDA2018}" Style="{StaticResource Button.Secondary}" Click="OnCaptureRegionClick" Margin="0,16,0,0" Visibility="{Binding QueueIsEmpty, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{loc:Text Library.Search.ClearConditions}" Click="OnClearLibrarySearchClick" Margin="0,16,0,0"
                                Style="{StaticResource Button.Secondary}"
                                Visibility="{Binding CanResetEmptySearch, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- After the library content, so Tab follows the visual order: pane, content, details.
                 The selected capture's preview, title and main commands stay at the top; only the
                 information below them scrolls, and nothing inside it scrolls on its own. -->
            <Border x:Name="GalleryDetailsRail" Grid.Column="2" Width="48" Padding="7" Visibility="Collapsed"
                    Background="{DynamicResource Surface.Raised}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1,0,0,0"
                    AutomationProperties.Name="{loc:Text Workspace.Details}">
                <Button x:Name="ShowDetailsButton" Style="{StaticResource Button.Icon.Compact}" VerticalAlignment="Top"
                        ToolTip="{loc:Text LibraryUx_DetailsShow}" AutomationProperties.Name="{loc:Text LibraryUx_DetailsShow}"
                        Click="OnShowDetailsClick">
                    <themes:SymbolIcon Size="16" Data="{StaticResource LibraryUx.Icon.DetailsPane}" Style="{StaticResource LibraryUx.CommandGlyph}" />
                </Button>
            </Border>
            <Border x:Name="GalleryDetailsPanel" Grid.Column="2" Width="232" Padding="16"
                    Background="{DynamicResource Surface.Raised}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1,0,0,0"
                    AutomationProperties.Name="{loc:Text Workspace.Details}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Hiding the pane gives the library its width; the rail left behind brings it back. -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="GalleryDetailsHeading" Text="{loc:Text Workspace.Details}" Style="{DynamicResource Text.Section}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button x:Name="HideDetailsButton" Grid.Column="1" Style="{StaticResource Button.Icon.Compact}" Margin="8,-6,-6,-6"
                                ToolTip="{loc:Text LibraryUx_DetailsHide}" AutomationProperties.Name="{loc:Text LibraryUx_DetailsHide}"
                                Click="OnHideDetailsClick">
                            <themes:SymbolIcon Size="16" Data="{StaticResource LibraryUx.Icon.DetailsPane}" Style="{StaticResource LibraryUx.CommandGlyph}" />
                        </Button>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{loc:Text Workspace.SelectHint}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SingleSelectedTile}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid x:Name="GalleryDetailsContent" Grid.Row="1" DataContext="{Binding SingleSelectedTile}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <!-- The preview gives up height first in a short window; the commands never move. -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="72" MaxHeight="136" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource Surface.Sunken}" CornerRadius="{StaticResource Radius.Md}">
                            <Image x:Name="SelectedDetailThumbnail" Source="{Binding Thumbnail}" Stretch="Uniform"
                                   AutomationProperties.Name="{Binding AccessibleName}" />
                        </Border>
                        <TextBlock Grid.Row="1" AutomationProperties.AutomationId="LibraryDetailsTitle" Margin="0,12,0,0"
                                   FontWeight="SemiBold" ToolTip="{Binding ContextLabel}"
                                   gallery:GalleryTextClamp.MaxLines="2" gallery:GalleryTextClamp.Text="{Binding ContextLabel}" />

                        <!-- Main commands: Edit is the panel's one filled button; pin and copy share a row. -->
                        <StackPanel Grid.Row="2" AutomationProperties.AutomationId="LibraryDetailsActions" Margin="0,16,0,0">
                            <Button x:Name="DetailsEditButton" Content="{Binding ActionLabel}" Style="{StaticResource Button.Primary}"
                                    Click="OnEditClick" />
                            <Grid Margin="0,8,0,0" Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DetailsFloatButton" Style="{StaticResource Button.Secondary}"
                                        ToolTip="{loc:Text Gallery.FloatHint}" AutomationProperties.Name="{loc:Text Gallery.Float}"
                                        Click="OnFloatClick">
                                    <StackPanel Orientation="Horizontal">
                                        <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Pin}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Fill="Transparent" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Text QuickAccess.Pin}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DetailsCopyButton" Grid.Column="2" Style="{StaticResource Button.Secondary}"
                                        ToolTip="{loc:Text Text_59D43391538F}" AutomationProperties.Name="{loc:Text Text_42A667BC71B0}"
                                        Click="OnCopyClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid VerticalAlignment="Center">
                                            <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Copy}"
                                                  gallery:GalleryCopyFeedback.Part="Glyph" themes:FluidMotion.FadeTo="1"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Fill="Transparent" />
                                            <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Check}" Opacity="0"
                                                  gallery:GalleryCopyFeedback.Part="Check"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Fill="Transparent" />
                                        </Grid>
                                        <TextBlock Text="{loc:Text QuickAccess.Copy}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Information only: the panel's one scrolling area. -->
                        <ScrollViewer x:Name="GalleryDetailsScroll" Grid.Row="3" Margin="0,16,0,0" Focusable="False"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <StackPanel AutomationProperties.AutomationId="LibraryDetailsInfo">
                                    <TextBlock Text="{Binding TimeCaption}" Foreground="{DynamicResource Text.Secondary}" />
                                    <TextBlock Text="{Binding DetailDimensions}" Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding RetentionCaption}" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock AutomationProperties.AutomationId="LibraryDetailsTags" Foreground="{DynamicResource Text.Secondary}"
                                               Margin="0,0,0,8" ToolTip="{Binding TagsCaption}"
                                               gallery:GalleryTextClamp.MaxLines="2" gallery:GalleryTextClamp.Text="{Binding TagsCaption}"
                                               Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="{loc:Text Library.Organize.Action}" Style="{StaticResource Button.Secondary}"
                                            Click="OnOrganizeClick" />
                                </StackPanel>
                                <!-- Source: the app and window a capture came from, and its web page or folder when known. Long
                                     addresses and paths show two lines with "show all" and a copy command, never a nested scroller. -->
                                <StackPanel AutomationProperties.AutomationId="LibrarySourceSection" AutomationProperties.Name="{loc:Text Library.Source.Label}"
                                            Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                                    <StackPanel.Resources>
                                        <!-- A quiet text toggle beside a value's label; expanded is not a selected state. -->
                                        <Style x:Key="LibrarySource.ExpandToggle" TargetType="ToggleButton">
                                            <Setter Property="Content" Value="{loc:Text Library.Source.ShowAll}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Padding" Value="6,2" />
                                            <Setter Property="MinHeight" Value="{DynamicResource Size.HitTarget.Compact}" />
                                            <Setter Property="Margin" Value="8,0,0,0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <!-- Hover and press washes fade over the whole chip; the contrast-theme
                                                             hover outline (Border.Hover, transparent otherwise) fades with them. The
                                                             outline is its own layer so the washes keep filling the whole chip. -->
                                                        <Grid>
                                                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius.Sm}" />
                                                            <Border x:Name="HoverLayer" Style="{StaticResource LibraryUx.HoverWash}" CornerRadius="{DynamicResource Radius.Sm}" />
                                                            <Border x:Name="PressedLayer" Style="{StaticResource StateLayer.Pressed}" CornerRadius="{DynamicResource Radius.Sm}" />
                                                            <Border x:Name="HoverOutline" Style="{StaticResource StateLayer}" BorderThickness="1"
                                                                    CornerRadius="{DynamicResource Radius.Sm}" />
                                                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Border x:Name="FocusRing" BorderBrush="{DynamicResource Text.Primary}" BorderThickness="{DynamicResource Focus.RingThickness}"
                                                                    CornerRadius="{DynamicResource Radius.Sm}" IsHitTestVisible="False" Opacity="0" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                                                                <Setter TargetName="HoverOutline" Property="themes:FluidMotion.FadeTo" Value="1" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="PressedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                                                            </Trigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Content" Value="{loc:Text Library.Source.ShowLess}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Resources>
                                    <TextBlock Text="{loc:Text Library.Source.Label}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBlock AutomationProperties.AutomationId="LibrarySourceApp" Text="{Binding SourceAppName}" TextWrapping="Wrap"
                                               ToolTip="{Binding SourceAppToolTip}" AutomationProperties.Name="{Binding SourceAppAutomationName}"
                                               Visibility="{Binding HasSourceApp, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock AutomationProperties.AutomationId="LibrarySourceWindow" Margin="0,2,0,0"
                                               Foreground="{DynamicResource Text.Secondary}" ToolTip="{Binding SourceWindowTitle}"
                                               gallery:GalleryTextClamp.MaxLines="2" gallery:GalleryTextClamp.Text="{Binding SourceWindowTitle}"
                                               AutomationProperties.Name="{Binding SourceWindowTitleAutomationName}"
                                               Visibility="{Binding HasSourceWindowTitle, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel AutomationProperties.AutomationId="LibrarySourcePage" Margin="0,12,0,0"
                                                Visibility="{Binding HasSourcePageUrl, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SourcePageLabel" Text="{loc:Text Library.SourcePage.Label}" Foreground="{DynamicResource Text.Muted}"
                                                       FontSize="{StaticResource FontSize.Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <ToggleButton x:Name="SourcePageToggle" Grid.Column="1" Style="{StaticResource LibrarySource.ExpandToggle}"
                                                          AutomationProperties.AutomationId="LibrarySourcePageToggle"
                                                          AutomationProperties.Name="{loc:Text Library.SourcePage.ShowFull}"
                                                          gallery:GalleryTextClamp.ToggleTarget="{Binding ElementName=SourcePageValue}" />
                                        </Grid>
                                        <TextBlock x:Name="SourcePageValue" AutomationProperties.AutomationId="LibrarySourcePageValue" Margin="0,2,0,0"
                                                   FontSize="{StaticResource FontSize.Control}" ToolTip="{Binding SourcePageDisplayText}"
                                                   AutomationProperties.Name="{Binding SourcePageUrlAutomationName}"
                                                   AutomationProperties.HelpText="{Binding SourcePageDisplayText}"
                                                    gallery:GalleryTextClamp.MaxLines="2" gallery:GalleryTextClamp.Text="{Binding SourcePageDisplayText}" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="{loc:Text Library.SourcePage.Open}" Style="{StaticResource Button.Secondary}" Click="OnOpenSourcePageClick" Margin="0,0,8,8" />
                                            <Button Content="{loc:Text Library.SourcePage.Copy}" Style="{StaticResource Button.Secondary}" Click="OnCopySourcePageClick" Margin="0,0,0,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <TextBlock AutomationProperties.AutomationId="LibrarySourceUnsaved" Margin="0,12,0,0"
                                               Text="{loc:Text Library.Source.UnsavedDocument}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               Visibility="{Binding HasUnsavedSourceDocument, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel AutomationProperties.AutomationId="LibrarySourceLocation" Margin="0,12,0,0"
                                                Visibility="{Binding HasSourceDocumentPath, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SourcePathLabel" Text="{loc:Text Library.Source.Location}" Foreground="{DynamicResource Text.Muted}"
                                                       FontSize="{StaticResource FontSize.Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <ToggleButton x:Name="SourcePathToggle" Grid.Column="1" Style="{StaticResource LibrarySource.ExpandToggle}"
                                                          AutomationProperties.AutomationId="LibrarySourcePathToggle"
                                                          AutomationProperties.Name="{loc:Text Library.Source.ShowFullPath}"
                                                          gallery:GalleryTextClamp.ToggleTarget="{Binding ElementName=SourcePathValue}" />
                                        </Grid>
                                        <TextBlock x:Name="SourcePathValue" AutomationProperties.AutomationId="LibrarySourcePathValue" Margin="0,2,0,0"
                                                   FontSize="{StaticResource FontSize.Control}" ToolTip="{Binding SourceDocumentPath}"
                                                   AutomationProperties.Name="{Binding SourceDocumentPathAutomationName}"
                                                   gallery:GalleryTextClamp.MiddleEllipsis="{Binding IsSourceDocumentFile}"
                                                   gallery:GalleryTextClamp.MaxLines="2" gallery:GalleryTextClamp.Text="{Binding SourceDocumentPath}" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="{loc:Text Library.Source.OpenFile}" Style="{StaticResource Button.Secondary}" Click="OnOpenSourceFileClick" Margin="0,0,8,8"
                                                    Visibility="{Binding IsSourceDocumentFile, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="{Binding SourceLocationAction}" Style="{StaticResource Button.Secondary}" Click="OnOpenSourceFolderClick" Margin="0,0,8,8" />
                                            <Button Content="{loc:Text Library.Source.CopyPath}" Style="{StaticResource Button.Secondary}" Click="OnCopySourcePathClick" Margin="0,0,0,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{loc:Text Workspace.EditHint}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}"
                                           FontSize="{StaticResource FontSize.Caption}" Margin="0,16,0,0"
                                           Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{loc:Text Workspace.VideoHint}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}"
                                           FontSize="{StaticResource FontSize.Caption}" Margin="0,16,0,0"
                                           Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status line: the library summary and the last action's result, which fades out on its own. -->
        <Grid x:Name="LibraryStatusBar" Grid.Row="3" MinHeight="26" Margin="4,6,2,0"
              SizeChanged="OnStatusBarSizeChanged"
              AutomationProperties.Name="{loc:Text LibraryUx_StatusName}">
            <!-- Widths: the summary takes at most 55% of the bar (see OnStatusBarSizeChanged) and the version or
                 update button at most 200 DIPs, so a long folder name or update label never squeezes the message
                 out; a notice is one trimmed line, so it never grows the bar. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SummaryColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" MaxWidth="200" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                <TextBlock x:Name="SummaryLabel" Text="{Binding SummaryText}" Style="{StaticResource StatusBar.Text}"
                           Foreground="{DynamicResource Text.Muted}" AutomationProperties.Name="{Binding SummaryText}" />
                <TextBlock Text="  ·  " Style="{StaticResource StatusBar.Text}" Foreground="{DynamicResource Text.Muted}" />
                <TextBlock x:Name="FolderStorageLabel" Text="{Binding FolderStorageText}" Style="{StaticResource StatusBar.Text}"
                           Foreground="{DynamicResource Text.Muted}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowResultCount, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="  ·  " Style="{StaticResource StatusBar.Text}" Foreground="{DynamicResource Text.Muted}" />
                    <TextBlock x:Name="ResultCountLabel" Text="{Binding ResultCountText}" Style="{StaticResource StatusBar.Text}"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowNewCaptureDestination, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="  ·  " Style="{StaticResource StatusBar.Text}" Foreground="{DynamicResource Text.Muted}" />
                    <TextBlock x:Name="NewCaptureDestinationLabel" Text="{Binding NewCaptureDestinationText}" MaxWidth="320"
                               ToolTip="{Binding NewCaptureDestinationText}" Style="{StaticResource StatusBar.Text}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowFolderStorageInfo, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{loc:Text Folder410.StorageInfo}" Background="Transparent">
                    <TextBlock Text="  ·  " Style="{StaticResource StatusBar.Text}" Foreground="{DynamicResource Text.Muted}" />
                    <themes:SymbolIcon Size="16" Data="{StaticResource LibraryUx.Icon.Info}"
                          Stroke="{DynamicResource State.Warning}" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Text Folder410.StorageInfo}" Margin="6,0,0,0" MaxWidth="360"
                               Style="{StaticResource StatusBar.Text}" />
                </StackPanel>
            </StackPanel>
            <!-- A notice (update done, rating invitation) has a slot of its own, so it can never replace a result's
                 follow-up such as Undo: it shows only while the line above is empty, in a neutral colour. -->
            <DockPanel x:Name="LibraryNotice" Grid.Column="1" Margin="16,0,0,0" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Visibility="Collapsed" LastChildFill="True">
                <Button x:Name="LibraryNoticeAction" DockPanel.Dock="Right" Style="{StaticResource Button.GhostCompact}"
                        Height="24" MinHeight="24" Padding="8,0" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,0,0,0"
                        Click="OnNoticeActionClick" />
                <TextBlock x:Name="LibraryNoticeText" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" TextAlignment="Right"
                           VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}"
                           FontSize="{StaticResource FontSize.Caption}" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
            <TextBlock x:Name="LibraryActionStatus" Grid.Column="1" Margin="16,0,0,0" TextWrapping="Wrap" TextAlignment="Right"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource Text.Secondary}" FontSize="{StaticResource FontSize.Caption}"
                       AutomationProperties.LiveSetting="Polite" />
            <!-- The result's own follow-up (Undo after a delete, Change after the first automatic
                 deletion); hidden whenever the line shows anything else. -->
            <StackPanel x:Name="LibraryStatusActionPanel" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed"
                        VerticalAlignment="Center">
                <TextBlock Text="·" Margin="6,0,2,0" VerticalAlignment="Center" Foreground="{DynamicResource Text.Muted}"
                           FontSize="{StaticResource FontSize.Caption}" />
                <Button x:Name="LibraryStatusAction" Style="{StaticResource Button.GhostCompact}"
                        VerticalAlignment="Center" FontWeight="SemiBold" Click="OnStatusActionClick" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button x:Name="ArchiveCancelButton" Content="{loc:Text Library.Action.Cancel}"
                        Style="{StaticResource Button.GhostCompact}" Click="OnCancelArchiveClick" Visibility="Collapsed" Margin="8,0,0,0" />
                <Button x:Name="ActivityButton" Style="{StaticResource Button.GhostCompact}" Click="OnActivityClick"
                        Visibility="Collapsed" Margin="8,0,0,0" AutomationProperties.Name="{loc:Text Library.Activity.Title}" />
                <Popup x:Name="ActivityPopup" PlacementTarget="{Binding ElementName=ActivityButton}" Placement="Top"
                       StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{DynamicResource Surface.Floating}" BorderBrush="{DynamicResource Border.Control}"
                            BorderThickness="1" Padding="12">
                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ActivityRows" />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </StackPanel>
            <TextBlock x:Name="CurrentVersionLabel" Grid.Column="4" Margin="12,0,0,0"
                       Style="{StaticResource StatusBar.Text}" Foreground="{DynamicResource Text.Muted}"
                       VerticalAlignment="Center" />
            <!-- An available update: a small button that takes the version text's place until the update is
                 installed. Nothing floats over the cards. -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UpdateAvailableButton" Margin="12,0,0,0" Visibility="Collapsed"
                        Height="24" MinHeight="24" MaxWidth="188" Padding="8,0" Style="{StaticResource Button.GhostCompact}" FontSize="{StaticResource FontSize.Caption}"
                        FontWeight="SemiBold" VerticalAlignment="Center" Click="OnUpdateAvailableClick" />
                <Button x:Name="UpdateDismissButton" Margin="4,0,0,0" Visibility="Collapsed"
                        Content="{loc:Text Dialog.Close}" AutomationProperties.Name="{loc:Text Dialog.Close}"
                        Height="24" MinHeight="24" Padding="8,0" Style="{StaticResource Button.GhostCompact}"
                        FontSize="{StaticResource FontSize.Caption}" VerticalAlignment="Center" Click="OnUpdateDismissClick" />
            </StackPanel>
        </Grid>

        <!-- Pointer-side drop label ("제품리뷰 폴더로 이동 · 2개"), like Explorer's "Move to" hint. -->
        <Canvas x:Name="DragHintLayer" Grid.RowSpan="4" IsHitTestVisible="False" Panel.ZIndex="10">
            <Border x:Name="DragHint" Visibility="Collapsed" Padding="10,6" CornerRadius="6"
                    Background="{DynamicResource Surface.Floating}" BorderBrush="{DynamicResource Text.Primary}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <themes:SymbolIcon StrokeThickness="0" Size="16" Data="{StaticResource LibraryUx.Icon.Folder}"
                          Fill="{DynamicResource Accent.Folder}" VerticalAlignment="Center" />
                    <TextBlock x:Name="DragHintText" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
