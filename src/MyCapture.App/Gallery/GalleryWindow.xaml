<Window x:Class="MyCapture.App.Gallery.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gallery="clr-namespace:MyCapture.App.Gallery"
        x:ClassModifier="internal"
        Style="{StaticResource Window.Standard}"
        Title="MyCapture — 라이브러리"
        Width="1120" Height="760"
        MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface.Base}"
        Foreground="{StaticResource Text.Primary}">

    <Window.Resources>

        <!-- Tile action glyphs come from the shared Symbols.xaml resource dictionary
             (Icon.Copy / Icon.Pin / Icon.More / Icon.Ocr / Icon.Delete), referenced by key. -->

        <!-- Gallery actions inherit the shared icon-only states and retain a compact grid fit. -->
        <Style x:Key="Gallery.IconButton" TargetType="Button" BasedOn="{StaticResource Button.Icon.Compact}">
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <DataTemplate x:Key="Gallery.TileTemplate" DataType="{x:Type gallery:GalleryItemViewModel}">
            <!-- A 244px tile plus 6px margins occupies a 256px track, matching
                 GalleryRowBuilder.TileTrackWidth. Four cards now fill the default window
                 without shrinking the image or reducing the accessible action targets. -->
            <Border Width="244" Height="292" Margin="6"
                    Background="{StaticResource Surface.Raised}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Lg}"
                    SnapsToDevicePixels="True"
                    ToolTip="{Binding ExportToolTip}">
                <Grid Margin="9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Image-first: the thumbnail fills the whole upper region. -->
                    <Border Grid.Row="0"
                            Background="{StaticResource Surface.Sunken}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Md}"
                            ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Thumbnail}"
                                   Margin="2"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="{Binding AccessibleName}" />
                            <TextBlock Text="{Binding PreviewUnavailableText}"
                                       Style="{StaticResource Text.MutedBlock}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsBroken, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Video records remain image-light in the grid: a generated first-frame
                                 preview plus an unmistakable play affordance and exact duration. -->
                            <Border Width="52" Height="52" CornerRadius="26"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{StaticResource Surface.Badge}"
                                    BorderBrush="{StaticResource Border.Badge}" BorderThickness="1"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                <Path Data="{StaticResource Icon.Play}"
                                      Width="24" Height="24" Stretch="Uniform"
                                      Fill="{StaticResource Text.Badge}"
                                      Stroke="{StaticResource Text.Badge}" StrokeThickness="1.2"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="8" Padding="7,3" CornerRadius="5"
                                    Background="{StaticResource Surface.BadgeStrong}"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding DurationCaption}"
                                           Foreground="{StaticResource Text.Badge}"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="{StaticResource FontSize.Caption}" />
                            </Border>

                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Margin="8" Padding="7,3" CornerRadius="5"
                                    Background="{StaticResource Surface.BadgeStrong}"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="동영상" Foreground="{StaticResource Text.Badge}"
                                           FontSize="{StaticResource FontSize.Caption}"
                                           FontWeight="SemiBold" />
                            </Border>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Margin="8" Padding="7,3" CornerRadius="5"
                                    Background="{StaticResource Surface.BadgeStrong}"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="이미지" Foreground="{StaticResource Text.Badge}"
                                           FontSize="{StaticResource FontSize.Caption}"
                                           FontWeight="SemiBold" />
                            </Border>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="8">
                                <Border Padding="8,4" CornerRadius="6"
                                        Background="{StaticResource Accent.Default}"
                                        Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="고정됨" FontSize="{StaticResource FontSize.Caption}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.OnAccent}" />
                                </Border>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="8" Padding="8,4" CornerRadius="6"
                                    Background="{StaticResource Surface.Floating}"
                                    BorderBrush="{StaticResource Border.Subtle}"
                                    BorderThickness="1"
                                    Visibility="{Binding HasAnnotations, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="편집됨" FontSize="{StaticResource FontSize.Caption}"
                                           Foreground="{StaticResource Text.Secondary}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Caption + time -->
                    <Grid Grid.Row="1" Margin="3,9,3,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Caption}"
                                   Visibility="{Binding HasCaption, Converter={StaticResource BoolToVisibility}}"
                                   Foreground="{StaticResource Text.Primary}"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSize.Body}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding TimeCaption}"
                                   Margin="10,0,0,0"
                                   Foreground="{StaticResource Text.Muted}"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="{StaticResource FontSize.Caption}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Single action row: one primary Edit, compact icon Copy + Pin, and a
                         discoverable More overflow holding OCR and Delete. -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource Button.Primary}"
                                Content="{Binding ActionLabel}" MinHeight="34"
                                ToolTip="다시 편집 (Enter)"
                                AutomationProperties.Name="다시 편집"
                                Click="OnEditClick" />

                        <Button Grid.Column="1" Style="{StaticResource Gallery.IconButton}"
                                ToolTip="렌더링된 이미지 복사 (Ctrl+C)"
                                AutomationProperties.Name="이미지 복사"
                                Click="OnCopyClick"
                                Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                            <Path Data="{StaticResource Icon.Copy}" Width="20" Height="20"
                                  Stretch="None"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Fill="Transparent" />
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource Gallery.IconButton}"
                                ToolTip="고정 전환 (Space 또는 P)"
                                AutomationProperties.Name="고정 전환"
                                Click="OnPinClick">
                            <Path Data="{StaticResource Icon.Pin}" Width="20" Height="20"
                                  Stretch="None"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Fill="Transparent" />
                        </Button>

                        <Button Grid.Column="3"
                                Style="{StaticResource Gallery.IconButton}"
                                ToolTip="더 보기 — 내보내기, 텍스트 인식, 삭제"
                                AutomationProperties.Name="더 보기"
                                Click="OnMoreClick">
                            <Path Data="{StaticResource Icon.More}" Width="20" Height="20"
                                  Stretch="None"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                            <Button.ContextMenu>
                                <!-- The context menu inherits the button's DataContext (the tile
                                     view model) via PlacementTarget, and each item carries the tile
                                     as CommandParameter so the handler always resolves the right
                                     record even though menu items are outside the visual tree. -->
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                                   RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="텍스트 인식 (OCR)"
                                              CommandParameter="{Binding}"
                                              AutomationProperties.Name="텍스트 인식 (OCR)"
                                              InputGestureText="T"
                                              Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}"
                                              Click="OnOcrMenuClick">
                                        <MenuItem.Icon>
                                            <Path Data="{StaticResource Icon.Ocr}" Width="18" Height="18"
                                                  Stretch="Uniform"
                                                  Stroke="{StaticResource Text.Secondary}"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Fill="Transparent" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="GIF로 내보내기"
                                              CommandParameter="{Binding}"
                                              AutomationProperties.Name="GIF로 내보내기"
                                              InputGestureText="G"
                                              Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}"
                                              Click="OnGifMenuClick" />
                                    <Separator />
                                    <MenuItem Header="삭제"
                                              CommandParameter="{Binding}"
                                              AutomationProperties.Name="삭제"
                                              InputGestureText="Delete"
                                              Foreground="{StaticResource State.DangerHover}"
                                              Click="OnDeleteMenuClick">
                                        <MenuItem.Icon>
                                            <Path Data="{StaticResource Icon.Delete}" Width="18" Height="18"
                                                  Stretch="Uniform"
                                                  Stroke="{StaticResource State.DangerHover}"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Fill="Transparent" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="Gallery.TileRowList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
            <Setter Property="ItemTemplate" Value="{StaticResource Gallery.TileTemplate}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Outline"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="2"
                                            CornerRadius="{StaticResource Radius.Lg}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Outline" Property="Background" Value="{StaticResource Surface.Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Outline" Property="Background" Value="{StaticResource Accent.Subtle}" />
                                            <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource Border.Accent}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource Border.Focus}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="Gallery.HeaderRowTemplate" DataType="{x:Type gallery:GalleryHeaderRow}">
            <Grid Margin="8,16,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Heading}"
                           Style="{StaticResource Text.Section}"
                           AutomationProperties.Name="{Binding Heading}" />
                <Border Grid.Column="1" Height="1" Margin="14,0,0,0"
                        Background="{StaticResource Border.Subtle}"
                        VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Gallery.TileRowTemplate" DataType="{x:Type gallery:GalleryTileRow}">
            <ListBox Style="{StaticResource Gallery.TileRowList}"
                     ItemsSource="{Binding Tiles}"
                     SelectionChanged="OnTileSelectionChanged"
                     KeyDown="OnTileKeyDown"
                     PreviewMouseLeftButtonDown="OnTileMouseLeftButtonDown"
                     PreviewMouseMove="OnTileMouseMove"
                     MouseDoubleClick="OnTileDoubleClick" />
        </DataTemplate>

        <Style x:Key="Gallery.RowContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContentTemplate" Value="{StaticResource Gallery.TileRowTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Converter={StaticResource IsHeaderRow}}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource Gallery.HeaderRowTemplate}" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Gallery.RowsList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource Gallery.RowContainer}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="26,22,22,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title only; the English all-caps eyebrow is removed. -->
        <Grid Grid.Row="0" Margin="2,0,2,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image Style="{StaticResource Brand.AppIcon}" Margin="0,1,12,0"
                       AutomationProperties.Name="MyCapture" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="라이브러리" Style="{StaticResource Text.Display}" />
                    <TextBlock Text="이미지와 동영상을 한곳에서 찾고 편집합니다. 동영상은 선택하거나 두 번 클릭하면 이 창 안에서 바로 재생됩니다."
                               Style="{StaticResource Text.MutedBlock}" Margin="0,5,0,0" MaxWidth="620"
                               HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,8"
                    VerticalAlignment="Center">
                <TextBlock x:Name="SummaryLabel"
                           Text="{Binding SummaryText}"
                           Foreground="{StaticResource Text.Secondary}"
                           FontSize="{StaticResource FontSize.Body}"
                           AutomationProperties.Name="{Binding SummaryText}" />
            </Border>
        </Grid>

        <!-- Search -->
        <Border Grid.Row="1" Style="{StaticResource Card.Sunken}"
                Padding="4" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource Icon.Search}"
                      Style="{StaticResource Icon.Glyph.Muted}" Width="18" Height="18"
                      Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBox x:Name="SearchBox" Grid.Column="1"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="10,9"
                         AutomationProperties.Name="검색"
                         TextChanged="OnSearchTextChanged" />
                <TextBlock Grid.Column="1" IsHitTestVisible="False"
                           Text="제목, 창 이름, 인식된 텍스트 검색  ·  Ctrl+F"
                           Foreground="{StaticResource Text.Muted}"
                           Margin="12,10"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- OCR full-text search coverage banner (Row 2). Shown only when part of the
             library is not yet searchable by the text inside the images, or when no OCR
             language pack is installed. Collapsed by default; the code-behind sets its
             state when the gallery opens and after an indexing pass. -->
        <Border x:Name="OcrCoverageBanner" Grid.Row="2"
                Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="OcrCoverageHeadline"
                               Foreground="{StaticResource Text.Primary}"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource FontSize.Body}" />
                    <TextBlock x:Name="OcrCoverageDetail"
                               Foreground="{StaticResource Text.Secondary}"
                               FontSize="{StaticResource FontSize.Caption}"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap" MaxWidth="760"
                               HorizontalAlignment="Left" />
                </StackPanel>
                <Button x:Name="OcrIndexButton" Grid.Column="1"
                        Style="{StaticResource Button.Primary}"
                        Content="지금 색인" MinHeight="34"
                        VerticalAlignment="Center" Margin="14,0,0,0"
                        ToolTip="아직 검색되지 않는 캡처의 텍스트를 인식해 전문 검색에 포함합니다"
                        AutomationProperties.Name="캡처 전문 색인 시작"
                        Click="OnOcrIndexClick" />
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="RowsList" Grid.Column="0"
                     Style="{StaticResource Gallery.RowsList}"
                     ItemsSource="{Binding Rows}"
                     SizeChanged="OnRowsListSizeChanged" />

            <Border Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource Card}" Padding="42,30"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel MaxWidth="380">
                    <TextBlock Text="아직 표시할 항목이 없습니다"
                               Style="{StaticResource Text.Title}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyStateLabel"
                               Text="{Binding EmptyStateText}"
                               Style="{StaticResource Text.MutedBlock}"
                               Margin="0,8,0,0"
                               TextAlignment="Center"
                               AutomationProperties.Name="{Binding EmptyStateText}" />
                </StackPanel>
            </Border>

            <Border x:Name="InlineVideoPanel" Grid.Column="1"
                    Width="372" Margin="16,0,0,0"
                    Style="{StaticResource Card}" Padding="14"
                    VerticalAlignment="Top" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="라이브러리 재생" Style="{StaticResource Text.Section}" />
                            <TextBlock x:Name="InlineVideoTitle" Text="동영상"
                                       Style="{StaticResource Text.MutedBlock}"
                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="닫기"
                                Style="{StaticResource Button.Ghost}"
                                Click="OnInlineCloseClick"
                                AutomationProperties.Name="라이브러리 재생 패널 닫기" />
                    </Grid>

                    <Border Height="202" Background="Black" CornerRadius="8"
                            ClipToBounds="True">
                        <MediaElement x:Name="InlineVideo"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Manual"
                                      Stretch="Uniform"
                                      ScrubbingEnabled="True"
                                      IsMuted="True" Volume="0"
                                      MediaOpened="OnInlineMediaOpened"
                                      MediaEnded="OnInlineMediaEnded"
                                      MediaFailed="OnInlineMediaFailed" />
                    </Border>

                    <Slider x:Name="InlineSeekSlider" Margin="0,10,0,0"
                            Minimum="0" Maximum="1" Value="0"
                            IsMoveToPointEnabled="True"
                            ValueChanged="OnInlineSeekChanged"
                            AutomationProperties.Name="동영상 재생 위치" />
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="InlinePlayButton" Content="재생"
                                Style="{StaticResource Button.Primary}"
                                MinWidth="76" Click="OnInlinePlayClick" />
                        <TextBlock x:Name="InlinePlaybackStatus" Grid.Column="1"
                                   Text="재생 준비"
                                   Style="{StaticResource Text.MutedBlock}"
                                   VerticalAlignment="Center" Margin="10,0" />
                        <TextBlock x:Name="InlineTimeLabel" Grid.Column="2"
                                   Text="00:00 / 00:00"
                                   FontFamily="{StaticResource Font.Mono}"
                                   Foreground="{StaticResource Text.Secondary}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
