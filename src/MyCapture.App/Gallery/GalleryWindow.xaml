        <DataTemplate x:Key="Gallery.CompactFolderRowTemplate" DataType="{x:Type gallery:GalleryFolderRow}">
            <ItemsControl ItemsSource="{Binding Folders}"
                          ItemTemplate="{StaticResource Gallery.CompactFolderCardTemplate}"
                          Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <gallery:GalleryCardRowPanel Columns="{Binding Columns}"
                                                     BaseCardWidth="148" BaseCardHeight="180" HeightPerWidth="1" CardInset="16" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <Style x:Key="Gallery.RowContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContentTemplate" Value="{StaticResource Gallery.TileRowTemplate}" />
            <!-- Later triggers win: a compact folder row takes the compact folder template. -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource Gallery.CompactTileRowTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={StaticResource IsHeaderRow}}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource Gallery.HeaderRowTemplate}" />

                    <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={StaticResource IsFolderRow}}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource Gallery.FolderRowTemplate}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Converter={StaticResource IsFolderRow}}" Value="True" />
                        <Condition Binding="{Binding IsCompact}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="ContentTemplate" Value="{StaticResource Gallery.CompactFolderRowTemplate}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Gallery.RowsList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource Gallery.RowContainer}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ============================================================= -->
        <!-- Navigation pane: views, folders and dates share one selection, -->
        <!-- like a Windows navigation view (icon, name, count; accent pill).-->
        <!-- ============================================================= -->
        <!-- The views share one parent panel, which groups them per window. A GroupName would be
             shared by every library window, so a closed or not yet shown window could uncheck the
             view of another. -->
        <Style x:Key="LibraryUx.NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <!-- The checked wash sits above the hover wash; the accent pill fades in with it. -->
                        <Grid Background="Transparent">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource Radius.Md}" />
                            <Border x:Name="HoverLayer" Style="{StaticResource LibraryUx.HoverWash}" BorderThickness="1" />
                            <Border x:Name="SelectedLayer" Style="{StaticResource LibraryUx.SelectedWash}" BorderThickness="1" />
                            <Border x:Name="Indicator" Style="{StaticResource StatePart.Normal}" Width="3" Height="16" Margin="1,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource Accent.Default}" CornerRadius="{DynamicResource Radius.Pill}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter Margin="12,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                            <Border x:Name="FocusRing" Margin="1" BorderBrush="{DynamicResource Border.Focus}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Sm}" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                                <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="0" />
                                <Setter TargetName="Indicator" Property="themes:FluidMotion.FadeTo" Value="1" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                <Setter TargetName="HoverLayer" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryUx.NavGlyph" TargetType="themes:SymbolIcon" BasedOn="{StaticResource Icon.Symbol}">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LibraryUx.NavCount" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LibraryUx.SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Tree rows read like navigation items: hover wash, subtle selection with the accent pill. -->
        <Style x:Key="LibraryUx.TreeExpander" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <!-- The chevron turns over Motion.Normal (FluidMotion.RotateTo) as the row expands. -->
                        <Border Background="Transparent">
                            <themes:SymbolIcon Size="16" x:Name="Chevron" Style="{StaticResource StatePart.Normal}"
                                               Data="{StaticResource LibraryUx.Icon.Chevron}" Stroke="{DynamicResource Text.Secondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="themes:FluidMotion.RotateTo" Value="90" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryUx.TreeItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="ContextMenu" Value="{StaticResource Gallery.FolderContextMenu}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Grid x:Name="Row" MinHeight="34" Background="Transparent">
                                <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Md}" />
                                <Border x:Name="HoverLayer" Style="{StaticResource LibraryUx.HoverWash}" BorderThickness="1" />
                                <Border x:Name="SelectedLayer" Style="{StaticResource LibraryUx.SelectedWash}" BorderThickness="1" />
                                <Border x:Name="Indicator" Style="{StaticResource StatePart.Normal}" Width="3" Height="16" Margin="1,0,0,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{DynamicResource Accent.Default}" CornerRadius="{DynamicResource Radius.Pill}"
                                        Opacity="0" IsHitTestVisible="False" />
                                <DockPanel Margin="4,0,10,0">
                                    <ToggleButton x:Name="Expander" DockPanel.Dock="Left" Style="{StaticResource LibraryUx.TreeExpander}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                    <ContentPresenter x:Name="PART_Header" ContentSource="Header" Margin="2,0,0,0"
                                                      VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                                </DockPanel>
                                <Border x:Name="FocusRing" Margin="1" BorderBrush="{DynamicResource Border.Focus}" BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Sm}" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                            <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                                <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="0" />
                                <Setter TargetName="Indicator" Property="themes:FluidMotion.FadeTo" Value="1" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <!-- Drop feedback stays immediate, as File Explorer's does: it follows the pointer
                                 during a drag. -->
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Accent.Subtle}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Accent}" />
                                <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SelectedLayer" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                <Setter TargetName="HoverLayer" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate x:Key="Gallery.FolderNodeTemplate" DataType="{x:Type gallery:GalleryFolderNode}"
                                  ItemsSource="{Binding Children}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <themes:SymbolIcon StrokeThickness="0" Size="16" Data="{StaticResource LibraryUx.Icon.Folder}"
                      Fill="{DynamicResource Accent.Folder}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Caption}" Margin="8,0,8,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource LibraryUx.NavCount}" />
            </Grid>
        </HierarchicalDataTemplate>

        <DataTemplate x:Key="LibraryUx.DateItemTemplate" DataType="{x:Type gallery:GalleryFolderNode}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <themes:SymbolIcon Size="20" Data="{StaticResource LibraryUx.Icon.Calendar}" Style="{StaticResource LibraryUx.NavGlyph}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,8,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource LibraryUx.NavCount}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="LibraryUx.DateItem" TargetType="ListBoxItem">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Caption}" />
            <Setter Property="ContextMenu" Value="{StaticResource Gallery.FolderContextMenu}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- The same layers as a folder row. -->
                        <Grid MinHeight="34" Background="Transparent">
                            <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Md}" />
                            <Border x:Name="HoverLayer" Style="{StaticResource LibraryUx.HoverWash}" BorderThickness="1" />
                            <Border x:Name="SelectedLayer" Style="{StaticResource LibraryUx.SelectedWash}" BorderThickness="1" />
                            <Border x:Name="Indicator" Style="{StaticResource StatePart.Normal}" Width="3" Height="16" Margin="1,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource Accent.Default}" CornerRadius="{DynamicResource Radius.Pill}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter Margin="12,0,10,0" VerticalAlignment="Center" />
                            <Border x:Name="FocusRing" Margin="1" BorderBrush="{DynamicResource Border.Focus}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Sm}" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                                <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="0" />
                                <Setter TargetName="Indicator" Property="themes:FluidMotion.FadeTo" Value="1" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Accent.Subtle}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Accent}" />
                                <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SelectedLayer" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                <Setter TargetName="HoverLayer" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Collapsible pane section ("날짜"): an Expander keeps the expand/collapse automation pattern. -->
        <Style x:Key="LibraryUx.Section" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top" MinHeight="32" Cursor="Hand"
                                          FocusVisualStyle="{x:Null}"
                                          AutomationProperties.Name="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <!-- The hover wash fades; the chevron turns over Motion.Normal as the section opens. -->
                                        <Grid Background="Transparent">
                                            <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent"
                                                    BorderThickness="1" CornerRadius="{DynamicResource Radius.Md}" />
                                            <Border x:Name="HoverLayer" Style="{StaticResource LibraryUx.HoverWash}" BorderThickness="1" />
                                            <DockPanel Margin="12,0,8,0">
                                                <themes:SymbolIcon Size="16" x:Name="Chevron" Style="{StaticResource StatePart.Normal}" DockPanel.Dock="Right"
                                                                   Data="{StaticResource LibraryUx.Icon.Chevron}" Stroke="{DynamicResource Text.Secondary}"
                                                                   VerticalAlignment="Center" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </DockPanel>
                                            <Border x:Name="FocusRing" Margin="1" BorderBrush="{DynamicResource Border.Focus}"
                                                    BorderThickness="1" CornerRadius="{DynamicResource Radius.Sm}" Opacity="0"
                                                    IsHitTestVisible="False" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="themes:FluidMotion.RotateTo" Value="90" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                                <Setter TargetName="HoverLayer" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                           Style="{StaticResource LibraryUx.SectionLabel}" />
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================= -->
        <!-- Command bar and location header                               -->
        <!-- ============================================================= -->
        <Style x:Key="LibraryUx.CommandButton" TargetType="Button" BasedOn="{StaticResource Button.Command}" />
        <Style x:Key="LibraryUx.CommandGhost" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="Padding" Value="{DynamicResource CommandButton.Padding.Standard}" />
            <Setter Property="FontSize" Value="{DynamicResource CommandButton.FontSize}" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LibraryUx.CommandIcon" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
            <Setter Property="Padding" Value="{DynamicResource CommandButton.Padding.Standard}" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LibraryUx.CommandGlyph" TargetType="themes:SymbolIcon" BasedOn="{StaticResource Icon.Symbol}">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LibraryUx.CommandSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="4,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Border.Subtle}" />
        </Style>

        <!-- One toggle chip beside the folder name: checked = new captures join this folder. -->
        <!-- "Save new captures here" is a setting of the open folder, not part of its name: a
             quiet switch at the far end of the header, the way Windows shows an on/off option. -->
        <Style x:Key="LibraryUx.SaveHereSwitch" TargetType="CheckBox">
            <Setter Property="themes:FluidMotion.SwitchMotion" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <StackPanel Orientation="Horizontal" Margin="8,0,6,0" VerticalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center" Margin="0,0,10,0" />
                                <!-- FluidMotion.SwitchMotion slides the thumb and fades the fill. Hover hands the
                                     track edge and the off thumb over to Text.Primary copies that fade in while
                                     the rest parts fade out; the label's colour changes with the pointer. -->
                                <Grid x:Name="PART_SwitchTrack" Width="36" Height="20" VerticalAlignment="Center">
                                    <Border x:Name="Track" CornerRadius="10" BorderThickness="1" Style="{StaticResource LibraryUx.RestEdge}"
                                            BorderBrush="{DynamicResource Text.Secondary}" Background="Transparent" />
                                    <Border x:Name="TrackHover" CornerRadius="10" BorderThickness="1" Opacity="0" IsHitTestVisible="False"
                                            BorderBrush="{DynamicResource Text.Primary}" />
                                    <Border x:Name="PART_SwitchFill" CornerRadius="10" Opacity="0"
                                            Background="{DynamicResource Accent.Default}" />
                                    <Grid x:Name="PART_SwitchThumb" Width="12" Height="12" Margin="4,0,0,0"
                                          HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Ellipse x:Name="ThumbOff" Style="{StaticResource LibraryUx.RestEdge}" Fill="{DynamicResource Text.Secondary}" />
                                        <Ellipse x:Name="ThumbHover" Opacity="0" IsHitTestVisible="False" Fill="{DynamicResource Text.Primary}" />
                                        <Ellipse x:Name="PART_SwitchThumbOn" Fill="{DynamicResource Text.OnAccent}" Opacity="0" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                            <Border x:Name="FocusRing" BorderBrush="{DynamicResource Border.Focus}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Md}" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                <Setter TargetName="Track" Property="themes:FluidMotion.FadeTo" Value="0" />
                                <Setter TargetName="TrackHover" Property="themes:FluidMotion.FadeTo" Value="1" />
                                <Setter TargetName="ThumbOff" Property="themes:FluidMotion.FadeTo" Value="0" />
                                <Setter TargetName="ThumbHover" Property="themes:FluidMotion.FadeTo" Value="1" />
                            </Trigger>
                            <!-- On, the track keeps its accent edge whether or not the pointer is over it. -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent.Default}" />
                                <Setter TargetName="Track" Property="themes:FluidMotion.FadeTo" Value="1" />
                                <Setter TargetName="TrackHover" Property="themes:FluidMotion.FadeTo" Value="0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LibraryUx.BreadcrumbTemplate" DataType="{x:Type gallery:GalleryBreadcrumb}">
            <StackPanel Orientation="Horizontal">
                <Button Content="{Binding Name}" Style="{StaticResource Button.GhostCompact}" Click="OnBreadcrumbClick"
                        FontSize="{StaticResource FontSize.Body}" FontWeight="Normal" Padding="6,4" MaxWidth="220"
                        Foreground="{DynamicResource Text.Secondary}" AutomationProperties.Name="{Binding Name}"
                        Visibility="{Binding IsLink, Converter={StaticResource BoolToVisibility}}" />
                <themes:SymbolIcon Size="16" Data="{StaticResource LibraryUx.Icon.Chevron}" Margin="2,0"
                      Stroke="{DynamicResource Text.Muted}" VerticalAlignment="Center"
                      Visibility="{Binding IsLink, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" Margin="6,0,0,0"
                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                    <themes:SymbolIcon StrokeThickness="0" Size="16" Data="{StaticResource LibraryUx.Icon.Folder}"
                          Fill="{DynamicResource Accent.Folder}" VerticalAlignment="Center"
                          Visibility="{Binding Scope.FolderId, Converter={StaticResource LibraryUx.HasValue}}" />
                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" MaxWidth="280" TextTrimming="CharacterEllipsis"
                               FontSize="{StaticResource FontSize.Subtitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
      </ResourceDictionary>
    </Window.Resources>

    <!-- The window title lives only in the native title bar, which ModernWindowChrome paints with
         the same Surface.Base as this body. The first body row is the command bar on that same
         base with no divider, so title bar, commands and the navigation pane read as one surface. -->
    <Grid x:Name="LibraryRoot" Margin="12,4,12,6" Background="Transparent" AllowDrop="True"
          DragEnter="OnLibraryDragOver" DragOver="OnLibraryDragOver" DragLeave="OnLibraryDragLeave" Drop="OnLibraryDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- One command bar of fixed height. Capture stays on the left; the right side swaps between
             library commands and the selection's commands in place, so selecting never pushes the
             library down. Shortcuts are in tooltips, the search sits between the two groups. -->
        <Grid x:Name="LibraryCommandBar" Grid.Row="0" Height="48" Margin="0,0,0,6"
              AutomationProperties.Name="{loc:Text LibraryUx_CommandBarName}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Labelled capture commands while nothing is selected: capture is the one filled button. -->
                <StackPanel x:Name="CaptureCommands" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button x:Name="CaptureRegionButton" Style="{StaticResource Button.Primary}" Margin="3,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{loc:Text Text_2C20ADDA2018}"
                            Click="OnCaptureRegionClick">
                        <StackPanel Orientation="Horizontal">
                            <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Capture}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Fill="Transparent" />
                            <TextBlock Text="{loc:Text Text_2C20ADDA2018}" Margin="{DynamicResource CommandButton.IconLabelGap}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RecordRegionButton" Style="{StaticResource LibraryUx.CommandButton}"
                            AutomationProperties.Name="{loc:Text Text_4F5AF20FAA6E}"
                            Click="OnRecordRegionClick">
                        <StackPanel Orientation="Horizontal">
                            <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Record}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="{loc:Text Text_4F5AF20FAA6E}" Margin="{DynamicResource CommandButton.IconLabelGap}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- With a selection the item's Edit is the filled button, so capture becomes two icons. -->
                <StackPanel x:Name="CompactCaptureCommands" Orientation="Horizontal"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <Button x:Name="CaptureRegionIconButton" Style="{StaticResource LibraryUx.CommandIcon}"
                            AutomationProperties.Name="{loc:Text Text_2C20ADDA2018}" Click="OnCaptureRegionClick">
                        <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Capture}" Style="{StaticResource LibraryUx.CommandGlyph}" />
                    </Button>
                    <Button x:Name="RecordRegionIconButton" Style="{StaticResource LibraryUx.CommandIcon}"
                            AutomationProperties.Name="{loc:Text Text_4F5AF20FAA6E}" Click="OnRecordRegionClick">
                        <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Record}" Style="{StaticResource LibraryUx.CommandGlyph}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- An input boundary, not a decorative card line: it takes the control outline, hands it
                 over to the stronger outline on hover (the two fade, like the shared TextBox), and takes
                 the focus colour at once while the search box inside has keyboard focus. -->
            <Grid x:Name="SearchField" Grid.Column="1" Margin="6,0,12,0"
                  MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <!-- Transparent hit surface; each fading chrome copy draws its fill and edge together. -->
                <Border x:Name="SearchWell" Style="{StaticResource Card.Sunken}" BorderBrush="Transparent" Background="Transparent" />
                <Border x:Name="SearchEdge" BorderThickness="1" CornerRadius="{DynamicResource Radius.Lg}" SnapsToDevicePixels="True">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource LibraryUx.RestEdge}">
                            <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}" />
                            <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=SearchField}" Value="True">
                                    <Setter Property="themes:FluidMotion.FadeTo" Value="0" />
                                </DataTrigger>
                                <!-- Focus keeps this edge whole, so the outline never dims while the pointer crosses it. -->
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchField}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                    <Setter Property="themes:FluidMotion.FadeTo" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border x:Name="SearchHoverLayer" BorderThickness="1" CornerRadius="{DynamicResource Radius.Lg}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StateLayer}">
                            <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
                            <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=SearchField}" Value="True">
                                    <Setter Property="themes:FluidMotion.FadeTo" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchField}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                    <Setter Property="themes:FluidMotion.FadeTo" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Grid Margin="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <themes:SymbolIcon Size="16" Grid.Column="0" Data="{StaticResource Icon.Search}"
                          Style="{StaticResource Icon.Symbol.Muted}"
                          Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBox x:Name="SearchBox" Grid.Column="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="8,4" MinHeight="32"
                             ToolTip="{Binding SearchToolTip}"
                             AutomationProperties.Name="{loc:Text Text_4B8D541EBE6D}"
                             TextChanged="OnSearchTextChanged" />
                    <TextBlock Grid.Column="1" IsHitTestVisible="False"
                               Foreground="{DynamicResource Text.Muted}"
                               Margin="10,0"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding SearchPlaceholder}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Text" Value="{loc:Text Text_4B8D541EBE6D}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <!-- Right side: the library commands or the selection's commands, then More, which stays
                 in place either way so restoring and the library folder are reachable with a selection. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Library commands (nothing selected). -->
            <StackPanel x:Name="LibraryCommands" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button x:Name="NewFolderButton" Style="{StaticResource LibraryUx.CommandGhost}"
                        ToolTip="{loc:Text LibraryUx_NewFolderHint}" AutomationProperties.Name="{loc:Text Folder410.NewFolder}"
                        Click="OnNewFolderClick">
                    <StackPanel Orientation="Horizontal">
                        <themes:SymbolIcon Size="16" Data="{StaticResource LibraryUx.Icon.Folder}" Style="{StaticResource LibraryUx.CommandGlyph}" />
                        <TextBlock Text="{loc:Text Folder410.NewFolder}" Margin="{DynamicResource CommandButton.IconLabelGap}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ComboBox x:Name="SortBox" Width="132" Margin="2,0,4,0" VerticalAlignment="Center"
                          AutomationProperties.Name="{loc:Text Folder410.Sort}" ToolTip="{loc:Text Folder410.Sort}"
                          SelectedIndex="{Binding SortIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{loc:Text Folder410.Newest}" />
                    <ComboBoxItem Content="{loc:Text Folder410.Oldest}" />
                    <ComboBoxItem Content="{loc:Text Folder410.ByName}" />
                </ComboBox>
            </StackPanel>

            <!-- Selection commands, in the same place. -->
            <StackPanel x:Name="SelectionCommands" Orientation="Horizontal" VerticalAlignment="Center"
                        AutomationProperties.Name="{loc:Text LibraryUx_SelectionBarName}"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <Button x:Name="ClearSelectionButton" Style="{StaticResource LibraryUx.CommandIcon}"
                        ToolTip="{loc:Text LibraryUx_ClearSelectionHint}" AutomationProperties.Name="{loc:Text LibraryUx_ClearSelection}"
                        Click="OnClearSelectionClick">
                    <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Close}" Style="{StaticResource LibraryUx.CommandGlyph}" />
                </Button>
                <TextBlock x:Name="SelectionCountLabel" Text="{Binding SelectionText}" VerticalAlignment="Center" Margin="2,0,10,0"
                           FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                <Border Style="{StaticResource LibraryUx.CommandSeparator}" />
                <Button x:Name="ArchiveExportButton" Content="{loc:Text Library.Archive.Action}" Style="{StaticResource LibraryUx.CommandButton}"
                        Click="OnExportArchiveClick" ToolTip="{loc:Text Library.Archive.Hint}" />
                <Button x:Name="CompareSelectedButton" Content="{loc:Text Gallery.Compare}" Style="{StaticResource LibraryUx.CommandButton}"
                        Visibility="{Binding CanCompareSelected, Converter={StaticResource BoolToVisibility}}"
                        Command="{x:Static gallery:GalleryWindow.CompareCommand}" />
                <Button x:Name="MoveCapturesButton" Content="{loc:Text Folder410.MoveCaptures}" Style="{StaticResource LibraryUx.CommandButton}"
                        Click="OnMoveCapturesClick" ToolTip="{loc:Text LibraryUx_MoveHint}" />
                <Button x:Name="DeleteSelectedButton" Content="{loc:Text LibrarySelection_Delete}" Style="{StaticResource LibraryUx.CommandButton}"
                        Click="OnDeleteSelectedClick" ToolTip="{loc:Text LibraryUx_DeleteHint}" />
            </StackPanel>
            <Button x:Name="MoreCommandsButton" Style="{StaticResource LibraryUx.CommandIcon}"
                    ToolTip="{loc:Text Text_5E8959D18390}" AutomationProperties.Name="{loc:Text Text_5E8959D18390}"
                    Click="OnMoreCommandsClick">
                <themes:SymbolIcon Size="16" Data="{StaticResource Icon.More}" Style="{StaticResource LibraryUx.CommandGlyph}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem x:Name="ArchiveOverflowMenu" Header="{loc:Text Library.Archive.Action}" Click="OnExportArchiveClick"
                                  Visibility="Collapsed" />
                        <MenuItem x:Name="MoveOverflowMenu" Header="{loc:Text Folder410.MoveCaptures}" Click="OnMoveCapturesClick"
                                  InputGestureText="M" Visibility="Collapsed" />
                        <MenuItem x:Name="ContactSheetMenu" Header="{loc:Text ContactSheet.Action}" Click="OnContactSheetClick"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem x:Name="BatchTagsMenu" Header="{loc:Text Library.Tags.Edit}" Click="OnBatchTagsClick"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem x:Name="ReduceSelectedMenu" Header="{loc:Text LibrarySelection_Reduce}" Click="OnReducedExportClick"
                                  CommandParameter="{Binding SingleSelectedTile}"
                                  Visibility="{Binding CanReduceSelected, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem x:Name="GifSelectedMenu" Header="{loc:Text LibrarySelection_Gif}" Click="OnGifMenuClick"
                                  CommandParameter="{Binding SingleSelectedTile}"
                                  Visibility="{Binding CanGifSelected, Converter={StaticResource BoolToVisibility}}" />
                        <Separator Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem x:Name="ImportMenu" Header="{loc:Text Library.Import.Command}" Click="OnImportClick" />
                        <MenuItem x:Name="RestoreDeletedMenu" Header="{loc:Text LibraryRecovery_Recent}" />
                        <MenuItem x:Name="OpenLibraryFolderMenu" Header="{loc:Text LibraryFolder_OpenLibrary}" Click="OnOpenLibraryFolderClick" />
                        <Separator />
                        <MenuItem Header="{loc:Text LibrarySelection_ClearHint}" Click="OnClearLibraryClick"
                                  Foreground="{DynamicResource State.DangerHover}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
            <DockPanel Margin="6,0,6,8" LastChildFill="True"
                       Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVisibility}}">
                <Button DockPanel.Dock="Right" Content="{loc:Text Library.Search.ClearAll}"
                        Style="{StaticResource Button.Secondary}" Background="Transparent" BorderThickness="0"
                        VerticalAlignment="Top" Margin="8,0,0,0" Click="OnClearSearchConditionsClick" />
                <ItemsControl ItemsSource="{Binding SearchConditions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Button.Secondary}" Margin="0,0,6,4"
                                    MaxWidth="360" ToolTip="{Binding RemoveToolTip}"
                                    AutomationProperties.Name="{Binding RemoveToolTip}" Click="OnRemoveSearchConditionClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" MaxWidth="300" TextTrimming="CharacterEllipsis" />
                                    <themes:SymbolIcon Size="12" Data="{StaticResource Icon.Close}" Margin="6,0,0,0"
                                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

        <!-- OCR full-text search coverage banner (Row 1). Shown only when part of the
             library is not yet searchable by the text inside the images, or when no OCR
             language pack is installed. Collapsed by default; the code-behind sets its
             state when the gallery opens and after an indexing pass. -->
        <Border x:Name="OcrCoverageBanner" Grid.Row="1"
                Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="OcrCoverageHeadline"
                               Foreground="{DynamicResource Text.Primary}"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource FontSize.Body}" />
                    <TextBlock x:Name="OcrCoverageDetail"
                               Foreground="{DynamicResource Text.Secondary}"
                               FontSize="{StaticResource FontSize.Caption}"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap" MaxWidth="760"
                               HorizontalAlignment="Left" />
                </StackPanel>
                <!-- Outlined: the command bar already carries this screen's one filled button. -->
                <Button x:Name="OcrIndexButton" Grid.Column="1"
                        Style="{StaticResource Button.Secondary}"
                        Content="{loc:Text Text_C5364F392040}" MinHeight="34"
                        VerticalAlignment="Center" Margin="14,0,0,0"
                        ToolTip="{loc:Text Text_C8FFDDF126A8}"
                        AutomationProperties.Name="{loc:Text Text_4D5F7094119C}"
                        Click="OnOcrIndexClick" />
            </Grid>
        </Border>
        </StackPanel>

        <Grid Grid.Row="2" x:Name="GalleryWorkspace">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224" />
                <ColumnDefinition Width="*" />
                <!-- The details pane (240 with its gap) or, while it is hidden, its 56-DIP rail. -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Navigation pane on the window base, like the title bar above it. -->
            <Grid x:Name="GalleryFilterRail" Margin="0,0,10,0" AutomationProperties.Name="{loc:Text LibraryUx_NavName}"
                  SizeChanged="OnTagNavigationSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="96" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <RadioButton x:Name="AllLibraryFilter" Tag="All"
                                 IsChecked="{Binding IsAllItemsView, Mode=OneWay}" Checked="OnLibraryFilterChanged"
                                 ToolTip="{loc:Text LibraryUx_NavAllHint}" AutomationProperties.Name="{Binding AllItemsAccessibleName}">
                        <!-- Captures dropped here leave their folder; the item lights up like a folder target. -->
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource LibraryUx.NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAllItemsDropTarget}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Accent.Subtle}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Border.Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <themes:SymbolIcon Size="16" Data="{StaticResource LibraryUx.Icon.AllItems}" Style="{StaticResource LibraryUx.NavGlyph}" />
                            <TextBlock Grid.Column="1" Text="{loc:Text LibraryUx_NavAll}" Margin="10,0,8,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding AllItemsCount}" Style="{StaticResource LibraryUx.NavCount}" />
                        </Grid>
                    </RadioButton>
                    <RadioButton Style="{StaticResource LibraryUx.NavItem}" Tag="Images"
                                 IsChecked="{Binding IsImagesView, Mode=OneWay}" Checked="OnLibraryFilterChanged"
                                 AutomationProperties.Name="{Binding ImagesAccessibleName}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Image}" Style="{StaticResource LibraryUx.NavGlyph}" />
                            <TextBlock Grid.Column="1" Text="{loc:Text LibraryUx_NavImages}" Margin="10,0,8,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding ImageCount}" Style="{StaticResource LibraryUx.NavCount}" />
                        </Grid>
                    </RadioButton>
                    <RadioButton Style="{StaticResource LibraryUx.NavItem}" Tag="Videos"
                                 IsChecked="{Binding IsVideosView, Mode=OneWay}" Checked="OnLibraryFilterChanged"
                                 AutomationProperties.Name="{Binding VideosAccessibleName}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <themes:SymbolIcon Size="16" Data="{StaticResource LibraryUx.Icon.Video}" Style="{StaticResource LibraryUx.NavGlyph}" />
                            <TextBlock Grid.Column="1" Text="{loc:Text LibraryUx_NavVideos}" Margin="10,0,8,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding VideoCount}" Style="{StaticResource LibraryUx.NavCount}" />
                        </Grid>
                    </RadioButton>
                    <RadioButton Style="{StaticResource LibraryUx.NavItem}" Tag="Pinned"
                                 IsChecked="{Binding IsKeptView, Mode=OneWay}" Checked="OnLibraryFilterChanged"
                                 ToolTip="{loc:Text LibraryUx_NavKeptHint}" AutomationProperties.Name="{Binding KeptAccessibleName}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <themes:SymbolIcon Size="16" Data="{StaticResource LibraryUx.Icon.Kept}" Style="{StaticResource LibraryUx.NavGlyph}" />
                            <TextBlock Grid.Column="1" Text="{loc:Text LibraryUx_NavKept}" Margin="10,0,8,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding KeptCount}" Style="{StaticResource LibraryUx.NavCount}" />
                        </Grid>
                    </RadioButton>
                </StackPanel>

                <Expander Grid.Row="2" Style="{StaticResource LibraryUx.Section}"
                          Header="{loc:Text Library.SavedSearch.Title}" IsExpanded="True" Margin="0,0,0,4">
                    <DockPanel>
                        <Button x:Name="SaveSearchButton" DockPanel.Dock="Top" Content="{loc:Text Library.SavedSearch.Save}"
                                Style="{StaticResource LibraryUx.CommandButton}" HorizontalAlignment="Left" Click="OnSaveSearchClick" />
                        <ScrollViewer MaxHeight="144" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="SavedSearchList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource LibraryUx.CommandButton}" HorizontalContentAlignment="Left"
                                                Click="OnApplySavedSearchClick" ToolTip="{Binding Query}" AutomationProperties.Name="{Binding Name}">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{loc:Text Library.SavedSearch.Rename}" Click="OnRenameSavedSearchClick" />
                                                    <MenuItem Header="{loc:Text Library.SavedSearch.Delete}" Click="OnDeleteSavedSearchClick" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Expander>

                <Expander x:Name="TagSection" Grid.Row="1" Style="{StaticResource LibraryUx.Section}"
                          Header="{loc:Text Library.Tags.Title}" IsExpanded="True" Margin="0,0,0,4">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="{loc:Text Library.Tags.More}" Style="{StaticResource LibraryUx.CommandButton}" HorizontalAlignment="Left"
                                Click="OnMoreTagsClick" Visibility="{Binding HasMoreTags, Converter={StaticResource BoolToVisibility}}" />
                        <ScrollViewer MaxHeight="304" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding VisibleTags}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource LibraryUx.NavItem}"
                                                     IsChecked="{Binding IsSelected, Mode=OneWay}" Click="OnTagClick"
                                                     ToolTip="{Binding Name}" AutomationProperties.Name="{Binding AccessibleName}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Margin="0,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Count}" Style="{StaticResource LibraryUx.NavCount}" />
                                            </Grid>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Expander>

                <!-- "폴더" section head: the retention rule is a tooltip, [+] creates a folder here. -->
                <Grid Grid.Row="3" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" Background="Transparent"
                                ToolTip="{Binding FolderSectionToolTip}">
                        <TextBlock Text="{loc:Text Folder410.Title}" Style="{StaticResource LibraryUx.SectionLabel}" />
                        <themes:SymbolIcon Size="16" Data="{StaticResource LibraryUx.Icon.Info}" Style="{StaticResource Icon.Symbol.Muted}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="NewFolderPaneButton" Grid.Column="1" Style="{StaticResource Button.GhostCompact}"
                            ToolTip="{loc:Text LibraryUx_NewFolderHint}" AutomationProperties.Name="{loc:Text Folder410.NewFolder}"
                            Click="OnNewFolderClick">
                        <themes:SymbolIcon Size="16" Data="{StaticResource LibraryUx.Icon.Add}" Style="{StaticResource LibraryUx.CommandGlyph}" />
                    </Button>
                </Grid>

                <TreeView x:Name="FolderTree" Grid.Row="4" ItemsSource="{Binding FolderRoots}" Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource Text.Primary}"
                          AutomationProperties.Name="{loc:Text Folder410.Title}"
                          AutomationProperties.HelpText="{loc:Text LibraryUx_FoldersHint}"
                          ItemTemplate="{StaticResource Gallery.FolderNodeTemplate}"
                          ItemContainerStyle="{StaticResource LibraryUx.TreeItem}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                          SelectedItemChanged="OnFolderSelected" PreviewKeyDown="OnFolderTreeKeyDown"
                          PreviewMouseLeftButtonDown="OnFolderPointerDown" />

                <Expander x:Name="DateSection" Grid.Row="5" Style="{StaticResource LibraryUx.Section}" Margin="0,6,0,0"
                          Header="{loc:Text LibraryUx_DatesHeader}" IsExpanded="False">
                    <ListBox x:Name="DateList" ItemsSource="{Binding FolderNodes}" MaxHeight="220"
                             ItemTemplate="{StaticResource LibraryUx.DateItemTemplate}"
                             ItemContainerStyle="{StaticResource LibraryUx.DateItem}"
                             AutomationProperties.Name="{loc:Text LibraryUx_DatesHeader}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="False"
                             SelectionChanged="OnDateSelected" PreviewKeyDown="OnFolderTreeKeyDown" />
                </Expander>
            </Grid>


            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Location header inside a folder or date: the way back and the name on the left,
                     the folder's "save new captures here" switch at the right end. -->
                <Grid x:Name="LocationHeader" Height="44" Margin="2,0,0,4" ClipToBounds="True"
                      Visibility="{Binding ShowLocationHeader, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ItemsControl x:Name="LocationBreadcrumb" ItemsSource="{Binding Breadcrumb}" Focusable="False"
                                      ItemTemplate="{StaticResource LibraryUx.BreadcrumbTemplate}"
                                      AutomationProperties.Name="{loc:Text LibraryUx_BreadcrumbName}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <CheckBox x:Name="CurrentFolderCaptureCheck" Grid.Column="1" Style="{StaticResource LibraryUx.SaveHereSwitch}" Margin="12,0,4,0"
                              Content="{loc:Text LibraryUx_SaveHere}" ToolTip="{Binding SaveHereToolTip}"
                              IsEnabled="{Binding CanChangeNewCaptureFolder}"
                              IsChecked="{Binding SavesNewCapturesHere, Mode=OneWay}" Click="OnFolderCaptureTargetClick"
                              Visibility="{Binding ShowSaveHere, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <Border x:Name="ImportOverlay" Grid.Row="1" Panel.ZIndex="10" Visibility="Collapsed"
                        IsHitTestVisible="False" Background="{DynamicResource Surface.Raised}"
                        BorderBrush="{DynamicResource Text.Secondary}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Lg}" Padding="24">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                        <TextBlock x:Name="ImportOverlayTitle" Text="{loc:Text Library.Import.DropTitle}"
                                   Style="{DynamicResource Text.Title}" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Text="{loc:Text Library.Import.DropDetail}" Margin="0,8,0,0"
                                   Style="{DynamicResource Text.MutedBlock}" TextWrapping="Wrap" TextAlignment="Center" />
                        <ProgressBar x:Name="ImportProgress" Visibility="Collapsed" Height="6" Margin="0,16,0,0"
                                     Foreground="{DynamicResource Accent.Default}" Background="{DynamicResource Surface.Sunken}" />
                        <Button x:Name="ImportCancelButton" Content="{loc:Text Library.Action.Cancel}"
                                Visibility="Collapsed" Click="OnCancelImportClick" Margin="0,16,0,0"
                                Style="{StaticResource Button.Secondary}" />
                    </StackPanel>
                </Border>
                <ListBox x:Name="RowsList" Grid.Row="1"
                         Style="{StaticResource Gallery.RowsList}"
                         ItemsSource="{Binding Rows}"
                         SizeChanged="OnRowsListSizeChanged" />

                <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource Card}" Padding="42,30"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel MaxWidth="380">
                        <TextBlock Text="{Binding EmptyStateTitle}"
                                   Style="{DynamicResource Text.Title}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyStateLabel"
                                   Text="{Binding EmptyStateText}"
                                   Style="{DynamicResource Text.MutedBlock}"
                                   Margin="0,8,0,0"
                                   TextAlignment="Center"
                                   AutomationProperties.Name="{Binding EmptyStateText}" TextWrapping="Wrap" />
                        <!-- Outlined: the command bar's capture is this screen's filled button. -->
                        <Button Content="{loc:Text Text_2C20ADDA2018}" Style="{StaticResource Button.Secondary}" Click="OnCaptureRegionClick" Margin="0,16,0,0" Visibility="{Binding QueueIsEmpty, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{loc:Text Library.Search.ClearConditions}" Click="OnClearLibrarySearchClick" Margin="0,16,0,0"
                                Style="{StaticResource Button.Secondary}"
                                Visibility="{Binding CanResetEmptySearch, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- After the library content, so Tab follows the visual order: pane, content, details.
                 The selected capture's preview, title and main commands stay at the top; only the
                 information below them scrolls, and nothing inside it scrolls on its own. -->
            <Border x:Name="GalleryDetailsRail" Grid.Column="2" Width="48" Margin="8,0,0,0" Padding="7" Visibility="Collapsed"
                    Background="{DynamicResource Surface.Raised}" CornerRadius="{StaticResource Radius.Lg}"
                    AutomationProperties.Name="{loc:Text Workspace.Details}">
                <Button x:Name="ShowDetailsButton" Style="{StaticResource Button.Icon.Compact}" VerticalAlignment="Top"
                        ToolTip="{loc:Text LibraryUx_DetailsShow}" AutomationProperties.Name="{loc:Text LibraryUx_DetailsShow}"
                        Click="OnShowDetailsClick">
                    <themes:SymbolIcon Size="16" Data="{StaticResource LibraryUx.Icon.DetailsPane}" Style="{StaticResource LibraryUx.CommandGlyph}" />
                </Button>
            </Border>
            <Border x:Name="GalleryDetailsPanel" Grid.Column="2" Width="232" Margin="8,0,0,0" Padding="16"
                    Background="{DynamicResource Surface.Raised}" CornerRadius="{StaticResource Radius.Lg}"
                    AutomationProperties.Name="{loc:Text Workspace.Details}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Hiding the pane gives the library its width; the rail left behind brings it back. -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="GalleryDetailsHeading" Text="{loc:Text Workspace.Details}" Style="{DynamicResource Text.Section}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button x:Name="HideDetailsButton" Grid.Column="1" Style="{StaticResource Button.Icon.Compact}" Margin="8,-6,-6,-6"
                                ToolTip="{loc:Text LibraryUx_DetailsHide}" AutomationProperties.Name="{loc:Text LibraryUx_DetailsHide}"
                                Click="OnHideDetailsClick">
                            <themes:SymbolIcon Size="16" Data="{StaticResource LibraryUx.Icon.DetailsPane}" Style="{StaticResource LibraryUx.CommandGlyph}" />
                        </Button>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{loc:Text Workspace.SelectHint}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SingleSelectedTile}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid x:Name="GalleryDetailsContent" Grid.Row="1" DataContext="{Binding SingleSelectedTile}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <!-- The preview gives up height first in a short window; the commands never move. -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="72" MaxHeight="136" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource Surface.Sunken}" CornerRadius="{StaticResource Radius.Md}">
                            <Image x:Name="SelectedDetailThumbnail" Source="{Binding Thumbnail}" Stretch="Uniform"
                                   AutomationProperties.Name="{Binding AccessibleName}" />
                        </Border>
                        <TextBlock Grid.Row="1" AutomationProperties.AutomationId="LibraryDetailsTitle" Margin="0,12,0,0"
                                   FontWeight="SemiBold" ToolTip="{Binding ContextLabel}"
                                   gallery:GalleryTextClamp.MaxLines="2" gallery:GalleryTextClamp.Text="{Binding ContextLabel}" />

                        <!-- Main commands: Edit is the panel's one filled button; pin and copy share a row. -->
                        <StackPanel Grid.Row="2" AutomationProperties.AutomationId="LibraryDetailsActions" Margin="0,16,0,0">
                            <Button x:Name="DetailsEditButton" Content="{Binding ActionLabel}" Style="{StaticResource Button.Primary}"
                                    Click="OnEditClick" />
                            <Grid Margin="0,8,0,0" Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DetailsFloatButton" Style="{StaticResource Button.Secondary}"
                                        ToolTip="{loc:Text Gallery.FloatHint}" AutomationProperties.Name="{loc:Text Gallery.Float}"
                                        Click="OnFloatClick">
                                    <StackPanel Orientation="Horizontal">
                                        <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Pin}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Fill="Transparent" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Text QuickAccess.Pin}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DetailsCopyButton" Grid.Column="2" Style="{StaticResource Button.Secondary}"
                                        ToolTip="{loc:Text Text_59D43391538F}" AutomationProperties.Name="{loc:Text Text_42A667BC71B0}"
                                        Click="OnCopyClick">
                                    <StackPanel Orientation="Horizontal">
                                        <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Copy}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Fill="Transparent" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Text QuickAccess.Copy}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Information only: the panel's one scrolling area. -->
                        <ScrollViewer x:Name="GalleryDetailsScroll" Grid.Row="3" Margin="0,16,0,0" Focusable="False"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <StackPanel AutomationProperties.AutomationId="LibraryDetailsInfo">
                                    <TextBlock Text="{Binding TimeCaption}" Foreground="{DynamicResource Text.Secondary}" />
                                    <TextBlock Text="{Binding DetailDimensions}" Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding RetentionCaption}" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock AutomationProperties.AutomationId="LibraryDetailsTags" Foreground="{DynamicResource Text.Secondary}"
                                               Margin="0,0,0,8" ToolTip="{Binding TagsCaption}"
                                               gallery:GalleryTextClamp.MaxLines="2" gallery:GalleryTextClamp.Text="{Binding TagsCaption}"
                                               Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="{loc:Text Library.Organize.Action}" Style="{StaticResource Button.Secondary}"
                                            Click="OnOrganizeClick" ToolTip="F2" />
                                </StackPanel>
                                <!-- Source: the app and window a capture came from, and its web page or folder when known. Long
                                     addresses and paths show two lines with "show all" and a copy command, never a nested scroller. -->
                                <StackPanel AutomationProperties.AutomationId="LibrarySourceSection" AutomationProperties.Name="{loc:Text Library.Source.Label}"
                                            Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                                    <StackPanel.Resources>
                                        <!-- A quiet text toggle beside a value's label; expanded is not a selected state. -->
                                        <Style x:Key="LibrarySource.ExpandToggle" TargetType="ToggleButton">
                                            <Setter Property="Content" Value="{loc:Text Library.Source.ShowAll}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Padding" Value="6,2" />
                                            <Setter Property="MinHeight" Value="{DynamicResource Size.HitTarget.Compact}" />
                                            <Setter Property="Margin" Value="8,0,0,0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <!-- Hover and press washes fade over the whole chip; the contrast-theme
                                                             hover outline (Border.Hover, transparent otherwise) fades with them. The
                                                             outline is its own layer so the washes keep filling the whole chip. -->
                                                        <Grid>
                                                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius.Sm}" />
                                                            <Border x:Name="HoverLayer" Style="{StaticResource LibraryUx.HoverWash}" CornerRadius="{DynamicResource Radius.Sm}" />
                                                            <Border x:Name="PressedLayer" Style="{StaticResource StateLayer.Pressed}" CornerRadius="{DynamicResource Radius.Sm}" />
                                                            <Border x:Name="HoverOutline" Style="{StaticResource StateLayer}" BorderThickness="1"
                                                                    CornerRadius="{DynamicResource Radius.Sm}" />
                                                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Border x:Name="FocusRing" BorderBrush="{DynamicResource Border.Focus}" BorderThickness="1"
                                                                    CornerRadius="{DynamicResource Radius.Sm}" IsHitTestVisible="False" Opacity="0" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                                                                <Setter TargetName="HoverOutline" Property="themes:FluidMotion.FadeTo" Value="1" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="PressedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                                                            </Trigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Content" Value="{loc:Text Library.Source.ShowLess}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Resources>
                                    <TextBlock Text="{loc:Text Library.Source.Label}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBlock AutomationProperties.AutomationId="LibrarySourceApp" Text="{Binding SourceAppName}" TextWrapping="Wrap"
                                               ToolTip="{Binding SourceAppToolTip}" AutomationProperties.Name="{Binding SourceAppAutomationName}"
                                               Visibility="{Binding HasSourceApp, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock AutomationProperties.AutomationId="LibrarySourceWindow" Margin="0,2,0,0"
                                               Foreground="{DynamicResource Text.Secondary}" ToolTip="{Binding SourceWindowTitle}"
                                               gallery:GalleryTextClamp.MaxLines="2" gallery:GalleryTextClamp.Text="{Binding SourceWindowTitle}"
                                               AutomationProperties.Name="{Binding SourceWindowTitleAutomationName}"
                                               Visibility="{Binding HasSourceWindowTitle, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel AutomationProperties.AutomationId="LibrarySourcePage" Margin="0,12,0,0"
                                                Visibility="{Binding HasSourcePageUrl, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SourcePageLabel" Text="{loc:Text Library.SourcePage.Label}" Foreground="{DynamicResource Text.Muted}"
                                                       FontSize="{StaticResource FontSize.Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <ToggleButton x:Name="SourcePageToggle" Grid.Column="1" Style="{StaticResource LibrarySource.ExpandToggle}"
                                                          AutomationProperties.AutomationId="LibrarySourcePageToggle"
                                                          AutomationProperties.Name="{loc:Text Library.SourcePage.ShowFull}"
                                                          gallery:GalleryTextClamp.ToggleTarget="{Binding ElementName=SourcePageValue}" />
                                        </Grid>
                                        <TextBlock x:Name="SourcePageValue" AutomationProperties.AutomationId="LibrarySourcePageValue" Margin="0,2,0,0"
                                                   FontSize="{StaticResource FontSize.Control}" ToolTip="{Binding SourcePageUrl}"
                                                   AutomationProperties.Name="{Binding SourcePageUrlAutomationName}"
                                                   gallery:GalleryTextClamp.MaxLines="2" gallery:GalleryTextClamp.Text="{Binding SourcePageUrl}" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="{loc:Text Library.SourcePage.Open}" Style="{StaticResource Button.Secondary}" Click="OnOpenSourcePageClick" Margin="0,0,8,8" />
                                            <Button Content="{loc:Text Library.SourcePage.Copy}" Style="{StaticResource Button.Secondary}" Click="OnCopySourcePageClick" Margin="0,0,0,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <TextBlock AutomationProperties.AutomationId="LibrarySourceUnsaved" Margin="0,12,0,0"
                                               Text="{loc:Text Library.Source.UnsavedDocument}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               Visibility="{Binding HasUnsavedSourceDocument, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel AutomationProperties.AutomationId="LibrarySourceLocation" Margin="0,12,0,0"
                                                Visibility="{Binding HasSourceDocumentPath, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SourcePathLabel" Text="{loc:Text Library.Source.Location}" Foreground="{DynamicResource Text.Muted}"
                                                       FontSize="{StaticResource FontSize.Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <ToggleButton x:Name="SourcePathToggle" Grid.Column="1" Style="{StaticResource LibrarySource.ExpandToggle}"
                                                          AutomationProperties.AutomationId="LibrarySourcePathToggle"
                                                          AutomationProperties.Name="{loc:Text Library.Source.ShowFullPath}"
                                                          gallery:GalleryTextClamp.ToggleTarget="{Binding ElementName=SourcePathValue}" />
                                        </Grid>
                                        <TextBlock x:Name="SourcePathValue" AutomationProperties.AutomationId="LibrarySourcePathValue" Margin="0,2,0,0"
                                                   FontSize="{StaticResource FontSize.Control}" ToolTip="{Binding SourceDocumentPath}"
                                                   AutomationProperties.Name="{Binding SourceDocumentPathAutomationName}"
                                                   gallery:GalleryTextClamp.MiddleEllipsis="{Binding IsSourceDocumentFile}"
                                                   gallery:GalleryTextClamp.MaxLines="2" gallery:GalleryTextClamp.Text="{Binding SourceDocumentPath}" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="{loc:Text Library.Source.OpenFile}" Style="{StaticResource Button.Secondary}" Click="OnOpenSourceFileClick" Margin="0,0,8,8"
                                                    Visibility="{Binding IsSourceDocumentFile, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="{Binding SourceLocationAction}" Style="{StaticResource Button.Secondary}" Click="OnOpenSourceFolderClick" Margin="0,0,8,8" />
                                            <Button Content="{loc:Text Library.Source.CopyPath}" Style="{StaticResource Button.Secondary}" Click="OnCopySourcePathClick" Margin="0,0,0,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{loc:Text Workspace.EditHint}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}"
                                           FontSize="{StaticResource FontSize.Caption}" Margin="0,16,0,0"
                                           Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{loc:Text Workspace.VideoHint}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}"
                                           FontSize="{StaticResource FontSize.Caption}" Margin="0,16,0,0"
                                           Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status line: the library summary and the last action's result, which fades out on its own. -->
        <Grid x:Name="LibraryStatusBar" Grid.Row="3" MinHeight="26" Margin="4,6,2,0"
              AutomationProperties.Name="{loc:Text LibraryUx_StatusName}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="SummaryLabel" Text="{Binding SummaryText}" Style="{StaticResource StatusBar.Text}"
                           Foreground="{DynamicResource Text.Muted}" AutomationProperties.Name="{Binding SummaryText}" />
                <TextBlock Text="  ·  " Style="{StaticResource StatusBar.Text}" Foreground="{DynamicResource Text.Muted}" />
                <TextBlock x:Name="FolderStorageLabel" Text="{Binding FolderStorageText}" Style="{StaticResource StatusBar.Text}"
                           Foreground="{DynamicResource Text.Muted}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowResultCount, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="  ·  " Style="{StaticResource StatusBar.Text}" Foreground="{DynamicResource Text.Muted}" />
                    <TextBlock x:Name="ResultCountLabel" Text="{Binding ResultCountText}" Style="{StaticResource StatusBar.Text}"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowNewCaptureDestination, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="  ·  " Style="{StaticResource StatusBar.Text}" Foreground="{DynamicResource Text.Muted}" />
                    <TextBlock x:Name="NewCaptureDestinationLabel" Text="{Binding NewCaptureDestinationText}" MaxWidth="320"
                               ToolTip="{Binding NewCaptureDestinationText}" Style="{StaticResource StatusBar.Text}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowFolderStorageInfo, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{loc:Text Folder410.StorageInfo}" Background="Transparent">
                    <TextBlock Text="  ·  " Style="{StaticResource StatusBar.Text}" Foreground="{DynamicResource Text.Muted}" />
                    <themes:SymbolIcon Size="16" Data="{StaticResource LibraryUx.Icon.Info}"
                          Stroke="{DynamicResource State.Warning}" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Text Folder410.StorageInfo}" Margin="6,0,0,0" MaxWidth="360"
                               Style="{StaticResource StatusBar.Text}" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="LibraryActionStatus" Grid.Column="1" Margin="16,0,0,0" TextWrapping="Wrap" TextAlignment="Right"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource Text.Secondary}" FontSize="{StaticResource FontSize.Caption}"
                       AutomationProperties.LiveSetting="Polite" />
            <!-- The result's own follow-up (Undo after a delete, Change after the first automatic
                 deletion); hidden whenever the line shows anything else. -->
            <StackPanel x:Name="LibraryStatusActionPanel" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed"
                        VerticalAlignment="Center">
                <TextBlock Text="·" Margin="6,0,2,0" VerticalAlignment="Center" Foreground="{DynamicResource Text.Muted}"
                           FontSize="{StaticResource FontSize.Caption}" />
                <Button x:Name="LibraryStatusAction" Style="{StaticResource Button.GhostCompact}"
                        VerticalAlignment="Center" FontWeight="SemiBold" Click="OnStatusActionClick" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button x:Name="ArchiveCancelButton" Content="{loc:Text Library.Action.Cancel}"
                        Style="{StaticResource Button.GhostCompact}" Click="OnCancelArchiveClick" Visibility="Collapsed" Margin="8,0,0,0" />
                <Button x:Name="ActivityButton" Style="{StaticResource Button.GhostCompact}" Click="OnActivityClick"
                        Visibility="Collapsed" Margin="8,0,0,0" AutomationProperties.Name="{loc:Text Library.Activity.Title}" />
                <Popup x:Name="ActivityPopup" PlacementTarget="{Binding ElementName=ActivityButton}" Placement="Top"
                       StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{DynamicResource Surface.Floating}" BorderBrush="{DynamicResource Border.Control}"
                            BorderThickness="1" Padding="12">
                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ActivityRows" />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </StackPanel>
        </Grid>

        <!-- Pointer-side drop label ("제품리뷰 폴더로 이동 · 2개"), like Explorer's "Move to" hint. -->
        <Canvas x:Name="DragHintLayer" Grid.RowSpan="4" IsHitTestVisible="False" Panel.ZIndex="10">
            <Border x:Name="DragHint" Visibility="Collapsed" Padding="10,6" CornerRadius="6"
                    Background="{DynamicResource Surface.Floating}" BorderBrush="{DynamicResource Border.Accent}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <themes:SymbolIcon StrokeThickness="0" Size="16" Data="{StaticResource LibraryUx.Icon.Folder}"
                          Fill="{DynamicResource Accent.Folder}" VerticalAlignment="Center" />
                    <TextBlock x:Name="DragHintText" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
