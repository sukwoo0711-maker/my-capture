<Window x:Class="MyCapture.App.Gallery.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:MyCapture.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:MyCapture.App.Themes"
        xmlns:gallery="clr-namespace:MyCapture.App.Gallery"
        x:ClassModifier="internal"
        Style="{DynamicResource Window.Standard}"
        Title="{loc:Text Text_37AD4F28D422}"
        Width="1280" Height="760"
        MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface.Base}"
        Foreground="{DynamicResource Text.Primary}">

    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <themes:GalleryWorkspaceResources />
        </ResourceDictionary.MergedDictionaries>

        <!-- Local, so hosts that supply only the shared converters still load this window. -->
        <gallery:IsFolderRowConverter x:Key="IsFolderRow" />
        <gallery:HasValueToVisibilityConverter x:Key="LibraryUx.HasValue" />

        <!-- Tile action glyphs come from the shared Symbols.xaml resource dictionary
             (Icon.Copy / Icon.Pin / Icon.More / Icon.Ocr / Icon.Delete), referenced by key. -->

        <!-- Gallery actions inherit the shared icon-only states and retain a compact grid fit. -->
        <Style x:Key="Gallery.IconButton" TargetType="Button" BasedOn="{StaticResource Button.Icon.Compact}">
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <ContextMenu x:Key="Gallery.FolderContextMenu" x:Shared="False" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{loc:Text Folder410.NewFolder}" CommandParameter="{Binding}"
                      InputGestureText="Ctrl+Shift+N" Click="OnNewFolderClick" />
            <MenuItem Header="{loc:Text Folder410.Rename}" CommandParameter="{Binding}"
                      IsEnabled="{Binding IsFolder}" InputGestureText="F2" Click="OnRenameFolderClick" />
            <MenuItem Header="{loc:Text Folder410.MoveFolder}" CommandParameter="{Binding}"
                      IsEnabled="{Binding IsFolder}" InputGestureText="M" Click="OnMoveFolderClick" />
            <Separator />
            <MenuItem Header="{loc:Text Folder410.FolderExport}" CommandParameter="{Binding}" Click="OnExportFolderClick" />
            <MenuItem Header="{loc:Text Folder410.ZipExport}" CommandParameter="{Binding}" Click="OnExportFolderZipClick" />
            <Separator />
            <MenuItem Header="{Binding DeleteLabel, FallbackValue={loc:Text Folder410.Delete}}" CommandParameter="{Binding}"
                      InputGestureText="Delete" Foreground="{DynamicResource State.DangerHover}"
                      Click="OnDeleteFolderClick" />
        </ContextMenu>

        <!-- The capture card's overflow menu, shared by the full and compact cards. It inherits the
             More button's DataContext (the tile view model) via PlacementTarget, and each item
             carries the tile as CommandParameter so the handler always resolves the right record
             even though menu items are outside the visual tree. -->
        <ContextMenu x:Key="Gallery.TileContextMenu" x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{Binding IsPinned, Converter={StaticResource PinLabel}}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="{loc:Text LibraryUx_KeepToggleName}"
                      InputGestureText="P"
                      Click="OnPinMenuClick" />
            <MenuItem Header="{loc:Text Text_854582314EBD}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="{loc:Text Text_854582314EBD}"
                      InputGestureText="T"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}"
                      Click="OnOcrMenuClick">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon.Ocr}" Width="18" Height="18"
                          Stretch="Uniform"
                          Stroke="{DynamicResource Text.Secondary}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Fill="Transparent" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Text Text_D44617983641}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="{loc:Text Text_D44617983641}"
                      InputGestureText="G"
                      Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}"
                      Click="OnGifMenuClick" />
            <MenuItem Header="{loc:Text Folder410.MoveCaptures}" CommandParameter="{Binding}"
                      InputGestureText="M" Click="OnMoveCapturesClick" />
            <Separator />
            <MenuItem Header="{loc:Text ExportReduction_Title}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="{loc:Text ExportReduction_Title}"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}"
                      Click="OnReducedExportClick" />
            <MenuItem Header="{loc:Text Text_6139B6C3ED73}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="{loc:Text Text_6139B6C3ED73}"
                      InputGestureText="Delete"
                      Foreground="{DynamicResource State.DangerHover}"
                      Click="OnDeleteMenuClick">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon.Delete}" Width="18" Height="18"
                          Stretch="Uniform"
                          Stroke="{DynamicResource State.DangerHover}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Fill="Transparent" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Declared ahead of the card templates, which use it for the folder badge. -->
        <PathGeometry x:Key="LibraryUx.Icon.Folder"
                      Figures="M2.75,5.25 A1.25,1.25 0 0 1 4,4 L7.6,4 L9.4,5.75 L16,5.75 A1.25,1.25 0 0 1 17.25,7 L17.25,14.75 A1.25,1.25 0 0 1 16,16 L4,16 A1.25,1.25 0 0 1 2.75,14.75 Z" />

        <!-- A search or the image, video and kept views list captures from every folder; a card
             filed in a folder other than the one open names it, so the result says where it lives. -->
        <Style x:Key="Gallery.FolderBadge" TargetType="Border">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource Surface.BadgeStrong}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="{Binding HasFolderBadge, Converter={StaticResource BoolToVisibility}}" />
        </Style>

        <DataTemplate x:Key="Gallery.FolderBadgeContent" DataType="{x:Type gallery:GalleryItemViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource LibraryUx.Icon.Folder}" Width="12" Height="12" Stretch="Uniform"
                      Fill="{DynamicResource Accent.Folder}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding FolderBadge}" Margin="4,0,0,0"
                           Foreground="{DynamicResource Text.Badge}" FontSize="{StaticResource FontSize.Caption}"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Gallery.TileTemplate" DataType="{x:Type gallery:GalleryItemViewModel}">
            <!-- A 244px tile plus 6px margins and the item's 2px selection outline occupies the
                 260px track of GalleryRowBuilder.TileTrackWidth. A narrow window shows fewer
                 cards per row, down to one, instead of shrinking the image or its action targets. -->
            <Border Width="244" Height="292" Margin="6"
                    Background="{DynamicResource Surface.Raised}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Lg}"
                    SnapsToDevicePixels="True">
                <Grid Margin="9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="3,0,3,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TimeCaption}" Foreground="{DynamicResource Text.Secondary}" FontFamily="{StaticResource Font.Mono}" />
                        <Border Grid.Column="1" CornerRadius="4" Padding="5,2" BorderThickness="1" BorderBrush="{DynamicResource State.Warning}" Visibility="{Binding IsExpiringSoon, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding RetentionCaption}" Foreground="{DynamicResource Text.Primary}" FontSize="{StaticResource FontSize.Caption}" />
                        </Border>
                    </Grid>
                    <!-- Capture time is always above the image. -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Md}"
                            ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Thumbnail}"
                                   Margin="2"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="{Binding AccessibleName}" />
                            <TextBlock Text="{Binding PreviewUnavailableText}"
                                       Style="{DynamicResource Text.MutedBlock}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsBroken, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Video records remain image-light in the grid: a generated first-frame
                                 preview plus an unmistakable play affordance and exact duration. -->
                            <Border Width="52" Height="52" CornerRadius="26"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{DynamicResource Surface.Badge}"
                                    BorderBrush="{DynamicResource Border.Badge}" BorderThickness="1"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                <Path Data="{StaticResource Icon.Play}"
                                      Width="24" Height="24" Stretch="Uniform"
                                      Fill="{DynamicResource Text.Badge}"
                                      Stroke="{DynamicResource Text.Badge}" StrokeThickness="1.2"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="8" Padding="7,3" CornerRadius="5"
                                    Background="{DynamicResource Surface.BadgeStrong}"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding DurationCaption}"
                                           Foreground="{DynamicResource Text.Badge}"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="{StaticResource FontSize.Caption}" />
                            </Border>

                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Margin="8" Padding="7,3" CornerRadius="5"
                                    Background="{DynamicResource Surface.BadgeStrong}"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Text Text_C11734267E6B}" Foreground="{DynamicResource Text.Badge}"
                                           FontSize="{StaticResource FontSize.Caption}"
                                           FontWeight="SemiBold" />
                            </Border>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Margin="8" Padding="7,3" CornerRadius="5"
                                    Background="{DynamicResource Surface.BadgeStrong}"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Text Text_302BAE127938}" Foreground="{DynamicResource Text.Badge}"
                                           FontSize="{StaticResource FontSize.Caption}"
                                           FontWeight="SemiBold" />
                            </Border>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="8">
                                <Border Padding="8,4" CornerRadius="6" Margin="0,0,6,0"
                                        Background="{DynamicResource Accent.Default}"
                                        Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{loc:Text LibraryUx_KeptBadge}" FontSize="{StaticResource FontSize.Caption}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.OnAccent}" />
                                </Border>
                                <Border x:Name="FolderBadge" Style="{StaticResource Gallery.FolderBadge}" MaxWidth="120">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Gallery.FolderBadgeContent}" />
                                </Border>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="8" Padding="8,4" CornerRadius="6"
                                    Background="{DynamicResource Surface.Floating}"
                                    BorderBrush="{DynamicResource Border.Subtle}"
                                    BorderThickness="1"
                                    Visibility="{Binding HasAnnotations, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Text Text_2C64DDA4D878}" FontSize="{StaticResource FontSize.Caption}"
                                           Foreground="{DynamicResource Text.Secondary}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Caption + time -->
                    <Grid Grid.Row="2" Margin="3,9,3,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Caption}"
                                   Visibility="{Binding HasCaption, Converter={StaticResource BoolToVisibility}}"
                                   Foreground="{DynamicResource Text.Primary}"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSize.Body}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />

                    </Grid>

                    <!-- Visible Float / Copy / Edit, then delete and overflow. -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource Gallery.IconButton}"
                                Margin="0"
                                ToolTip="{loc:Text Gallery.FloatHint}"
                                AutomationProperties.Name="{loc:Text Gallery.Float}"
                                Click="OnFloatClick"
                                Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                            <Path Data="{StaticResource Icon.Pin}" Width="20" Height="20"
                                  Stretch="None"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Fill="Transparent" />
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource Gallery.IconButton}"
                                ToolTip="{loc:Text Text_59D43391538F}"
                                AutomationProperties.Name="{loc:Text Text_42A667BC71B0}"
                                Click="OnCopyClick"
                                Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                            <Path Data="{StaticResource Icon.Copy}" Width="20" Height="20"
                                  Stretch="None"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Fill="Transparent" />
                        </Button>

                        <!-- Borderless like the other card tools: the details panel owns the one filled Edit. -->
                        <Button Grid.Column="2" Style="{StaticResource Gallery.IconButton}"
                                Margin="0" HorizontalAlignment="Center"
                                ToolTip="{loc:Text Text_0400CF56D074}"
                                AutomationProperties.Name="{loc:Text Text_1003CFC78E66}"
                                Click="OnEditClick">
                            <Path Data="{StaticResource Icon.Edit}" Width="20" Height="20" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round" Fill="Transparent" />
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource Gallery.IconButton}"
                                ToolTip="{loc:Text Text_784572D51B63}"
                                AutomationProperties.Name="{loc:Text Text_89D4979D7596}"
                                Click="OnDeleteClick">
                            <Path Data="{StaticResource Icon.Delete}" Width="20" Height="20"
                                  Stretch="None"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Fill="Transparent" />
                        </Button>

                        <Button Grid.Column="4"
                                Style="{StaticResource Gallery.IconButton}"
                                ToolTip="{loc:Text LibraryUx_TileMoreHint}"
                                AutomationProperties.Name="{loc:Text Text_5E8959D18390}"
                                ContextMenu="{StaticResource Gallery.TileContextMenu}"
                                Click="OnMoreClick">
                            <Path Data="{StaticResource Icon.More}" Width="20" Height="20"
                                  Stretch="None"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="Gallery.TileRowList" TargetType="ListBox">
            <!-- Rows have no independent scrolling surface: wheel input reaches RowsList. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
            <Setter Property="ItemTemplate" Value="{StaticResource Gallery.TileTemplate}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        <Setter Property="gallery:GalleryCaptionPreview.IsEnabled" Value="True" />
                        <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
                        <Setter Property="ToolTipService.ShowDuration" Value="120000" />
                        <Setter Property="ToolTip">
                            <Setter.Value>
                                <ToolTip MaxWidth="420" Placement="Bottom"
                                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <StackPanel>
                                        <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto"
                                                      Visibility="{Binding HasCaption, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding Caption}" TextWrapping="Wrap"
                                                       FontWeight="SemiBold" Margin="0,0,0,6" />
                                        </ScrollViewer>
                                        <TextBlock Text="{Binding ExportToolTip}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Text.Secondary}" />
                                    </StackPanel>
                                </ToolTip>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Outline"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="2"
                                            CornerRadius="{StaticResource Radius.Lg}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Outline" Property="Background" Value="{DynamicResource Surface.Hover}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Outline" Property="Background" Value="{DynamicResource Accent.Subtle}" />
                                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource Border.Accent}" />
                                        </DataTrigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="Gallery.HeaderRowTemplate" DataType="{x:Type gallery:GalleryHeaderRow}">
            <Grid Margin="8,16,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="{Binding Heading}" Style="{StaticResource Button.Secondary}" Click="OnDayClick" AutomationProperties.Name="{Binding Heading}" ToolTip="{loc:Text LibrarySelection_SelectDay}" />
                <Border Grid.Column="1" Height="1" Margin="14,0,0,0"
                        Background="{DynamicResource Border.Subtle}"
                        VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Gallery.TileRowTemplate" DataType="{x:Type gallery:GalleryTileRow}">
            <ListBox Style="{StaticResource Gallery.TileRowList}"
                     ItemsSource="{Binding Tiles}"
                     PreviewKeyDown="OnTileKeyDown"
                     PreviewMouseLeftButtonDown="OnTileMouseLeftButtonDown"
                     MouseDoubleClick="OnTileDoubleClick" />
        </DataTemplate>

        <!-- Inside an opened folder: about 60% of the full card. 148x180 plus 6px margins and the
             2px selection outline is the 164px track of GalleryRowBuilder.CompactTileTrackWidth,
             so a folder shows more captures per row. One caption line and the overflow menu stay
             on the card; float, copy and edit remain on the keyboard, double-click and the details
             panel. Selection, dragging and the automation name are the full card's. -->
        <DataTemplate x:Key="Gallery.CompactTileTemplate" DataType="{x:Type gallery:GalleryItemViewModel}">
            <Border Width="148" Height="180" Margin="6"
                    Background="{DynamicResource Surface.Raised}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Lg}"
                    SnapsToDevicePixels="True">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Md}"
                            ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Thumbnail}"
                                   Margin="2"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="{Binding AccessibleName}" />
                            <TextBlock Text="{Binding PreviewUnavailableText}"
                                       Style="{DynamicResource Text.MutedBlock}"
                                       FontSize="{StaticResource FontSize.Caption}"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="6,0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsBroken, Converter={StaticResource BoolToVisibility}}" />
                            <Border Width="36" Height="36" CornerRadius="18"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{DynamicResource Surface.Badge}"
                                    BorderBrush="{DynamicResource Border.Badge}" BorderThickness="1"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                <Path Data="{StaticResource Icon.Play}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{DynamicResource Text.Badge}"
                                      Stroke="{DynamicResource Text.Badge}" StrokeThickness="1.2"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="5" Padding="5,2" CornerRadius="4"
                                    Background="{DynamicResource Surface.BadgeStrong}"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding DurationCaption}"
                                           Foreground="{DynamicResource Text.Badge}"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="{StaticResource FontSize.Caption}" />
                            </Border>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="5" Padding="6,2" CornerRadius="5"
                                    Background="{DynamicResource Accent.Default}"
                                    Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Text LibraryUx_KeptBadge}" FontSize="{StaticResource FontSize.Caption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.OnAccent}" />
                            </Border>
                            <!-- Only a search inside the folder lists captures of its subfolders. -->
                            <Border x:Name="FolderBadge" Style="{StaticResource Gallery.FolderBadge}"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Margin="5" Padding="5,2" CornerRadius="4" MaxWidth="80">
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Gallery.FolderBadgeContent}" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="2,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CompactCaption}"
                                   Foreground="{DynamicResource Text.Primary}"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSize.Caption}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Style="{StaticResource Gallery.IconButton}"
                                Width="30" Height="30" MinWidth="30" MinHeight="30" Padding="4"
                                ToolTip="{loc:Text LibraryUx_TileMoreHint}"
                                AutomationProperties.Name="{loc:Text Text_5E8959D18390}"
                                ContextMenu="{StaticResource Gallery.TileContextMenu}"
                                Click="OnMoreClick">
                            <Path Data="{StaticResource Icon.More}" Width="20" Height="20"
                                  Stretch="None"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="Gallery.CompactTileRowList" TargetType="ListBox" BasedOn="{StaticResource Gallery.TileRowList}">
            <Setter Property="ItemTemplate" Value="{StaticResource Gallery.CompactTileTemplate}" />
        </Style>

        <DataTemplate x:Key="Gallery.CompactTileRowTemplate" DataType="{x:Type gallery:GalleryTileRow}">
            <ListBox Style="{StaticResource Gallery.CompactTileRowList}"
                     ItemsSource="{Binding Tiles}"
                     PreviewKeyDown="OnTileKeyDown"
                     PreviewMouseLeftButtonDown="OnTileMouseLeftButtonDown"
                     MouseDoubleClick="OnTileDoubleClick" />
        </DataTemplate>

        <!-- Library icons on the shared 20x20 symbol grid, local so the shared Symbols.xaml stays untouched. -->
        <PathGeometry x:Key="LibraryUx.Icon.AllItems"
                      Figures="M4,3.25 L8,3.25 A0.75,0.75 0 0 1 8.75,4 L8.75,8 A0.75,0.75 0 0 1 8,8.75 L4,8.75 A0.75,0.75 0 0 1 3.25,8 L3.25,4 A0.75,0.75 0 0 1 4,3.25 Z M12,3.25 L16,3.25 A0.75,0.75 0 0 1 16.75,4 L16.75,8 A0.75,0.75 0 0 1 16,8.75 L12,8.75 A0.75,0.75 0 0 1 11.25,8 L11.25,4 A0.75,0.75 0 0 1 12,3.25 Z M4,11.25 L8,11.25 A0.75,0.75 0 0 1 8.75,12 L8.75,16 A0.75,0.75 0 0 1 8,16.75 L4,16.75 A0.75,0.75 0 0 1 3.25,16 L3.25,12 A0.75,0.75 0 0 1 4,11.25 Z M12,11.25 L16,11.25 A0.75,0.75 0 0 1 16.75,12 L16.75,16 A0.75,0.75 0 0 1 16,16.75 L12,16.75 A0.75,0.75 0 0 1 11.25,16 L11.25,12 A0.75,0.75 0 0 1 12,11.25 Z" />
        <PathGeometry x:Key="LibraryUx.Icon.Video"
                      Figures="M3.25,4.75 L16.75,4.75 A1.25,1.25 0 0 1 18,6 L18,14 A1.25,1.25 0 0 1 16.75,15.25 L3.25,15.25 A1.25,1.25 0 0 1 2,14 L2,6 A1.25,1.25 0 0 1 3.25,4.75 Z M8.25,7.5 L12.75,10 L8.25,12.5 Z" />
        <PathGeometry x:Key="LibraryUx.Icon.Kept"
                      Figures="M5.25,3.25 L14.75,3.25 L14.75,17 L10,13.5 L5.25,17 Z" />
        <PathGeometry x:Key="LibraryUx.Icon.Add" Figures="M10,4.25 L10,15.75 M4.25,10 L15.75,10" />
        <PathGeometry x:Key="LibraryUx.Icon.Calendar"
                      Figures="M4.25,4.75 L15.75,4.75 A1,1 0 0 1 16.75,5.75 L16.75,15.75 A1,1 0 0 1 15.75,16.75 L4.25,16.75 A1,1 0 0 1 3.25,15.75 L3.25,5.75 A1,1 0 0 1 4.25,4.75 Z M3.25,8.5 L16.75,8.5 M7,3 L7,6.25 M13,3 L13,6.25" />
        <PathGeometry x:Key="LibraryUx.Icon.Chevron" Figures="M7.75,5.25 L12.5,10 L7.75,14.75" />
        <PathGeometry x:Key="LibraryUx.Icon.Info"
                      Figures="M10,2.75 A7.25,7.25 0 1 1 9.99,2.75 Z M10,9 L10,13.75 M10,6.25 L10,6.3" />
        <!-- The card silhouette: a manila-folder tab on the top left, then the 12-DIP card radius. -->
        <PathGeometry x:Key="LibraryUx.FolderCardShape"
                      Figures="M0,10 A10,10 0 0 1 10,0 L84,0 C90,0 92,3 95,7 L97,10 C99,13 101,14 106,14 L232,14 A12,12 0 0 1 244,26 L244,280 A12,12 0 0 1 232,292 L12,292 A12,12 0 0 1 0,280 Z" />

        <!-- Folder cards use the capture card's 244x292 frame. Their 8-DIP margins match a tile's
             6-DIP margins plus its 2-DIP selection outline, so folder and capture rows share one
             column grid for arrow keys. The folder tab, warm Surface.Folder fill, Border.Folder
             outline and a large folder glyph keep them apart from captures in every palette. -->
        <Style x:Key="Gallery.FolderCardButton" TargetType="Button">
            <Setter Property="Width" Value="244" />
            <Setter Property="Height" Value="292" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="12,22,12,12" />
            <Setter Property="Background" Value="{DynamicResource Surface.Folder}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Folder}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Path x:Name="Chrome" Data="{StaticResource LibraryUx.FolderCardShape}" Stretch="Fill"
                                  Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}"
                                  StrokeThickness="1" SnapsToDevicePixels="True" />
                            <Path x:Name="Wash" Data="{StaticResource LibraryUx.FolderCardShape}" Stretch="Fill"
                                  Fill="{DynamicResource Surface.Hover}" Opacity="0" IsHitTestVisible="False" />
                            <Path x:Name="DropRing" Data="{StaticResource LibraryUx.FolderCardShape}" Stretch="Fill"
                                  Stroke="{DynamicResource Accent.Folder}" StrokeThickness="2" StrokeDashArray="3 2"
                                  Opacity="0" IsHitTestVisible="False" />
                            <Path x:Name="FocusRing" Data="{StaticResource LibraryUx.FolderCardShape}" Stretch="Fill"
                                  Stroke="{DynamicResource Border.Focus}" StrokeThickness="2" Margin="2"
                                  Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Stroke" Value="{DynamicResource Accent.Folder}" />
                                <Setter TargetName="Wash" Property="Opacity" Value="0.35" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Wash" Property="Opacity" Value="0.6" />
                            </Trigger>
                            <!-- While captures are dragged, every folder that can take them shows a dashed edge. -->
                            <DataTrigger Binding="{Binding IsDropAvailable}" Value="True">
                                <Setter TargetName="DropRing" Property="Opacity" Value="1" />
                            </DataTrigger>
                            <!-- The folder under the pointer: accent edge and wash, like Explorer's drop highlight. -->
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="Chrome" Property="Fill" Value="{DynamicResource Accent.Subtle}" />
                                <Setter TargetName="DropRing" Property="Stroke" Value="{DynamicResource Border.Accent}" />
                                <Setter TargetName="DropRing" Property="StrokeThickness" Value="3" />
                                <Setter TargetName="DropRing" Property="StrokeDashArray" Value="{x:Null}" />
                                <Setter TargetName="DropRing" Property="Opacity" Value="1" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="Gallery.FolderCardTemplate" DataType="{x:Type gallery:GalleryFolderCardViewModel}">
            <Button Style="{StaticResource Gallery.FolderCardButton}"
                    AutomationProperties.Name="{Binding AccessibleName}"
                    ToolTip="{Binding ToolTipText}"
                    Click="OnFolderCardClick"
                    PreviewKeyDown="OnFolderCardKeyDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Where a capture card shows its time, a folder card says it is a folder. -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="1,0,1,8">
                        <Path Data="{StaticResource LibraryUx.Icon.Folder}" Width="16" Height="16" Stretch="Uniform"
                              Fill="{DynamicResource Accent.Folder}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Text LibraryUx_CardKind}" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.Secondary}" FontSize="{StaticResource FontSize.Caption}" />
                    </StackPanel>
                    <Border Grid.Row="1"
                            Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Folder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Md}"
                            ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Preview.Thumbnail}"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" />
                            <!-- An empty folder shows a large folder glyph instead of a preview. -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Path Data="{StaticResource LibraryUx.Icon.Folder}" Width="72" Height="72" Stretch="Uniform"
                                      Fill="{DynamicResource Accent.Folder}" HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Text LibraryUx_CardEmpty}" Margin="0,6,0,0" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Text.Secondary}" FontSize="{StaticResource FontSize.Caption}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="2" Text="{Binding Name}" Margin="3,10,3,3"
                               FontWeight="SemiBold" FontSize="{StaticResource FontSize.Body}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="3" Text="{Binding CountText}" Margin="3,0,3,2"
                               Foreground="{DynamicResource Text.Secondary}" FontSize="{StaticResource FontSize.Caption}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="Gallery.FolderRowTemplate" DataType="{x:Type gallery:GalleryFolderRow}">
            <ItemsControl ItemsSource="{Binding Folders}"
                          ItemTemplate="{StaticResource Gallery.FolderCardTemplate}"
                          Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <!-- A subfolder inside an opened folder: the compact card's 148x180 frame with the same
             8-DIP margins as a full folder card, so it keeps the compact column grid. -->
        <Style x:Key="Gallery.CompactFolderCardButton" TargetType="Button" BasedOn="{StaticResource Gallery.FolderCardButton}">
            <Setter Property="Width" Value="148" />
            <Setter Property="Height" Value="180" />
            <Setter Property="Padding" Value="8,14,8,8" />
        </Style>

        <DataTemplate x:Key="Gallery.CompactFolderCardTemplate" DataType="{x:Type gallery:GalleryFolderCardViewModel}">
            <Button Style="{StaticResource Gallery.CompactFolderCardButton}"
                    AutomationProperties.Name="{Binding AccessibleName}"
                    ToolTip="{Binding ToolTipText}"
                    Click="OnFolderCardClick"
                    PreviewKeyDown="OnFolderCardKeyDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Folder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Md}"
                            ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Preview.Thumbnail}"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Path Data="{StaticResource LibraryUx.Icon.Folder}" Width="44" Height="44" Stretch="Uniform"
                                      Fill="{DynamicResource Accent.Folder}" HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Text LibraryUx_CardEmpty}" Margin="0,4,0,0" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Text.Secondary}" FontSize="{StaticResource FontSize.Caption}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- One line: folder glyph, name, capture count; the tooltip and name carry the details. -->
                    <Grid Grid.Row="1" Margin="2,7,2,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource LibraryUx.Icon.Folder}" Width="14" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource Accent.Folder}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="5,0,0,0"
                                   FontWeight="SemiBold" FontSize="{StaticResource FontSize.Caption}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding CaptureCount}" Margin="6,0,0,0"
                                   Foreground="{DynamicResource Text.Secondary}" FontSize="{StaticResource FontSize.Caption}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="Gallery.CompactFolderRowTemplate" DataType="{x:Type gallery:GalleryFolderRow}">
            <ItemsControl ItemsSource="{Binding Folders}"
                          ItemTemplate="{StaticResource Gallery.CompactFolderCardTemplate}"
                          Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <Style x:Key="Gallery.RowContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContentTemplate" Value="{StaticResource Gallery.TileRowTemplate}" />
            <!-- Later triggers win: a compact folder row takes the compact folder template. -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource Gallery.CompactTileRowTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={StaticResource IsHeaderRow}}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource Gallery.HeaderRowTemplate}" />

                    <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={StaticResource IsFolderRow}}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource Gallery.FolderRowTemplate}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Converter={StaticResource IsFolderRow}}" Value="True" />
                        <Condition Binding="{Binding IsCompact}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="ContentTemplate" Value="{StaticResource Gallery.CompactFolderRowTemplate}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Gallery.RowsList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource Gallery.RowContainer}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ============================================================= -->
        <!-- Navigation pane: views, folders and dates share one selection, -->
        <!-- like a Windows navigation view (icon, name, count; accent pill).-->
        <!-- ============================================================= -->
        <Style x:Key="LibraryUx.NavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="LibraryFilter" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource Radius.Md}" />
                            <Border x:Name="Indicator" Width="3" Height="16" Margin="1,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource Accent.Default}" CornerRadius="{DynamicResource Radius.Pill}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter Margin="12,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                            <Border x:Name="FocusRing" Margin="1" BorderBrush="{DynamicResource Border.Focus}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Sm}" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Accent.Subtle}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryUx.NavGlyph" TargetType="Path" BasedOn="{StaticResource Icon.Glyph}">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LibraryUx.NavCount" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LibraryUx.SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Tree rows read like navigation items: hover wash, subtle selection with the accent pill. -->
        <Style x:Key="LibraryUx.TreeExpander" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <Path x:Name="Chevron" Data="{StaticResource LibraryUx.Icon.Chevron}" Width="12" Height="12"
                                  Stretch="Uniform" Stroke="{DynamicResource Text.Secondary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryUx.TreeItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="ContextMenu" Value="{StaticResource Gallery.FolderContextMenu}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Grid x:Name="Row" MinHeight="34" Background="Transparent">
                                <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Md}" />
                                <Border x:Name="Indicator" Width="3" Height="16" Margin="1,0,0,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{DynamicResource Accent.Default}" CornerRadius="{DynamicResource Radius.Pill}"
                                        Opacity="0" IsHitTestVisible="False" />
                                <DockPanel Margin="4,0,10,0">
                                    <ToggleButton x:Name="Expander" DockPanel.Dock="Left" Style="{StaticResource LibraryUx.TreeExpander}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                    <ContentPresenter x:Name="PART_Header" ContentSource="Header" Margin="2,0,0,0"
                                                      VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                                </DockPanel>
                                <Border x:Name="FocusRing" Margin="1" BorderBrush="{DynamicResource Border.Focus}" BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Sm}" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                            <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Accent.Subtle}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Accent.Subtle}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Accent}" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate x:Key="Gallery.FolderNodeTemplate" DataType="{x:Type gallery:GalleryFolderNode}"
                                  ItemsSource="{Binding Children}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource LibraryUx.Icon.Folder}" Width="16" Height="16" Stretch="Uniform"
                      Fill="{DynamicResource Accent.Folder}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Caption}" Margin="8,0,8,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource LibraryUx.NavCount}" />
            </Grid>
        </HierarchicalDataTemplate>

        <DataTemplate x:Key="LibraryUx.DateItemTemplate" DataType="{x:Type gallery:GalleryFolderNode}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource LibraryUx.Icon.Calendar}" Style="{StaticResource LibraryUx.NavGlyph}"
                      Width="16" Height="16" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,8,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource LibraryUx.NavCount}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="LibraryUx.DateItem" TargetType="ListBoxItem">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Caption}" />
            <Setter Property="ContextMenu" Value="{StaticResource Gallery.FolderContextMenu}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid MinHeight="34" Background="Transparent">
                            <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Md}" />
                            <Border x:Name="Indicator" Width="3" Height="16" Margin="1,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource Accent.Default}" CornerRadius="{DynamicResource Radius.Pill}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter Margin="12,0,10,0" VerticalAlignment="Center" />
                            <Border x:Name="FocusRing" Margin="1" BorderBrush="{DynamicResource Border.Focus}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Sm}" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Accent.Subtle}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Accent.Subtle}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Accent}" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Collapsible pane section ("날짜"): an Expander keeps the expand/collapse automation pattern. -->
        <Style x:Key="LibraryUx.Section" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top" MinHeight="32" Cursor="Hand"
                                          FocusVisualStyle="{x:Null}"
                                          AutomationProperties.Name="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent"
                                                    BorderThickness="1" CornerRadius="{DynamicResource Radius.Md}" />
                                            <DockPanel Margin="12,0,8,0">
                                                <Path x:Name="Chevron" DockPanel.Dock="Right" Data="{StaticResource LibraryUx.Icon.Chevron}"
                                                      Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource Text.Secondary}"
                                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0" />
                                                    </Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </DockPanel>
                                            <Border x:Name="FocusRing" Margin="1" BorderBrush="{DynamicResource Border.Focus}"
                                                    BorderThickness="1" CornerRadius="{DynamicResource Radius.Sm}" Opacity="0"
                                                    IsHitTestVisible="False" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.Hover}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                           Style="{StaticResource LibraryUx.SectionLabel}" />
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================= -->
        <!-- Command bar and location header                               -->
        <!-- ============================================================= -->
        <Style x:Key="LibraryUx.CommandButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LibraryUx.CommandGhost" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LibraryUx.CommandIcon" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LibraryUx.CommandGlyph" TargetType="Path" BasedOn="{StaticResource Icon.Glyph}">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LibraryUx.CommandSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="4,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Border.Subtle}" />
        </Style>

        <!-- One toggle chip beside the folder name: checked = new captures join this folder. -->
        <!-- "Save new captures here" is a setting of the open folder, not part of its name: a
             quiet switch at the far end of the header, the way Windows shows an on/off option. -->
        <Style x:Key="LibraryUx.SaveHereSwitch" TargetType="CheckBox">
            <Setter Property="themes:FluidMotion.SwitchMotion" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <StackPanel Orientation="Horizontal" Margin="8,0,6,0" VerticalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center" Margin="0,0,10,0" />
                                <!-- FluidMotion.SwitchMotion slides the thumb and fades the fill. -->
                                <Grid x:Name="PART_SwitchTrack" Width="36" Height="20" VerticalAlignment="Center">
                                    <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                            BorderBrush="{DynamicResource Text.Secondary}" Background="Transparent" />
                                    <Border x:Name="PART_SwitchFill" CornerRadius="10" Opacity="0"
                                            Background="{DynamicResource Accent.Default}" />
                                    <Grid x:Name="PART_SwitchThumb" Width="12" Height="12" Margin="4,0,0,0"
                                          HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Ellipse x:Name="ThumbOff" Fill="{DynamicResource Text.Secondary}" />
                                        <Ellipse x:Name="PART_SwitchThumbOn" Fill="{DynamicResource Text.OnAccent}" Opacity="0" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                            <Border x:Name="FocusRing" BorderBrush="{DynamicResource Border.Focus}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Md}" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Text.Primary}" />
                                <Setter TargetName="ThumbOff" Property="Fill" Value="{DynamicResource Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent.Default}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LibraryUx.BreadcrumbTemplate" DataType="{x:Type gallery:GalleryBreadcrumb}">
            <StackPanel Orientation="Horizontal">
                <Button Content="{Binding Name}" Style="{StaticResource Button.GhostCompact}" Click="OnBreadcrumbClick"
                        FontSize="{StaticResource FontSize.Body}" FontWeight="Normal" Padding="6,4" MaxWidth="220"
                        Foreground="{DynamicResource Text.Secondary}" AutomationProperties.Name="{Binding Name}"
                        Visibility="{Binding IsLink, Converter={StaticResource BoolToVisibility}}" />
                <Path Data="{StaticResource LibraryUx.Icon.Chevron}" Width="12" Height="12" Stretch="Uniform" Margin="2,0"
                      Stroke="{DynamicResource Text.Muted}" StrokeThickness="1.5" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" VerticalAlignment="Center"
                      Visibility="{Binding IsLink, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" Margin="6,0,0,0"
                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                    <Path Data="{StaticResource LibraryUx.Icon.Folder}" Width="18" Height="18" Stretch="Uniform"
                          Fill="{DynamicResource Accent.Folder}" VerticalAlignment="Center"
                          Visibility="{Binding Scope.FolderId, Converter={StaticResource LibraryUx.HasValue}}" />
                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" MaxWidth="280" TextTrimming="CharacterEllipsis"
                               FontSize="{StaticResource FontSize.Subtitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
      </ResourceDictionary>
    </Window.Resources>

    <!-- The window title lives only in the native title bar, which ModernWindowChrome paints with
         the same Surface.Base as this body. The first body row is the command bar on that same
         base with no divider, so title bar, commands and the navigation pane read as one surface. -->
    <Grid x:Name="LibraryRoot" Margin="12,4,12,6" Background="Transparent" AllowDrop="True"
          DragEnter="OnLibraryDragOver" DragOver="OnLibraryDragOver" DragLeave="OnLibraryDragLeave" Drop="OnLibraryDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- One command bar of fixed height. Capture stays on the left; the right side swaps between
             library commands and the selection's commands in place, so selecting never pushes the
             library down. Shortcuts are in tooltips, the search sits between the two groups. -->
        <Grid x:Name="LibraryCommandBar" Grid.Row="0" Height="48" Margin="0,0,0,6"
              AutomationProperties.Name="{loc:Text LibraryUx_CommandBarName}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Labelled capture commands while nothing is selected: capture is the one filled button. -->
                <StackPanel x:Name="CaptureCommands" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button x:Name="CaptureRegionButton" Style="{StaticResource Button.Primary}" Padding="12,6" Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{loc:Text Text_2C20ADDA2018}"
                            Click="OnCaptureRegionClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Capture}" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" StrokeLineJoin="Round" Fill="Transparent" />
                            <TextBlock Text="{loc:Text Text_2C20ADDA2018}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RecordRegionButton" Style="{StaticResource LibraryUx.CommandButton}"
                            AutomationProperties.Name="{loc:Text Text_4F5AF20FAA6E}"
                            Click="OnRecordRegionClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Record}" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="{loc:Text Text_4F5AF20FAA6E}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- With a selection the item's Edit is the filled button, so capture becomes two icons. -->
                <StackPanel x:Name="CompactCaptureCommands" Orientation="Horizontal"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <Button x:Name="CaptureRegionIconButton" Style="{StaticResource LibraryUx.CommandIcon}"
                            AutomationProperties.Name="{loc:Text Text_2C20ADDA2018}" Click="OnCaptureRegionClick">
                        <Path Data="{StaticResource Icon.Capture}" Style="{StaticResource LibraryUx.CommandGlyph}" />
                    </Button>
                    <Button x:Name="RecordRegionIconButton" Style="{StaticResource LibraryUx.CommandIcon}"
                            AutomationProperties.Name="{loc:Text Text_4F5AF20FAA6E}" Click="OnRecordRegionClick">
                        <Path Data="{StaticResource Icon.Record}" Style="{StaticResource LibraryUx.CommandGlyph}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <Border x:Name="SearchField" Grid.Column="1" Style="{StaticResource Card.Sunken}" Padding="2" Margin="6,0,12,0"
                    MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource Icon.Search}"
                          Style="{StaticResource Icon.Glyph.Muted}" Width="18" Height="18"
                          Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBox x:Name="SearchBox" Grid.Column="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="8,4" MinHeight="32"
                             ToolTip="{Binding SearchToolTip}"
                             AutomationProperties.Name="{loc:Text Text_4B8D541EBE6D}"
                             TextChanged="OnSearchTextChanged" />
                    <TextBlock Grid.Column="1" IsHitTestVisible="False"
                               Text="{Binding SearchPlaceholder}"
                               Foreground="{DynamicResource Text.Muted}"
                               Margin="10,0"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Library commands (nothing selected). -->
            <StackPanel x:Name="LibraryCommands" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button x:Name="NewFolderButton" Style="{StaticResource LibraryUx.CommandGhost}"
                        ToolTip="{loc:Text LibraryUx_NewFolderHint}" AutomationProperties.Name="{loc:Text Folder410.NewFolder}"
                        Click="OnNewFolderClick">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource LibraryUx.Icon.Folder}" Style="{StaticResource LibraryUx.CommandGlyph}" />
                        <TextBlock Text="{loc:Text Folder410.NewFolder}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ComboBox x:Name="SortBox" Width="132" Margin="2,0,4,0" VerticalAlignment="Center"
                          AutomationProperties.Name="{loc:Text Folder410.Sort}" ToolTip="{loc:Text Folder410.Sort}"
                          SelectedIndex="{Binding SortIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{loc:Text Folder410.Newest}" />
                    <ComboBoxItem Content="{loc:Text Folder410.Oldest}" />
                    <ComboBoxItem Content="{loc:Text Folder410.ByName}" />
                </ComboBox>
                <Button x:Name="MoreCommandsButton" Style="{StaticResource LibraryUx.CommandIcon}" Margin="0"
                        ToolTip="{loc:Text Text_5E8959D18390}" AutomationProperties.Name="{loc:Text Text_5E8959D18390}"
                        Click="OnMoreCommandsClick">
                    <Path Data="{StaticResource Icon.More}" Style="{StaticResource LibraryUx.CommandGlyph}"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Text LibrarySelection_ClearHint}" Click="OnClearLibraryClick"
                                      Foreground="{DynamicResource State.DangerHover}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>

            <!-- Selection commands, in the same place. -->
            <StackPanel x:Name="SelectionCommands" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        AutomationProperties.Name="{loc:Text LibraryUx_SelectionBarName}"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <Button x:Name="ClearSelectionButton" Style="{StaticResource LibraryUx.CommandIcon}"
                        ToolTip="{loc:Text LibraryUx_ClearSelectionHint}" AutomationProperties.Name="{loc:Text LibraryUx_ClearSelection}"
                        Click="OnClearSelectionClick">
                    <Path Data="{StaticResource Icon.Close}" Style="{StaticResource LibraryUx.CommandGlyph}" Width="14" Height="14" />
                </Button>
                <TextBlock x:Name="SelectionCountLabel" Text="{Binding SelectionText}" VerticalAlignment="Center" Margin="2,0,10,0"
                           FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                <Border Style="{StaticResource LibraryUx.CommandSeparator}" />
                <Button x:Name="ArchiveExportButton" Content="{loc:Text Library.Archive.Action}" Style="{StaticResource LibraryUx.CommandButton}"
                        Click="OnExportArchiveClick" ToolTip="{loc:Text Library.Archive.Hint}" />
                <Button x:Name="MoveCapturesButton" Content="{loc:Text Folder410.MoveCaptures}" Style="{StaticResource LibraryUx.CommandButton}"
                        Click="OnMoveCapturesClick" ToolTip="{loc:Text LibraryUx_MoveHint}" />
                <Button x:Name="DeleteSelectedButton" Content="{loc:Text LibrarySelection_Delete}" Style="{StaticResource LibraryUx.CommandButton}"
                        Click="OnDeleteSelectedClick" ToolTip="{loc:Text LibraryUx_DeleteHint}" />
                <Button Content="{loc:Text LibrarySelection_Reduce}" Style="{StaticResource LibraryUx.CommandButton}" Margin="0"
                        DataContext="{Binding SingleSelectedTile}" Click="OnReducedExportClick"
                        Visibility="{Binding DataContext.CanReduceSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{loc:Text LibrarySelection_Gif}" Style="{StaticResource LibraryUx.CommandButton}" Margin="0"
                        DataContext="{Binding SingleSelectedTile}" Click="OnGifMenuClick"
                        Visibility="{Binding DataContext.CanGifSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <!-- OCR full-text search coverage banner (Row 1). Shown only when part of the
             library is not yet searchable by the text inside the images, or when no OCR
             language pack is installed. Collapsed by default; the code-behind sets its
             state when the gallery opens and after an indexing pass. -->
        <Border x:Name="OcrCoverageBanner" Grid.Row="1"
                Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="OcrCoverageHeadline"
                               Foreground="{DynamicResource Text.Primary}"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource FontSize.Body}" />
                    <TextBlock x:Name="OcrCoverageDetail"
                               Foreground="{DynamicResource Text.Secondary}"
                               FontSize="{StaticResource FontSize.Caption}"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap" MaxWidth="760"
                               HorizontalAlignment="Left" />
                </StackPanel>
                <!-- Outlined: the command bar already carries this screen's one filled button. -->
                <Button x:Name="OcrIndexButton" Grid.Column="1"
                        Style="{StaticResource Button.Secondary}"
                        Content="{loc:Text Text_C5364F392040}" MinHeight="34"
                        VerticalAlignment="Center" Margin="14,0,0,0"
                        ToolTip="{loc:Text Text_C8FFDDF126A8}"
                        AutomationProperties.Name="{loc:Text Text_4D5F7094119C}"
                        Click="OnOcrIndexClick" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" x:Name="GalleryWorkspace">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>

            <!-- Navigation pane on the window base, like the title bar above it. -->
            <Grid x:Name="GalleryFilterRail" Margin="0,0,10,0" AutomationProperties.Name="{loc:Text LibraryUx_NavName}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="96" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <RadioButton x:Name="AllLibraryFilter" Tag="All"
                                 IsChecked="{Binding IsAllItemsView, Mode=OneWay}" Checked="OnLibraryFilterChanged"
                                 ToolTip="{loc:Text LibraryUx_NavAllHint}" AutomationProperties.Name="{Binding AllItemsAccessibleName}">
                        <!-- Captures dropped here leave their folder; the item lights up like a folder target. -->
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource LibraryUx.NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAllItemsDropTarget}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Accent.Subtle}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Border.Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource LibraryUx.Icon.AllItems}" Style="{StaticResource LibraryUx.NavGlyph}" />
                            <TextBlock Grid.Column="1" Text="{loc:Text LibraryUx_NavAll}" Margin="10,0,8,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding AllItemsCount}" Style="{StaticResource LibraryUx.NavCount}" />
                        </Grid>
                    </RadioButton>
                    <RadioButton Style="{StaticResource LibraryUx.NavItem}" Tag="Images"
                                 IsChecked="{Binding IsImagesView, Mode=OneWay}" Checked="OnLibraryFilterChanged"
                                 AutomationProperties.Name="{Binding ImagesAccessibleName}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource Icon.Image}" Style="{StaticResource LibraryUx.NavGlyph}" />
                            <TextBlock Grid.Column="1" Text="{loc:Text LibraryUx_NavImages}" Margin="10,0,8,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding ImageCount}" Style="{StaticResource LibraryUx.NavCount}" />
                        </Grid>
                    </RadioButton>
                    <RadioButton Style="{StaticResource LibraryUx.NavItem}" Tag="Videos"
                                 IsChecked="{Binding IsVideosView, Mode=OneWay}" Checked="OnLibraryFilterChanged"
                                 AutomationProperties.Name="{Binding VideosAccessibleName}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource LibraryUx.Icon.Video}" Style="{StaticResource LibraryUx.NavGlyph}" />
                            <TextBlock Grid.Column="1" Text="{loc:Text LibraryUx_NavVideos}" Margin="10,0,8,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding VideoCount}" Style="{StaticResource LibraryUx.NavCount}" />
                        </Grid>
                    </RadioButton>
                    <RadioButton Style="{StaticResource LibraryUx.NavItem}" Tag="Pinned"
                                 IsChecked="{Binding IsKeptView, Mode=OneWay}" Checked="OnLibraryFilterChanged"
                                 ToolTip="{loc:Text LibraryUx_NavKeptHint}" AutomationProperties.Name="{Binding KeptAccessibleName}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource LibraryUx.Icon.Kept}" Style="{StaticResource LibraryUx.NavGlyph}" />
                            <TextBlock Grid.Column="1" Text="{loc:Text LibraryUx_NavKept}" Margin="10,0,8,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding KeptCount}" Style="{StaticResource LibraryUx.NavCount}" />
                        </Grid>
                    </RadioButton>
                </StackPanel>

                <!-- "폴더" section head: the retention rule is a tooltip, [+] creates a folder here. -->
                <Grid Grid.Row="1" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" Background="Transparent"
                                ToolTip="{Binding FolderSectionToolTip}">
                        <TextBlock Text="{loc:Text Folder410.Title}" Style="{StaticResource LibraryUx.SectionLabel}" />
                        <Path Data="{StaticResource LibraryUx.Icon.Info}" Style="{StaticResource Icon.Glyph.Muted}"
                              Width="14" Height="14" Margin="6,0,0,0" StrokeThickness="1.3" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="NewFolderPaneButton" Grid.Column="1" Style="{StaticResource Button.Icon.Compact}"
                            Width="30" Height="30" MinWidth="30" MinHeight="30" Padding="5"
                            ToolTip="{loc:Text LibraryUx_NewFolderHint}" AutomationProperties.Name="{loc:Text Folder410.NewFolder}"
                            Click="OnNewFolderClick">
                        <Path Data="{StaticResource LibraryUx.Icon.Add}" Style="{StaticResource LibraryUx.CommandGlyph}"
                              Width="14" Height="14" />
                    </Button>
                </Grid>

                <TreeView x:Name="FolderTree" Grid.Row="2" ItemsSource="{Binding FolderRoots}" Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource Text.Primary}"
                          AutomationProperties.Name="{loc:Text Folder410.Title}"
                          AutomationProperties.HelpText="{loc:Text LibraryUx_FoldersHint}"
                          ItemTemplate="{StaticResource Gallery.FolderNodeTemplate}"
                          ItemContainerStyle="{StaticResource LibraryUx.TreeItem}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                          SelectedItemChanged="OnFolderSelected" PreviewKeyDown="OnFolderTreeKeyDown"
                          PreviewMouseLeftButtonDown="OnFolderPointerDown" />

                <Expander x:Name="DateSection" Grid.Row="3" Style="{StaticResource LibraryUx.Section}" Margin="0,6,0,0"
                          Header="{loc:Text LibraryUx_DatesHeader}" IsExpanded="False">
                    <ListBox x:Name="DateList" ItemsSource="{Binding FolderNodes}" MaxHeight="220"
                             ItemTemplate="{StaticResource LibraryUx.DateItemTemplate}"
                             ItemContainerStyle="{StaticResource LibraryUx.DateItem}"
                             AutomationProperties.Name="{loc:Text LibraryUx_DatesHeader}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="False"
                             SelectionChanged="OnDateSelected" PreviewKeyDown="OnFolderTreeKeyDown" />
                </Expander>
            </Grid>


            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Location header inside a folder or date: the way back and the name on the left,
                     the folder's "save new captures here" switch at the right end. -->
                <Grid x:Name="LocationHeader" Height="44" Margin="2,0,0,4" ClipToBounds="True"
                      Visibility="{Binding ShowLocationHeader, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ItemsControl x:Name="LocationBreadcrumb" ItemsSource="{Binding Breadcrumb}" Focusable="False"
                                      ItemTemplate="{StaticResource LibraryUx.BreadcrumbTemplate}"
                                      AutomationProperties.Name="{loc:Text LibraryUx_BreadcrumbName}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <CheckBox x:Name="CurrentFolderCaptureCheck" Grid.Column="1" Style="{StaticResource LibraryUx.SaveHereSwitch}" Margin="12,0,4,0"
                              Content="{loc:Text LibraryUx_SaveHere}" ToolTip="{Binding SaveHereToolTip}"
                              IsEnabled="{Binding CanChangeNewCaptureFolder}"
                              IsChecked="{Binding SavesNewCapturesHere, Mode=OneWay}" Click="OnFolderCaptureTargetClick"
                              Visibility="{Binding ShowSaveHere, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <ListBox x:Name="RowsList" Grid.Row="1"
                         Style="{StaticResource Gallery.RowsList}"
                         ItemsSource="{Binding Rows}"
                         SizeChanged="OnRowsListSizeChanged" />

                <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource Card}" Padding="42,30"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel MaxWidth="380">
                        <TextBlock Text="{Binding EmptyStateTitle}"
                                   Style="{DynamicResource Text.Title}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyStateLabel"
                                   Text="{Binding EmptyStateText}"
                                   Style="{DynamicResource Text.MutedBlock}"
                                   Margin="0,8,0,0"
                                   TextAlignment="Center"
                                   AutomationProperties.Name="{Binding EmptyStateText}" TextWrapping="Wrap" />
                        <!-- Outlined: the command bar's capture is this screen's filled button. -->
                        <Button Content="{loc:Text Text_2C20ADDA2018}" Style="{StaticResource Button.Secondary}" Click="OnCaptureRegionClick" Margin="0,16,0,0" Visibility="{Binding QueueIsEmpty, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{loc:Text Library.Search.Reset}" Click="OnClearLibrarySearchClick" Margin="0,16,0,0"
                                Style="{StaticResource Button.Secondary}"
                                Visibility="{Binding CanResetEmptySearch, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- After the library content, so Tab follows the visual order: pane, content, details.
                 The selected capture's preview, title and main commands stay at the top; only the
                 information below them scrolls, and nothing inside it scrolls on its own. -->
            <Border x:Name="GalleryDetailsPanel" Grid.Column="2" Margin="8,0,0,0" Padding="16"
                    Background="{DynamicResource Surface.Raised}" CornerRadius="{StaticResource Radius.Lg}"
                    AutomationProperties.Name="{loc:Text Workspace.Details}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="GalleryDetailsHeading" Text="{loc:Text Workspace.Details}" Style="{DynamicResource Text.Section}"
                               Margin="0,0,0,16" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Text="{loc:Text Workspace.SelectHint}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SingleSelectedTile}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid x:Name="GalleryDetailsContent" Grid.Row="1" DataContext="{Binding SingleSelectedTile}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <!-- The preview gives up height first in a short window; the commands never move. -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="72" MaxHeight="136" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource Surface.Sunken}" CornerRadius="{StaticResource Radius.Md}">
                            <Image x:Name="SelectedDetailThumbnail" Source="{Binding Thumbnail}" Stretch="Uniform"
                                   AutomationProperties.Name="{Binding AccessibleName}" />
                        </Border>
                        <TextBlock Grid.Row="1" AutomationProperties.AutomationId="LibraryDetailsTitle" Margin="0,12,0,0"
                                   FontWeight="SemiBold" ToolTip="{Binding ContextLabel}"
                                   gallery:GalleryTextClamp.MaxLines="2" gallery:GalleryTextClamp.Text="{Binding ContextLabel}" />

                        <!-- Main commands: Edit is the panel's one filled button; pin and copy share a row. -->
                        <StackPanel Grid.Row="2" AutomationProperties.AutomationId="LibraryDetailsActions" Margin="0,12,0,0">
                            <Button x:Name="DetailsEditButton" Content="{Binding ActionLabel}" Style="{StaticResource Button.Primary}"
                                    Click="OnEditClick" />
                            <Grid Margin="0,8,0,0" Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DetailsFloatButton" Style="{StaticResource Button.Secondary}" Padding="8,8"
                                        ToolTip="{loc:Text Gallery.FloatHint}" AutomationProperties.Name="{loc:Text Gallery.Float}"
                                        Click="OnFloatClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Pin}" Width="20" Height="20" Stretch="None"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Fill="Transparent" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Text QuickAccess.Pin}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DetailsCopyButton" Grid.Column="2" Style="{StaticResource Button.Secondary}" Padding="8,8"
                                        ToolTip="{loc:Text Text_59D43391538F}" AutomationProperties.Name="{loc:Text Text_42A667BC71B0}"
                                        Click="OnCopyClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Copy}" Width="20" Height="20" Stretch="None"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Fill="Transparent" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Text QuickAccess.Copy}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Information only: the panel's one scrolling area. -->
                        <ScrollViewer x:Name="GalleryDetailsScroll" Grid.Row="3" Margin="0,16,0,0" Focusable="False"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <StackPanel AutomationProperties.AutomationId="LibraryDetailsInfo">
                                    <TextBlock Text="{Binding TimeCaption}" Foreground="{DynamicResource Text.Secondary}" />
                                    <TextBlock Text="{Binding DetailDimensions}" Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding RetentionCaption}" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock AutomationProperties.AutomationId="LibraryDetailsTags" Foreground="{DynamicResource Text.Secondary}"
                                               Margin="0,0,0,8" ToolTip="{Binding TagsCaption}"
                                               gallery:GalleryTextClamp.MaxLines="2" gallery:GalleryTextClamp.Text="{Binding TagsCaption}"
                                               Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="{loc:Text Library.Organize.Action}" Style="{StaticResource Button.Secondary}"
                                            Click="OnOrganizeClick" ToolTip="F2" />
                                </StackPanel>
                                <!-- Source: the app and window a capture came from, and its web page or folder when known. Long
                                     addresses and paths show two lines with "show all" and a copy command, never a nested scroller. -->
                                <StackPanel AutomationProperties.AutomationId="LibrarySourceSection" AutomationProperties.Name="{loc:Text Library.Source.Label}"
                                            Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                                    <StackPanel.Resources>
                                        <!-- A quiet text toggle beside a value's label; expanded is not a selected state. -->
                                        <Style x:Key="LibrarySource.ExpandToggle" TargetType="ToggleButton">
                                            <Setter Property="Content" Value="{loc:Text Library.Source.ShowAll}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Padding" Value="6,2" />
                                            <Setter Property="MinHeight" Value="{DynamicResource Size.HitTarget.Compact}" />
                                            <Setter Property="Margin" Value="8,0,0,0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Grid>
                                                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius.Sm}">
                                                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <Border x:Name="FocusRing" BorderBrush="{DynamicResource Border.Focus}" BorderThickness="1"
                                                                    CornerRadius="{DynamicResource Radius.Sm}" IsHitTestVisible="False" Opacity="0" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.Hover}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.Pressed}" />
                                                            </Trigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Content" Value="{loc:Text Library.Source.ShowLess}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Resources>
                                    <TextBlock Text="{loc:Text Library.Source.Label}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBlock AutomationProperties.AutomationId="LibrarySourceApp" Text="{Binding SourceAppName}" TextWrapping="Wrap"
                                               ToolTip="{Binding SourceAppToolTip}" AutomationProperties.Name="{Binding SourceAppAutomationName}"
                                               Visibility="{Binding HasSourceApp, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock AutomationProperties.AutomationId="LibrarySourceWindow" Margin="0,2,0,0"
                                               Foreground="{DynamicResource Text.Secondary}" ToolTip="{Binding SourceWindowTitle}"
                                               gallery:GalleryTextClamp.MaxLines="2" gallery:GalleryTextClamp.Text="{Binding SourceWindowTitle}"
                                               AutomationProperties.Name="{Binding SourceWindowTitleAutomationName}"
                                               Visibility="{Binding HasSourceWindowTitle, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel AutomationProperties.AutomationId="LibrarySourcePage" Margin="0,12,0,0"
                                                Visibility="{Binding HasSourcePageUrl, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SourcePageLabel" Text="{loc:Text Library.SourcePage.Label}" Foreground="{DynamicResource Text.Muted}"
                                                       FontSize="{StaticResource FontSize.Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <ToggleButton x:Name="SourcePageToggle" Grid.Column="1" Style="{StaticResource LibrarySource.ExpandToggle}"
                                                          AutomationProperties.AutomationId="LibrarySourcePageToggle"
                                                          AutomationProperties.Name="{loc:Text Library.SourcePage.ShowFull}"
                                                          gallery:GalleryTextClamp.ToggleTarget="{Binding ElementName=SourcePageValue}" />
                                        </Grid>
                                        <TextBlock x:Name="SourcePageValue" AutomationProperties.AutomationId="LibrarySourcePageValue" Margin="0,2,0,0"
                                                   FontSize="{StaticResource FontSize.Control}" ToolTip="{Binding SourcePageUrl}"
                                                   AutomationProperties.LabeledBy="{Binding ElementName=SourcePageLabel}"
                                                   gallery:GalleryTextClamp.MaxLines="2" gallery:GalleryTextClamp.Text="{Binding SourcePageUrl}" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="{loc:Text Library.SourcePage.Open}" Style="{StaticResource Button.Secondary}" Click="OnOpenSourcePageClick" Margin="0,0,8,8" />
                                            <Button Content="{loc:Text Library.SourcePage.Copy}" Style="{StaticResource Button.Secondary}" Click="OnCopySourcePageClick" Margin="0,0,0,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel AutomationProperties.AutomationId="LibrarySourceLocation" Margin="0,12,0,0"
                                                Visibility="{Binding HasSourceDocumentPath, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SourcePathLabel" Text="{loc:Text Library.Source.Location}" Foreground="{DynamicResource Text.Muted}"
                                                       FontSize="{StaticResource FontSize.Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <ToggleButton x:Name="SourcePathToggle" Grid.Column="1" Style="{StaticResource LibrarySource.ExpandToggle}"
                                                          AutomationProperties.AutomationId="LibrarySourcePathToggle"
                                                          AutomationProperties.Name="{loc:Text Library.Source.ShowFullPath}"
                                                          gallery:GalleryTextClamp.ToggleTarget="{Binding ElementName=SourcePathValue}" />
                                        </Grid>
                                        <TextBlock x:Name="SourcePathValue" AutomationProperties.AutomationId="LibrarySourcePathValue" Margin="0,2,0,0"
                                                   FontSize="{StaticResource FontSize.Control}" ToolTip="{Binding SourceDocumentPath}"
                                                   AutomationProperties.LabeledBy="{Binding ElementName=SourcePathLabel}"
                                                   gallery:GalleryTextClamp.MaxLines="2" gallery:GalleryTextClamp.Text="{Binding SourceDocumentPath}" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="{loc:Text Library.Source.OpenFolder}" Style="{StaticResource Button.Secondary}" Click="OnOpenSourceFolderClick" Margin="0,0,8,8" />
                                            <Button Content="{loc:Text Library.Source.CopyPath}" Style="{StaticResource Button.Secondary}" Click="OnCopySourcePathClick" Margin="0,0,0,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{loc:Text Workspace.EditHint}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}"
                                           FontSize="{StaticResource FontSize.Caption}" Margin="0,16,0,0"
                                           Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{loc:Text Workspace.VideoHint}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}"
                                           FontSize="{StaticResource FontSize.Caption}" Margin="0,16,0,0"
                                           Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status line: the library summary and the last action's result, which fades out on its own. -->
        <Grid x:Name="LibraryStatusBar" Grid.Row="3" MinHeight="26" Margin="4,6,2,0"
              AutomationProperties.Name="{loc:Text LibraryUx_StatusName}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="SummaryLabel" Text="{Binding SummaryText}" Style="{StaticResource StatusBar.Text}"
                           Foreground="{DynamicResource Text.Muted}" AutomationProperties.Name="{Binding SummaryText}" />
                <TextBlock Text="  ·  " Style="{StaticResource StatusBar.Text}" Foreground="{DynamicResource Text.Muted}" />
                <TextBlock x:Name="FolderStorageLabel" Text="{Binding FolderStorageText}" Style="{StaticResource StatusBar.Text}"
                           Foreground="{DynamicResource Text.Muted}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowResultCount, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="  ·  " Style="{StaticResource StatusBar.Text}" Foreground="{DynamicResource Text.Muted}" />
                    <TextBlock x:Name="ResultCountLabel" Text="{Binding ResultCountText}" Style="{StaticResource StatusBar.Text}"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowNewCaptureDestination, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="  ·  " Style="{StaticResource StatusBar.Text}" Foreground="{DynamicResource Text.Muted}" />
                    <TextBlock x:Name="NewCaptureDestinationLabel" Text="{Binding NewCaptureDestinationText}" MaxWidth="320"
                               ToolTip="{Binding NewCaptureDestinationText}" Style="{StaticResource StatusBar.Text}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowFolderStorageInfo, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{loc:Text Folder410.StorageInfo}" Background="Transparent">
                    <TextBlock Text="  ·  " Style="{StaticResource StatusBar.Text}" Foreground="{DynamicResource Text.Muted}" />
                    <Path Data="{StaticResource LibraryUx.Icon.Info}" Width="14" Height="14" Stretch="Uniform"
                          Stroke="{DynamicResource State.Warning}" StrokeThickness="1.4" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Text Folder410.StorageInfo}" Margin="6,0,0,0" MaxWidth="360"
                               Style="{StaticResource StatusBar.Text}" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="LibraryActionStatus" Grid.Column="1" Margin="16,0,0,0" TextWrapping="Wrap" TextAlignment="Right"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource Text.Secondary}" FontSize="{StaticResource FontSize.Caption}"
                       AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="ArchiveCancelButton" Grid.Column="2" Content="{loc:Text Library.Action.Cancel}"
                    Style="{StaticResource Button.GhostCompact}" Click="OnCancelArchiveClick" Visibility="Collapsed" Margin="8,0,0,0" />
        </Grid>

        <!-- Pointer-side drop label ("제품리뷰 폴더로 이동 · 2개"), like Explorer's "Move to" hint. -->
        <Canvas x:Name="DragHintLayer" Grid.RowSpan="4" IsHitTestVisible="False" Panel.ZIndex="10">
            <Border x:Name="DragHint" Visibility="Collapsed" Padding="10,6" CornerRadius="6"
                    Background="{DynamicResource Surface.Floating}" BorderBrush="{DynamicResource Border.Accent}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource LibraryUx.Icon.Folder}" Width="16" Height="16" Stretch="Uniform"
                          Fill="{DynamicResource Accent.Folder}" VerticalAlignment="Center" />
                    <TextBlock x:Name="DragHintText" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
