<Window x:Class="MyCapture.App.Gallery.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:MyCapture.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:MyCapture.App.Themes"
        xmlns:gallery="clr-namespace:MyCapture.App.Gallery"
        x:ClassModifier="internal"
        Style="{DynamicResource Window.Standard}"
        Title="{loc:Text Text_37AD4F28D422}"
        Width="1280" Height="760"
        MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface.Base}"
        Foreground="{DynamicResource Text.Primary}">

    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <themes:GalleryWorkspaceResources />
        </ResourceDictionary.MergedDictionaries>

        <!-- Local, so hosts that supply only the shared converters still load this window. -->
        <gallery:IsFolderRowConverter x:Key="IsFolderRow" />
        <gallery:HasValueToVisibilityConverter x:Key="LibraryUx.HasValue" />

        <!-- Tile action glyphs come from the shared Symbols.xaml resource dictionary
             (Icon.Copy / Icon.Pin / Icon.More / Icon.Ocr / Icon.Delete), referenced by key. -->

        <!-- Gallery actions inherit the shared icon-only states and retain a compact grid fit. -->
        <Style x:Key="Gallery.IconButton" TargetType="Button" BasedOn="{StaticResource Button.GhostCompact}">
            <Setter Property="MinWidth" Value="{DynamicResource CommandButton.Height.Compact}" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <!-- Library states follow the shared control templates (Themes/Controls.xaml): hover and
             selection are layers over the rest chrome whose opacity triggers move through
             FluidMotion.FadeTo (hover and press over Motion.Fast, selection over Motion.Normal),
             snapping when Windows animation effects are off. Brushes are never animated. -->
        <!-- The library's hover wash. A Windows contrast theme draws Surface.Hover in the Window
             colour, so the hover shows through StateLayer's Border.Hover edge (Highlight there,
             transparent in every app palette). A layer without a BorderThickness pairs it with a
             separate StateLayer outline. -->
        <Style x:Key="LibraryUx.HoverWash" TargetType="Border" BasedOn="{StaticResource StateLayer.Hover}" />
        <!-- A selected navigation row keeps its wash and accent pill without a card outline. -->
        <Style x:Key="LibraryUx.SelectedWash" TargetType="Border" BasedOn="{StaticResource StateLayer}">
            <Setter Property="Background" Value="{DynamicResource Accent.Subtle}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="themes:FluidMotion.Transition" Value="Normal" />
        </Style>
        <!-- A rest outline that hands over to a hover outline: it fades out while the hover copy
             fades in, so the hovered edge is the hover colour alone, never one over the other. -->
        <Style x:Key="LibraryUx.RestEdge" TargetType="FrameworkElement">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="themes:FluidMotion.FadeTo" Value="1" />
        </Style>

        <ContextMenu x:Key="Gallery.FolderContextMenu" x:Shared="False" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{loc:Text Folder410.NewFolder}" CommandParameter="{Binding}"
                      InputGestureText="Ctrl+Shift+N" Click="OnNewFolderClick" />
            <MenuItem Header="{loc:Text Folder410.Rename}" CommandParameter="{Binding}"
                      IsEnabled="{Binding IsFolder}" InputGestureText="F2" Click="OnRenameFolderClick" />
            <MenuItem Header="{loc:Text Folder410.MoveFolder}" CommandParameter="{Binding}"
                      IsEnabled="{Binding IsFolder}" InputGestureText="M" Click="OnMoveFolderClick" />
            <Separator />
            <MenuItem Header="{loc:Text Folder410.FolderExport}" CommandParameter="{Binding}" Click="OnExportFolderClick" />
            <MenuItem Header="{loc:Text Folder410.ZipExport}" CommandParameter="{Binding}" Click="OnExportFolderZipClick" />
            <Separator />
            <MenuItem Header="{Binding DeleteLabel, FallbackValue={loc:Text Folder410.Delete}}" CommandParameter="{Binding}"
                      InputGestureText="Delete" Foreground="{DynamicResource State.DangerHover}"
                      Click="OnDeleteFolderClick" />
        </ContextMenu>

        <!-- The capture card's overflow menu, shared by the full and compact cards. It inherits the
             More button's DataContext (the tile view model) via PlacementTarget, and each item
             carries the tile as CommandParameter so the handler always resolves the right record
             even though menu items are outside the visual tree. -->
        <ContextMenu x:Key="Gallery.TileContextMenu" x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{loc:Text Gallery.Compare}"
                      Command="{x:Static gallery:GalleryWindow.CompareCommand}"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{Binding IsPinned, Converter={StaticResource PinLabel}}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="{loc:Text LibraryUx_KeepToggleName}"
                      InputGestureText="P"
                      Click="OnPinMenuClick" />
            <MenuItem Header="{loc:Text Text_854582314EBD}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="{loc:Text Text_854582314EBD}"
                      InputGestureText="T"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}"
                      Click="OnOcrMenuClick">
                <MenuItem.Icon>
                    <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Ocr}"
                          Stroke="{DynamicResource Text.Secondary}" Fill="Transparent" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Text Text_D44617983641}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="{loc:Text Text_D44617983641}"
                      InputGestureText="G"
                      Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}"
                      Click="OnGifMenuClick" />
            <MenuItem Header="{loc:Text Folder410.MoveCaptures}" CommandParameter="{Binding}"
                      InputGestureText="M" Click="OnMoveCapturesClick" />
            <MenuItem Header="{loc:Text Library.Tags.Edit}" CommandParameter="{Binding}" Click="OnBatchTagsClick" />
            <Separator />
            <MenuItem Header="{loc:Text ExportReduction_Title}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="{loc:Text ExportReduction_Title}"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}"
                      Click="OnReducedExportClick" />
            <MenuItem Header="{loc:Text Text_6139B6C3ED73}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="{loc:Text Text_6139B6C3ED73}"
                      InputGestureText="Delete"
                      Foreground="{DynamicResource State.DangerHover}"
                      Click="OnDeleteMenuClick">
                <MenuItem.Icon>
                    <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Delete}"
                          Stroke="{DynamicResource State.DangerHover}" Fill="Transparent" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Declared ahead of the card templates, which use it for the folder badge. -->
        <PathGeometry x:Key="LibraryUx.Icon.Folder"
                      Figures="M2.75,5.25 A1.25,1.25 0 0 1 4,4 L7.6,4 L9.4,5.75 L16,5.75 A1.25,1.25 0 0 1 17.25,7 L17.25,14.75 A1.25,1.25 0 0 1 16,16 L4,16 A1.25,1.25 0 0 1 2.75,14.75 Z" />

        <!-- A search or the image, video and kept views list captures from every folder; a card
             filed in a folder other than the one open names it, so the result says where it lives. -->
        <Style x:Key="Gallery.FolderBadge" TargetType="Border">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource Surface.BadgeStrong}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="{Binding HasFolderBadge, Converter={StaticResource BoolToVisibility}}" />
        </Style>

        <DataTemplate x:Key="Gallery.FolderBadgeContent" DataType="{x:Type gallery:GalleryItemViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <themes:SymbolIcon StrokeThickness="0" Size="12" Data="{StaticResource LibraryUx.Icon.Folder}"
                      Fill="{DynamicResource Accent.Folder}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding FolderBadge}" Margin="4,0,0,0"
                           Foreground="{DynamicResource Text.Badge}" FontSize="{StaticResource FontSize.Caption}"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Gallery.TileTemplate" DataType="{x:Type gallery:GalleryItemViewModel}">
            <!-- The card fills its cell of the row (GalleryCardRowPanel) inside 6px margins and the
                 item's 2px selection outline: 208 to 320 wide, 244 x 292 being the reference size.
                 Only the preview area grows with it; the image keeps its own proportions. -->
            <Border x:Name="TileCard" Margin="6"
                    Background="{DynamicResource Surface.Raised}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Lg}"
                    SnapsToDevicePixels="True">
                <Grid Margin="9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="3,0,3,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TimeCaption}" Foreground="{DynamicResource Text.Secondary}" FontFamily="{StaticResource Font.Mono}" />
                        <Border Grid.Column="1" CornerRadius="4" Padding="5,2" BorderThickness="1" BorderBrush="{DynamicResource State.Warning}" Visibility="{Binding IsExpiringSoon, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding RetentionCaption}" Foreground="{DynamicResource Text.Primary}" FontSize="{StaticResource FontSize.Caption}" />
                        </Border>
                    </Grid>
                    <!-- Capture time is always above the image. -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Md}"
                            ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Thumbnail}"
                                   Margin="2"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="{Binding AccessibleName}" />
                            <TextBlock Text="{Binding PreviewUnavailableText}"
                                       Style="{DynamicResource Text.MutedBlock}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsBroken, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Video records remain image-light in the grid: a generated first-frame
                                 preview plus an unmistakable play affordance and exact duration. -->
                            <Border Width="52" Height="52" CornerRadius="26"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{DynamicResource Surface.Badge}"
                                    BorderBrush="{DynamicResource Border.Badge}" BorderThickness="1"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                <themes:SymbolIcon Size="24" Data="{StaticResource Icon.Play}"
                                      Fill="{DynamicResource Text.Badge}"
                                      Stroke="{DynamicResource Text.Badge}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="8" Padding="7,3" CornerRadius="5"
                                    Background="{DynamicResource Surface.BadgeStrong}"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding DurationCaption}"
                                           Foreground="{DynamicResource Text.Badge}"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="{StaticResource FontSize.Caption}" />
                            </Border>

                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Margin="8" Padding="7,3" CornerRadius="5"
                                    Background="{DynamicResource Surface.BadgeStrong}"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Text Text_C11734267E6B}" Foreground="{DynamicResource Text.Badge}"
                                           FontSize="{StaticResource FontSize.Caption}"
                                           FontWeight="SemiBold" />
                            </Border>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Margin="8" Padding="7,3" CornerRadius="5"
                                    Background="{DynamicResource Surface.BadgeStrong}"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Text Text_302BAE127938}" Foreground="{DynamicResource Text.Badge}"
                                           FontSize="{StaticResource FontSize.Caption}"
                                           FontWeight="SemiBold" />
                            </Border>

                            <!-- One top line: on a narrow card the folder name gives way (trimmed)
                                 instead of the kept and annotation badges overlapping it. -->
                            <Grid VerticalAlignment="Top" Margin="8" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="8,4" CornerRadius="6" Margin="0,0,6,0"
                                        Background="{DynamicResource Accent.Default}"
                                        Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{loc:Text LibraryUx_KeptBadge}" FontSize="{StaticResource FontSize.Caption}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.OnAccent}" />
                                </Border>
                                <Border x:Name="FolderBadge" Grid.Column="1" Style="{StaticResource Gallery.FolderBadge}" MaxWidth="120"
                                        HorizontalAlignment="Left">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Gallery.FolderBadgeContent}" />
                                </Border>
                                <Border Grid.Column="2" Margin="6,0,0,0" Padding="8,4" CornerRadius="6"
                                        Background="{DynamicResource Surface.Floating}"
                                        BorderBrush="{DynamicResource Border.Subtle}"
                                        BorderThickness="1"
                                        Visibility="{Binding HasAnnotations, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{loc:Text Text_2C64DDA4D878}" FontSize="{StaticResource FontSize.Caption}"
                                               Foreground="{DynamicResource Text.Secondary}" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Caption + time -->
                    <Grid Grid.Row="2" Margin="3,9,3,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Caption}"
                                       Visibility="{Binding HasCaption, Converter={StaticResource BoolToVisibility}}"
                                       Foreground="{DynamicResource Text.Primary}"
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSize.Body}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SearchMatchText}" Margin="0,3,0,0"
                                       FontSize="{StaticResource FontSize.Caption}" Foreground="{DynamicResource Text.Secondary}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SearchMatchText}"
                                       Visibility="{Binding HasSearchMatch, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>

                    <!-- Visible Float / Copy / Edit, then delete and overflow. -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource Gallery.IconButton}"
                                Margin="0"
                                ToolTip="{loc:Text Gallery.FloatHint}"
                                AutomationProperties.Name="{loc:Text Gallery.Float}"
                                Click="OnFloatClick"
                                Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                            <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Pin}"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Fill="Transparent" />
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource Gallery.IconButton}"
                                ToolTip="{loc:Text Text_59D43391538F}"
                                AutomationProperties.Name="{loc:Text Text_42A667BC71B0}"
                                Click="OnCopyClick"
                                Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                            <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Copy}"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Fill="Transparent" />
                        </Button>

                        <!-- Borderless like the other card tools: the details panel owns the one filled Edit. -->
                        <Button Grid.Column="2" Style="{StaticResource Gallery.IconButton}"
                                Margin="0" HorizontalAlignment="Center"
                                ToolTip="{loc:Text Text_0400CF56D074}"
                                AutomationProperties.Name="{loc:Text Text_1003CFC78E66}"
                                Click="OnEditClick">
                            <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Edit}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Fill="Transparent" />
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource Gallery.IconButton}"
                                ToolTip="{loc:Text Text_784572D51B63}"
                                AutomationProperties.Name="{loc:Text Text_89D4979D7596}"
                                Click="OnDeleteClick">
                            <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Delete}"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Fill="Transparent" />
                        </Button>

                        <Button Grid.Column="4"
                                Style="{StaticResource Gallery.IconButton}"
                                ToolTip="{loc:Text LibraryUx_TileMoreHint}"
                                AutomationProperties.Name="{loc:Text Text_5E8959D18390}"
                                ContextMenu="{StaticResource Gallery.TileContextMenu}"
                                Click="OnMoreClick">
                            <themes:SymbolIcon Size="16" Data="{StaticResource Icon.More}"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="Gallery.TileRowList" TargetType="ListBox">
            <!-- Rows have no independent scrolling surface: wheel input reaches RowsList. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
            <Setter Property="ItemTemplate" Value="{StaticResource Gallery.TileTemplate}" />
            <!-- Equal cells over the row's whole width; the card height follows its width. -->
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <gallery:GalleryCardRowPanel Columns="{Binding Columns}"
                                                     BaseCardWidth="244" BaseCardHeight="292" HeightPerWidth="0.8" CardInset="16" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        <Setter Property="gallery:GalleryCaptionPreview.IsEnabled" Value="True" />
                        <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
                        <Setter Property="ToolTipService.ShowDuration" Value="120000" />
                        <Setter Property="ToolTip">
                            <Setter.Value>
                                <ToolTip MaxWidth="420" Placement="Bottom"
                                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <StackPanel>
                                        <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto"
                                                      Visibility="{Binding HasCaption, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding Caption}" TextWrapping="Wrap"
                                                       FontWeight="SemiBold" Margin="0,0,0,6" />
                                        </ScrollViewer>
                                        <TextBlock Text="{Binding ExportToolTip}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Text.Secondary}" />
                                    </StackPanel>
                                </ToolTip>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <!-- The transparent outline takes the pointer; hover and selection fade in
                                         over it. Selection sits above hover, so a hovered selected card keeps
                                         its selected wash and accent edge. -->
                                    <Grid>
                                        <Border x:Name="Outline"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="2"
                                                CornerRadius="{StaticResource Radius.Lg}" />
                                        <Border x:Name="HoverLayer"
                                                Style="{StaticResource LibraryUx.HoverWash}"
                                                BorderThickness="2"
                                                CornerRadius="{StaticResource Radius.Lg}" />
                                        <Border x:Name="SelectedLayer"
                                                Style="{StaticResource StateLayer.Selected}"
                                                BorderThickness="2"
                                                CornerRadius="{StaticResource Radius.Lg}" />
                                        <Border BorderThickness="2">
                                            <ContentPresenter />
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="SelectedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                                            <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="0" />
                                        </DataTrigger>
                                        <!-- Focus recolours the fixed edge at once, on the layers too. -->
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                            <Setter TargetName="HoverLayer" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                            <Setter TargetName="SelectedLayer" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="Gallery.HeaderRowTemplate" DataType="{x:Type gallery:GalleryHeaderRow}">
            <Grid Margin="8,16,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="{Binding Heading}" Style="{StaticResource Button.Secondary}" Click="OnDayClick" AutomationProperties.Name="{Binding Heading}" ToolTip="{loc:Text LibrarySelection_SelectDay}" />
                <Border Grid.Column="1" Height="1" Margin="14,0,0,0"
                        Background="{DynamicResource Border.Subtle}"
                        VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Gallery.TileRowTemplate" DataType="{x:Type gallery:GalleryTileRow}">
            <ListBox Style="{StaticResource Gallery.TileRowList}"
                     ItemsSource="{Binding Tiles}"
                     PreviewKeyDown="OnTileKeyDown"
                     PreviewMouseLeftButtonDown="OnTileMouseLeftButtonDown"
                     MouseDoubleClick="OnTileDoubleClick" />
        </DataTemplate>

        <!-- Inside an opened folder: about 60% of the full card (148 x 180 at the reference size),
             filling its cell of the row from 134 to 209 wide inside 6px margins and the 2px selection
             outline, so a folder shows more captures per row. One caption line and the overflow menu
             stay on the card; float, copy and edit remain on the keyboard, double-click and the
             details panel. Selection, dragging and the automation name are the full card's. -->
        <DataTemplate x:Key="Gallery.CompactTileTemplate" DataType="{x:Type gallery:GalleryItemViewModel}">
            <Border x:Name="CompactTileCard" Margin="6"
                    Background="{DynamicResource Surface.Raised}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Lg}"
                    SnapsToDevicePixels="True">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Md}"
                            ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Thumbnail}"
                                   Margin="2"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="{Binding AccessibleName}" />
                            <TextBlock Text="{Binding PreviewUnavailableText}"
                                       Style="{DynamicResource Text.MutedBlock}"
                                       FontSize="{StaticResource FontSize.Caption}"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="6,0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsBroken, Converter={StaticResource BoolToVisibility}}" />
                            <Border Width="36" Height="36" CornerRadius="18"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{DynamicResource Surface.Badge}"
                                    BorderBrush="{DynamicResource Border.Badge}" BorderThickness="1"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                <themes:SymbolIcon Size="16" Data="{StaticResource Icon.Play}"
                                      Fill="{DynamicResource Text.Badge}"
                                      Stroke="{DynamicResource Text.Badge}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="5" Padding="6,2" CornerRadius="5"
                                    Background="{DynamicResource Accent.Default}"
                                    Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Text LibraryUx_KeptBadge}" FontSize="{StaticResource FontSize.Caption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.OnAccent}" />
                            </Border>
                            <!-- One bottom line: the folder name (only a search inside the folder lists
                                 captures of its subfolders) gives way to a video's duration. -->
                            <Grid VerticalAlignment="Bottom" Margin="5" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
