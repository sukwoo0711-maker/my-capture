<Window x:Class="MyCapture.App.Gallery.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:MyCapture.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:MyCapture.App.Themes"
        xmlns:gallery="clr-namespace:MyCapture.App.Gallery"
        x:ClassModifier="internal"
        Style="{DynamicResource Window.Standard}"
        Title="{loc:Text Text_37AD4F28D422}"
        Width="1280" Height="760"
        MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface.Base}"
        Foreground="{DynamicResource Text.Primary}">

    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <themes:GalleryWorkspaceResources />
        </ResourceDictionary.MergedDictionaries>

        <!-- Tile action glyphs come from the shared Symbols.xaml resource dictionary
             (Icon.Copy / Icon.Pin / Icon.More / Icon.Ocr / Icon.Delete), referenced by key. -->

        <!-- Gallery actions inherit the shared icon-only states and retain a compact grid fit. -->
        <Style x:Key="Gallery.IconButton" TargetType="Button" BasedOn="{StaticResource Button.Icon.Compact}">
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <DataTemplate x:Key="Gallery.TileTemplate" DataType="{x:Type gallery:GalleryItemViewModel}">
            <!-- A 244px tile plus 6px margins occupies a 256px track, matching
                 GalleryRowBuilder.TileTrackWidth. Four cards now fill the default window
                 without shrinking the image or reducing the accessible action targets. -->
            <Border Width="244" Height="292" Margin="6"
                    Background="{DynamicResource Surface.Raised}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Lg}"
                    SnapsToDevicePixels="True"
                    ToolTip="{Binding ExportToolTip}">
                <Grid Margin="9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="3,0,3,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TimeCaption}" Foreground="{DynamicResource Text.Secondary}" FontFamily="{StaticResource Font.Mono}" />
                        <TextBlock Grid.Column="1" Text="{Binding RetentionCaption}" Foreground="{DynamicResource Text.Muted}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource FontSize.Caption}" />
                    </Grid>
                    <!-- Capture time is always above the image. -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Md}"
                            ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Thumbnail}"
                                   Margin="2"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="{Binding AccessibleName}" />
                            <TextBlock Text="{Binding PreviewUnavailableText}"
                                       Style="{DynamicResource Text.MutedBlock}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsBroken, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Video records remain image-light in the grid: a generated first-frame
                                 preview plus an unmistakable play affordance and exact duration. -->
                            <Border Width="52" Height="52" CornerRadius="26"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{DynamicResource Surface.Badge}"
                                    BorderBrush="{DynamicResource Border.Badge}" BorderThickness="1"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                <Path Data="{StaticResource Icon.Play}"
                                      Width="24" Height="24" Stretch="Uniform"
                                      Fill="{DynamicResource Text.Badge}"
                                      Stroke="{DynamicResource Text.Badge}" StrokeThickness="1.2"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="8" Padding="7,3" CornerRadius="5"
                                    Background="{DynamicResource Surface.BadgeStrong}"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding DurationCaption}"
                                           Foreground="{DynamicResource Text.Badge}"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="{StaticResource FontSize.Caption}" />
                            </Border>

                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Margin="8" Padding="7,3" CornerRadius="5"
                                    Background="{DynamicResource Surface.BadgeStrong}"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Text Text_C11734267E6B}" Foreground="{DynamicResource Text.Badge}"
                                           FontSize="{StaticResource FontSize.Caption}"
                                           FontWeight="SemiBold" />
                            </Border>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Margin="8" Padding="7,3" CornerRadius="5"
                                    Background="{DynamicResource Surface.BadgeStrong}"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Text Text_302BAE127938}" Foreground="{DynamicResource Text.Badge}"
                                           FontSize="{StaticResource FontSize.Caption}"
                                           FontWeight="SemiBold" />
                            </Border>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="8">
                                <Border Padding="8,4" CornerRadius="6"
                                        Background="{DynamicResource Accent.Default}"
                                        Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{loc:Text Text_1300F4BEEC76}" FontSize="{StaticResource FontSize.Caption}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.OnAccent}" />
                                </Border>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="8" Padding="8,4" CornerRadius="6"
                                    Background="{DynamicResource Surface.Floating}"
                                    BorderBrush="{DynamicResource Border.Subtle}"
                                    BorderThickness="1"
                                    Visibility="{Binding HasAnnotations, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Text Text_2C64DDA4D878}" FontSize="{StaticResource FontSize.Caption}"
                                           Foreground="{DynamicResource Text.Secondary}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Caption + time -->
                    <Grid Grid.Row="2" Margin="3,9,3,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Caption}"
                                   Visibility="{Binding HasCaption, Converter={StaticResource BoolToVisibility}}"
                                   Foreground="{DynamicResource Text.Primary}"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSize.Body}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />

                    </Grid>

                    <!-- Visible Float / Copy / Edit, then delete and overflow. -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource Gallery.IconButton}"
                                Margin="0"
                                ToolTip="{loc:Text Gallery.FloatHint}"
                                AutomationProperties.Name="{loc:Text Gallery.Float}"
                                Click="OnFloatClick"
                                Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                            <Path Data="{StaticResource Icon.Pin}" Width="20" Height="20"
                                  Stretch="None"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Fill="Transparent" />
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource Gallery.IconButton}"
                                ToolTip="{loc:Text Text_59D43391538F}"
                                AutomationProperties.Name="{loc:Text Text_42A667BC71B0}"
                                Click="OnCopyClick"
                                Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                            <Path Data="{StaticResource Icon.Copy}" Width="20" Height="20"
                                  Stretch="None"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Fill="Transparent" />
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource Button.Primary}"
                                Width="36" MinWidth="36" MinHeight="36" Padding="6" HorizontalAlignment="Center"
                                ToolTip="{loc:Text Text_0400CF56D074}"
                                AutomationProperties.Name="{loc:Text Text_1003CFC78E66}"
                                Click="OnEditClick">
                            <Path Data="{StaticResource Icon.Edit}" Width="20" Height="20" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round" Fill="Transparent" />
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource Gallery.IconButton}"
                                ToolTip="{loc:Text Text_784572D51B63}"
                                AutomationProperties.Name="{loc:Text Text_89D4979D7596}"
                                Click="OnDeleteClick">
                            <Path Data="{StaticResource Icon.Delete}" Width="20" Height="20"
                                  Stretch="None"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Fill="Transparent" />
                        </Button>

                        <Button Grid.Column="4"
                                Style="{StaticResource Gallery.IconButton}"
                                ToolTip="{loc:Text Text_3793EC0322DB}"
                                AutomationProperties.Name="{loc:Text Text_5E8959D18390}"
                                Click="OnMoreClick">
                            <Path Data="{StaticResource Icon.More}" Width="20" Height="20"
                                  Stretch="None"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                            <Button.ContextMenu>
                                <!-- The context menu inherits the button's DataContext (the tile
                                     view model) via PlacementTarget, and each item carries the tile
                                     as CommandParameter so the handler always resolves the right
                                     record even though menu items are outside the visual tree. -->
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                                   RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="{Binding IsPinned, Converter={StaticResource PinLabel}}"
                                              CommandParameter="{Binding}"
                                              AutomationProperties.Name="{loc:Text Text_80A33648EAF2}"
                                              InputGestureText="P"
                                              Click="OnPinMenuClick" />
                                    <MenuItem Header="{loc:Text Text_854582314EBD}"
                                              CommandParameter="{Binding}"
                                              AutomationProperties.Name="{loc:Text Text_854582314EBD}"
                                              InputGestureText="T"
                                              Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}"
                                              Click="OnOcrMenuClick">
                                        <MenuItem.Icon>
                                            <Path Data="{StaticResource Icon.Ocr}" Width="18" Height="18"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource Text.Secondary}"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Fill="Transparent" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Text Text_D44617983641}"
                                              CommandParameter="{Binding}"
                                              AutomationProperties.Name="{loc:Text Text_D44617983641}"
                                              InputGestureText="G"
                                              Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}"
                                              Click="OnGifMenuClick" />
                                    <Separator />
                                    <MenuItem Header="{loc:Text ExportReduction_Title}"
                                              CommandParameter="{Binding}"
                                              AutomationProperties.Name="{loc:Text ExportReduction_Title}"
                                              Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}"
                                              Click="OnReducedExportClick" />
                                    <MenuItem Header="{loc:Text Text_6139B6C3ED73}"
                                              CommandParameter="{Binding}"
                                              AutomationProperties.Name="{loc:Text Text_6139B6C3ED73}"
                                              InputGestureText="Delete"
                                              Foreground="{DynamicResource State.DangerHover}"
                                              Click="OnDeleteMenuClick">
                                        <MenuItem.Icon>
                                            <Path Data="{StaticResource Icon.Delete}" Width="18" Height="18"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource State.DangerHover}"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Fill="Transparent" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="Gallery.TileRowList" TargetType="ListBox">
            <!-- Rows have no independent scrolling surface: wheel input reaches RowsList. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
            <Setter Property="ItemTemplate" Value="{StaticResource Gallery.TileTemplate}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Outline"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="2"
                                            CornerRadius="{StaticResource Radius.Lg}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Outline" Property="Background" Value="{DynamicResource Surface.Hover}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Outline" Property="Background" Value="{DynamicResource Accent.Subtle}" />
                                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource Border.Accent}" />
                                        </DataTrigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="Gallery.HeaderRowTemplate" DataType="{x:Type gallery:GalleryHeaderRow}">
            <Grid Margin="8,16,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="{Binding Heading}" Style="{StaticResource Button.Secondary}" Click="OnDayClick" AutomationProperties.Name="{Binding Heading}" ToolTip="{loc:Text LibrarySelection_SelectDay}" />
                <Border Grid.Column="1" Height="1" Margin="14,0,0,0"
                        Background="{DynamicResource Border.Subtle}"
                        VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Gallery.TileRowTemplate" DataType="{x:Type gallery:GalleryTileRow}">
            <ListBox Style="{StaticResource Gallery.TileRowList}"
                     ItemsSource="{Binding Tiles}"
                     PreviewKeyDown="OnTileKeyDown"
                     PreviewMouseLeftButtonDown="OnTileMouseLeftButtonDown"
                     MouseDoubleClick="OnTileDoubleClick" />
        </DataTemplate>

        <Style x:Key="Gallery.RowContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContentTemplate" Value="{StaticResource Gallery.TileRowTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Converter={StaticResource IsHeaderRow}}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource Gallery.HeaderRowTemplate}" />

                    <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Gallery.RowsList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource Gallery.RowContainer}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
      </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16,16,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title only; the English all-caps eyebrow is removed. -->
        <Grid Grid.Row="0" Margin="2,0,2,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image Style="{StaticResource Brand.AppIcon}" Margin="0,1,12,0"
                       AutomationProperties.Name="MyCapture" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource Text.Display}" FontSize="26" />
                    <TextBlock Text="{loc:Text Text_13036A090EBA}"
                               Style="{DynamicResource Text.MutedBlock}" Margin="0,5,0,0" MaxWidth="500" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Button.Secondary}" Padding="12,8" Margin="0,0,8,0"
                        ToolTip="{loc:Text Text_2C20ADDA2018}"
                        AutomationProperties.Name="{loc:Text Text_2C20ADDA2018}"
                        Click="OnCaptureRegionClick">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Capture}" Width="16" Height="16" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" StrokeLineJoin="Round" Fill="Transparent" />
                        <TextBlock Text="{loc:Text Text_2C20ADDA2018}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Secondary}" Padding="12,8" Margin="0,0,8,0"
                        ToolTip="{loc:Text Text_4F5AF20FAA6E}"
                        AutomationProperties.Name="{loc:Text Text_4F5AF20FAA6E}"
                        Click="OnRecordRegionClick">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Record}" Width="16" Height="16" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="{loc:Text Text_4F5AF20FAA6E}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Secondary}" Padding="14,8" Click="OnClearLibraryClick" ToolTip="{loc:Text LibrarySelection_ClearHint}">
                    <TextBlock x:Name="SummaryLabel"
                               Text="{Binding SummaryText}"
                               Foreground="{DynamicResource Text.Secondary}"
                               FontSize="{StaticResource FontSize.Body}"
                               AutomationProperties.Name="{Binding SummaryText}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Search -->
        <Border Grid.Row="1" Style="{StaticResource Card.Sunken}"
                Padding="4" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource Icon.Search}"
                      Style="{StaticResource Icon.Glyph.Muted}" Width="18" Height="18"
                      Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBox x:Name="SearchBox" Grid.Column="1"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="10,5" MinHeight="32"
                         AutomationProperties.Name="{loc:Text Text_4B8D541EBE6D}"
                         TextChanged="OnSearchTextChanged" />
                <TextBlock Grid.Column="1" IsHitTestVisible="False"
                           Text="{loc:Text Text_59208AC2B48E}"
                           Foreground="{DynamicResource Text.Muted}"
                           Margin="12,10"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- OCR full-text search coverage banner (Row 2). Shown only when part of the
             library is not yet searchable by the text inside the images, or when no OCR
             language pack is installed. Collapsed by default; the code-behind sets its
             state when the gallery opens and after an indexing pass. -->
        <Border x:Name="OcrCoverageBanner" Grid.Row="2"
                Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="OcrCoverageHeadline"
                               Foreground="{DynamicResource Text.Primary}"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource FontSize.Body}" />
                    <TextBlock x:Name="OcrCoverageDetail"
                               Foreground="{DynamicResource Text.Secondary}"
                               FontSize="{StaticResource FontSize.Caption}"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap" MaxWidth="760"
                               HorizontalAlignment="Left" />
                </StackPanel>
                <Button x:Name="OcrIndexButton" Grid.Column="1"
                        Style="{StaticResource Button.Primary}"
                        Content="{loc:Text Text_C5364F392040}" MinHeight="34"
                        VerticalAlignment="Center" Margin="14,0,0,0"
                        ToolTip="{loc:Text Text_C8FFDDF126A8}"
                        AutomationProperties.Name="{loc:Text Text_4D5F7094119C}"
                        Click="OnOcrIndexClick" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center" Margin="8,0,14,0" />
            <Button Content="{loc:Text LibrarySelection_Delete}" Style="{StaticResource Button.Secondary}" Click="OnDeleteSelectedClick" />
            <Button Content="{loc:Text LibrarySelection_Reduce}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" DataContext="{Binding SingleSelectedTile}" Click="OnReducedExportClick" Visibility="{Binding DataContext.CanReduceSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{loc:Text LibrarySelection_Gif}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" DataContext="{Binding SingleSelectedTile}" Click="OnGifMenuClick" Visibility="{Binding DataContext.CanGifSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <Grid Grid.Row="4" x:Name="GalleryWorkspace"><Grid.ColumnDefinitions><ColumnDefinition Width="136" /><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
<Border x:Name="GalleryFilterRail" Background="{DynamicResource Surface.Raised}" CornerRadius="10" Padding="10" Margin="0,0,10,0"><DockPanel>
<TextBlock DockPanel.Dock="Bottom" Text="{loc:Text Workspace.RetentionHint}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" FontSize="12" Margin="0,16,0,0" />
<StackPanel><TextBlock Text="{loc:Text Workspace.Library}" FontWeight="SemiBold" Margin="4,6,0,16" />
<RadioButton Content="{loc:Text Workspace.All}" Tag="All" GroupName="LibraryFilter" IsChecked="True" Checked="OnLibraryFilterChanged" Margin="0,0,0,14" />
<RadioButton Content="{loc:Text Text_302BAE127938}" Tag="Images" GroupName="LibraryFilter"  Checked="OnLibraryFilterChanged" Margin="0,0,0,14" />
<RadioButton Content="{loc:Text Text_C11734267E6B}" Tag="Videos" GroupName="LibraryFilter"  Checked="OnLibraryFilterChanged" Margin="0,0,0,14" />
<RadioButton Content="{loc:Text Workspace.Pinned}" Tag="Pinned" GroupName="LibraryFilter"  Checked="OnLibraryFilterChanged" Margin="0,0,0,14" />
</StackPanel></DockPanel></Border>
<Border x:Name="GalleryDetailsPanel" Grid.Column="2" Background="{DynamicResource Surface.Raised}" CornerRadius="10" Padding="14" Margin="8,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<TextBlock Text="{loc:Text Workspace.Details}" Style="{DynamicResource Text.Section}" Margin="0,0,0,14" />
<TextBlock Text="{loc:Text Workspace.SelectHint}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SingleSelectedTile}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<StackPanel DataContext="{Binding SingleSelectedTile}"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
<Border Height="136" Background="{DynamicResource Surface.Sunken}" CornerRadius="8"><Image x:Name="SelectedDetailThumbnail" Source="{Binding Thumbnail}" Stretch="Uniform" AutomationProperties.Name="{Binding AccessibleName}" /></Border>
<TextBlock Text="{Binding ContextLabel}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,8" />
<TextBlock Text="{Binding TimeCaption}" Foreground="{DynamicResource Text.Secondary}" />
<TextBlock Text="{Binding DetailDimensions}" Foreground="{DynamicResource Text.Secondary}" Margin="0,6,0,0" />
<TextBlock Text="{Binding RetentionCaption}" Foreground="{DynamicResource Text.Muted}" Margin="0,6,0,16" />
<Button Content="{Binding ActionLabel}" Style="{StaticResource Button.Primary}" Click="OnEditClick" />
<Button Content="{loc:Text Gallery.Float}" Style="{StaticResource Button.Secondary}" Margin="0,8,0,0" Click="OnFloatClick" Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
<Button Content="{loc:Text Text_42A667BC71B0}" Style="{StaticResource Button.Secondary}" Margin="0,8,0,0" Click="OnCopyClick" Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
<TextBlock Text="{loc:Text Workspace.EditHint}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" FontSize="12" Margin="0,16,0,0" />
</StackPanel></StackPanel></ScrollViewer></Border>

            <ListBox x:Name="RowsList" Grid.Column="1"
                     Style="{StaticResource Gallery.RowsList}"
                     ItemsSource="{Binding Rows}"
                     SizeChanged="OnRowsListSizeChanged" />

            <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource Card}" Padding="42,30"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel MaxWidth="380">
                    <TextBlock Text="{loc:Text Text_8773C2A9C3EA}"
                               Style="{DynamicResource Text.Title}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyStateLabel"
                               Text="{Binding EmptyStateText}"
                               Style="{DynamicResource Text.MutedBlock}"
                               Margin="0,8,0,0"
                               TextAlignment="Center"
                               AutomationProperties.Name="{Binding EmptyStateText}" />
                </StackPanel>
            </Border>

            <Border x:Name="InlineVideoPanel" Grid.Column="2"
                    Width="240" Margin="0"
                    Style="{StaticResource Card}" Padding="14"
                    VerticalAlignment="Top" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Text Text_7CB3F50C1B9F}" Style="{DynamicResource Text.Section}" />
                            <TextBlock x:Name="InlineVideoTitle" Text="{loc:Text Text_C11734267E6B}"
                                       Style="{DynamicResource Text.MutedBlock}"
                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{loc:Text Text_1E8C10206F5B}"
                                Style="{StaticResource Button.Ghost}"
                                Click="OnInlineCloseClick"
                                AutomationProperties.Name="{loc:Text Text_EC38F786B534}" />
                    </Grid>

                    <Border Height="136" Background="Black" CornerRadius="8"
                            ClipToBounds="True">
                        <MediaElement x:Name="InlineVideo"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Manual"
                                      Stretch="Uniform"
                                      ScrubbingEnabled="True"
                                      IsMuted="True" Volume="0"
                                      MediaOpened="OnInlineMediaOpened"
                                      MediaEnded="OnInlineMediaEnded"
                                      MediaFailed="OnInlineMediaFailed" />
                    </Border>

                    <Slider x:Name="InlineSeekSlider" Margin="0,10,0,0"
                            Minimum="0" Maximum="1" Value="0"
                            IsMoveToPointEnabled="True"
                            ValueChanged="OnInlineSeekChanged"
                            AutomationProperties.Name="{loc:Text Text_9DDB97F03D7D}" />
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="InlinePlayButton" Content="{loc:Text Text_D43A776C5E28}"
                                Style="{StaticResource Button.Primary}"
                                MinWidth="76" Click="OnInlinePlayClick" />
                        <TextBlock x:Name="InlinePlaybackStatus" Grid.Column="1"
                                   Text="{loc:Text Text_6E86D1A85620}"
                                   Style="{DynamicResource Text.MutedBlock}"
                                   VerticalAlignment="Center" Margin="10,0" />
                        <TextBlock x:Name="InlineTimeLabel" Grid.Column="2"
                                   Text="00:00 / 00:00"
                                   FontFamily="{StaticResource Font.Mono}"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
