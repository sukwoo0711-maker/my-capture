<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MyCapture.App</RootNamespace>
    <AssemblyName>MyCapture</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>ko-KR;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyCapture.Core\MyCapture.Core.csproj" />
    <ProjectReference Include="..\MyCapture.Platform\MyCapture.Platform.csproj" />
    <ProjectReference Include="..\MyCapture.Ocr\MyCapture.Ocr.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyCapture.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\tray-idle.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\tray-capturing.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\tray-busy.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
