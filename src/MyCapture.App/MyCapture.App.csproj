<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MyCapture.App</RootNamespace>
    <AssemblyName>MyCapture</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>ko-KR;en</SatelliteResourceLanguages>
    <!-- Keep the release RID in project.assets.json after an ordinary solution restore so
         the self-contained package can later be reproduced without another restore. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- Render selected glyphs with SelectionTextBrush instead of painting an adorner over them. -->
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Controls.Text.UseAdornerForTextboxSelectionRendering" Value="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MyCapture.Core\MyCapture.Core.csproj" />
    <ProjectReference Include="..\MyCapture.Platform\MyCapture.Platform.csproj" />
    <ProjectReference Include="..\MyCapture.Ocr\MyCapture.Ocr.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyCapture.App.Tests" />
    <!-- Renders the tutorial clips from this source (build/tools/TutorialVideoGenerator); never shipped. -->
    <InternalsVisibleTo Include="MyCapture.TutorialGenerator" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="RapidOcrNet" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\app.ico" />
    <Resource Include="Assets\app.ico" />
    <None Update="Assets\tray-idle.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\tray-capturing.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\tray-busy.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\tray-error.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature tutorials (TutorialCatalog × ko/en) and their first-frame stills, rendered by build/tools/TutorialVideoGenerator. -->
    <None Update="Assets\Tutorials\*.mp4;Assets\Tutorials\*.jpg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup><EmbeddedResource Include="Updates\UpdateHelper.ps1" LogicalName="MyCapture.UpdateHelper.ps1" /></ItemGroup>

  <ItemGroup>
    <!-- Bundled fonts ship as files beside the app, not as pack:// resources. WPF reads local font
         files through DirectWrite's own file loader; resource fonts go through a managed stream
         that the font system can call back into after the runtime has shut down (a fail-fast at
         process exit on .NET 10.0.13). -->
    <None Update="Assets\Fonts\**\*.ttf;Assets\Fonts\**\*.otf;Assets\Fonts\**\*.ttc;Assets\Fonts\**\OFL.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
