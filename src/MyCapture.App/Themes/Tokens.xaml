<!--
  MyCapture design tokens: primitive values -> semantic aliases -> component dimensions.

  Direction (warm-yellow-charcoal-ux.md, "Visual system"):
    * Captured pixels stay dominant on warm charcoal surfaces with clear depth hierarchy.
    * A saturated, friendly yellow is reserved for primary actions, selection, and focus.
    * Yellow fills always use dark ink; white-on-yellow is intentionally prohibited.
    * Normal UI is flat and token-driven: no decorative gradients and no cool-blue chrome.

  Compatibility: every previously shipped resource key remains available. Legacy Graphite,
  Slate, Blue, and Violet keys are aliases into the warm system so consuming windows and any
  restored XAML continue to resolve without migration.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================= -->
    <!-- Primitive colour ramp: warm charcoal and cream neutrals       -->
    <!-- ============================================================= -->
    <Color x:Key="Primitive.Warm980">#FF14110C</Color> <!-- canvas / deepest -->
    <Color x:Key="Primitive.Warm950">#FF1B1712</Color> <!-- app base -->
    <Color x:Key="Primitive.Warm900">#FF221D17</Color> <!-- raised rail / inspector -->
    <Color x:Key="Primitive.Warm850">#FF2A241C</Color> <!-- controls / overlay -->
    <Color x:Key="Primitive.Warm800">#FF342D23</Color> <!-- hover / floating -->
    <Color x:Key="Primitive.Warm700">#FF3E362A</Color> <!-- pressed -->
    <Color x:Key="Primitive.Warm600">#FF6B6152</Color> <!-- strong boundary -->
    <Color x:Key="Primitive.Warm500">#FF40382C</Color> <!-- subtle divider -->
    <Color x:Key="Primitive.Warm400">#FFA79A86</Color> <!-- muted text -->
    <Color x:Key="Primitive.Warm300">#FFD8CFC0</Color> <!-- secondary text -->
    <Color x:Key="Primitive.Warm100">#FFF5F1E8</Color> <!-- primary text -->
    <Color x:Key="Primitive.White">#FFFFFFFF</Color>

    <!-- Friendly yellow brand ramp. Dark ink is the only text colour on these fills. -->
    <Color x:Key="Primitive.Yellow300">#FFFFE14D</Color> <!-- focus / selected glyph -->
    <Color x:Key="Primitive.Yellow400">#FFFFD400</Color> <!-- primary / hover emphasis -->
    <Color x:Key="Primitive.Yellow500">#FFF7C948</Color> <!-- border accent -->
    <Color x:Key="Primitive.Yellow600">#FFE0AE1F</Color> <!-- pressed -->
    <Color x:Key="Primitive.Yellow900">#FF3A2E10</Color> <!-- selected wash -->
    <Color x:Key="Primitive.Ink">#FF191207</Color>

    <!-- Status colours stay semantically distinct from the brand yellow. -->
    <Color x:Key="Primitive.Orange400">#FFF09A4A</Color>
    <Color x:Key="Primitive.Emerald400">#FF5BC58A</Color>
    <Color x:Key="Primitive.Red500">#FFE45C52</Color>
    <Color x:Key="Primitive.Red400">#FFFF8178</Color>

    <!-- Legacy primitive aliases. Values intentionally map to the warm system. -->
    <Color x:Key="Primitive.Graphite980">#FF14110C</Color>
    <Color x:Key="Primitive.Graphite950">#FF1B1712</Color>
    <Color x:Key="Primitive.Graphite900">#FF221D17</Color>
    <Color x:Key="Primitive.Graphite850">#FF2A241C</Color>
    <Color x:Key="Primitive.Graphite800">#FF342D23</Color>
    <Color x:Key="Primitive.Graphite700">#FF3E362A</Color>
    <Color x:Key="Primitive.Graphite600">#FF6B6152</Color>
    <Color x:Key="Primitive.Graphite500">#FF40382C</Color>
    <Color x:Key="Primitive.Graphite400">#FFA79A86</Color>
    <Color x:Key="Primitive.Graphite300">#FFD8CFC0</Color>
    <Color x:Key="Primitive.Graphite100">#FFF5F1E8</Color>

    <Color x:Key="Primitive.Slate950">#FF14110C</Color>
    <Color x:Key="Primitive.Slate900">#FF1B1712</Color>
    <Color x:Key="Primitive.Slate850">#FF221D17</Color>
    <Color x:Key="Primitive.Slate800">#FF2A241C</Color>
    <Color x:Key="Primitive.Slate700">#FF40382C</Color>
    <Color x:Key="Primitive.Slate600">#FF6B6152</Color>
    <Color x:Key="Primitive.Slate400">#FFA79A86</Color>
    <Color x:Key="Primitive.Slate300">#FFD8CFC0</Color>
    <Color x:Key="Primitive.Slate100">#FFF5F1E8</Color>

    <Color x:Key="Primitive.Blue300">#FFFFE14D</Color>
    <Color x:Key="Primitive.Blue400">#FFFFD400</Color>
    <Color x:Key="Primitive.Blue500">#FFFFD400</Color>
    <Color x:Key="Primitive.Blue600">#FFE0AE1F</Color>
    <Color x:Key="Primitive.Blue900">#FF3A2E10</Color>
    <Color x:Key="Primitive.Violet400">#FFFFE14D</Color>
    <Color x:Key="Primitive.Violet500">#FFFFD400</Color>
    <Color x:Key="Primitive.Violet600">#FFE0AE1F</Color>
    <Color x:Key="Primitive.Violet900">#FF3A2E10</Color>
    <Color x:Key="Primitive.Amber400">#FFF09A4A</Color>
    <Color x:Key="Primitive.Emerald500">#FF5BC58A</Color>

    <!-- ============================================================= -->
    <!-- Semantic surfaces                                             -->
    <!-- ============================================================= -->
    <SolidColorBrush x:Key="Surface.Canvas" Color="{StaticResource Primitive.Warm980}" />
    <SolidColorBrush x:Key="Surface.Base" Color="{StaticResource Primitive.Warm950}" />
    <SolidColorBrush x:Key="Surface.Raised" Color="{StaticResource Primitive.Warm900}" />
    <SolidColorBrush x:Key="Surface.Overlay" Color="{StaticResource Primitive.Warm850}" />
    <SolidColorBrush x:Key="Surface.Floating" Color="#F22A241C" />
    <SolidColorBrush x:Key="Surface.Sunken" Color="{StaticResource Primitive.Warm980}" />
    <SolidColorBrush x:Key="Surface.Hover" Color="{StaticResource Primitive.Warm800}" />
    <SolidColorBrush x:Key="Surface.Pressed" Color="{StaticResource Primitive.Warm700}" />
    <SolidColorBrush x:Key="Surface.Scrim" Color="#B80A0805" />

    <!-- ============================================================= -->
    <!-- Semantic text: AA body pairings on intended warm surfaces     -->
    <!-- ============================================================= -->
    <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Primitive.Warm100}" />
    <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Primitive.Warm300}" />
    <SolidColorBrush x:Key="Text.Muted" Color="{StaticResource Primitive.Warm400}" />
    <SolidColorBrush x:Key="Text.OnAccent" Color="{StaticResource Primitive.Ink}" />

    <!-- ============================================================= -->
    <!-- Accent and state                                              -->
    <!-- ============================================================= -->
    <SolidColorBrush x:Key="Accent.Default" Color="{StaticResource Primitive.Yellow400}" />
    <SolidColorBrush x:Key="Accent.Hover" Color="{StaticResource Primitive.Yellow300}" />
    <SolidColorBrush x:Key="Accent.Pressed" Color="{StaticResource Primitive.Yellow600}" />
    <SolidColorBrush x:Key="Accent.Subtle" Color="{StaticResource Primitive.Yellow900}" />
    <SolidColorBrush x:Key="Accent.Cool" Color="{StaticResource Primitive.Yellow300}" />

    <!-- Compatibility alias: deliberately flat, never a GradientBrush. -->
    <SolidColorBrush x:Key="Accent.Gradient" Color="{StaticResource Primitive.Yellow400}" />

    <SolidColorBrush x:Key="State.Warning" Color="{StaticResource Primitive.Orange400}" />
    <SolidColorBrush x:Key="State.Success" Color="{StaticResource Primitive.Emerald400}" />
    <SolidColorBrush x:Key="State.Danger" Color="{StaticResource Primitive.Red500}" />
    <SolidColorBrush x:Key="State.DangerHover" Color="{StaticResource Primitive.Red400}" />

    <!-- ============================================================= -->
    <!-- Borders and focus                                             -->
    <!-- ============================================================= -->
    <SolidColorBrush x:Key="Border.Subtle" Color="{StaticResource Primitive.Warm500}" />
    <SolidColorBrush x:Key="Border.Strong" Color="{StaticResource Primitive.Warm600}" />
    <SolidColorBrush x:Key="Border.Focus" Color="{StaticResource Primitive.Yellow300}" />
    <SolidColorBrush x:Key="Border.Accent" Color="{StaticResource Primitive.Yellow500}" />

    <!-- ============================================================= -->
    <!-- Capture overlay                                               -->
    <!-- ============================================================= -->
    <SolidColorBrush x:Key="Overlay.Dimmer" Color="#FF0A0805" Opacity="0.48" />
    <SolidColorBrush x:Key="Overlay.SelectionBorder" Color="{StaticResource Primitive.Yellow300}" />
    <SolidColorBrush x:Key="Overlay.HandleFill" Color="{StaticResource Primitive.Warm100}" />
    <SolidColorBrush x:Key="Overlay.HandleStroke" Color="{StaticResource Primitive.Yellow600}" />

    <!-- ============================================================= -->
    <!-- 4px spacing rhythm (principal steps 8/12/16/24/32)            -->
    <!-- ============================================================= -->
    <sys:Double x:Key="Space.Xs">4</sys:Double>
    <sys:Double x:Key="Space.Sm">8</sys:Double>
    <sys:Double x:Key="Space.Md">12</sys:Double>
    <sys:Double x:Key="Space.Lg">16</sys:Double>
    <sys:Double x:Key="Space.Xl">24</sys:Double>
    <sys:Double x:Key="Space.Xxl">32</sys:Double>
    <sys:Double x:Key="Space.Hero">40</sys:Double>

    <Thickness x:Key="Padding.Control">14,8,14,8</Thickness>
    <Thickness x:Key="Padding.Panel">20</Thickness>
    <Thickness x:Key="Padding.Card">18</Thickness>
    <Thickness x:Key="Padding.Toolbar">10</Thickness>

    <!-- ============================================================= -->
    <!-- Shape: friendly but restrained rounding                       -->
    <!-- ============================================================= -->
    <CornerRadius x:Key="Radius.Sm">7</CornerRadius>
    <CornerRadius x:Key="Radius.Md">10</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">14</CornerRadius>
    <CornerRadius x:Key="Radius.Xl">18</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- ============================================================= -->
    <!-- Typography: local system fonts only (offline-safe)            -->
    <!-- ============================================================= -->
    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI, Malgun Gothic, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI, Malgun Gothic, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Malgun Gothic, monospace</FontFamily>

    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Control">13</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">17</sys:Double>
    <sys:Double x:Key="FontSize.Title">24</sys:Double>
    <sys:Double x:Key="FontSize.Display">28</sys:Double>

    <!-- ============================================================= -->
    <!-- Motion: shared Windows-aligned cadence. Render transforms and opacity only;
         precision capture geometry and semantic state changes never wait on motion. -->
    <!-- ============================================================= -->
    <Duration x:Key="Motion.Fast">0:0:0.083</Duration>
    <Duration x:Key="Motion.Normal">0:0:0.167</Duration>
    <Duration x:Key="Motion.Deliberate">0:0:0.250</Duration>
    <CubicEase x:Key="Motion.Ease.Standard" EasingMode="EaseOut" />
    <QuadraticEase x:Key="Motion.Ease.SoftLanding" EasingMode="EaseOut" />

    <!-- ============================================================= -->
    <!-- Desktop component sizing                                     -->
    <!-- ============================================================= -->
    <sys:Double x:Key="Size.HitTarget">36</sys:Double>
    <sys:Double x:Key="Size.HitTarget.Compact">32</sys:Double>
    <sys:Double x:Key="Size.IconGlyph">16</sys:Double>
    <sys:Double x:Key="Size.RailButton">44</sys:Double>

    <!-- ============================================================= -->
    <!-- Elevation: warm neutral shadow, floating surfaces only        -->
    <!-- ============================================================= -->
    <DropShadowEffect x:Key="Shadow.Floating"
                      BlurRadius="28" ShadowDepth="8" Opacity="0.38" Color="#FF0A0805" />
    <DropShadowEffect x:Key="Shadow.Card"
                      BlurRadius="14" ShadowDepth="3" Opacity="0.24" Color="#FF0A0805" />
</ResourceDictionary>
