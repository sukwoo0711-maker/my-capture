<!--
  MyCapture design tokens: primitive values -> semantic aliases -> component dimensions.

  Direction (design-system/mycapture/MASTER.md, "Focus Portal"):
    * Captured pixels stay dominant on quiet graphite surfaces with clear depth hierarchy.
    * Focus cyan is reserved for primary actions, selection, and keyboard focus.
    * Accent fills always use dark ink; white-on-cyan is intentionally prohibited.
    * Normal UI is flat and token-driven: no decorative gradients or unowned raw colours.

  Compatibility: every previously shipped resource key remains available. Legacy Warm,
  Slate, Blue, Yellow, and Violet keys alias the Focus Blue system so consuming windows and any
  restored XAML continue to resolve without migration.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================= -->
    <!-- Primitive colour ramp: precision graphite and cool neutrals   -->
    <!-- ============================================================= -->
    <Color x:Key="Primitive.Warm980">#FF080C12</Color> <!-- canvas / deepest -->
    <Color x:Key="Primitive.Warm950">#FF0B0F17</Color> <!-- app base -->
    <Color x:Key="Primitive.Warm900">#FF101722</Color> <!-- raised rail / inspector -->
    <Color x:Key="Primitive.Warm850">#FF151E2B</Color> <!-- controls / overlay -->
    <Color x:Key="Primitive.Warm800">#FF1B2636</Color> <!-- hover / floating -->
    <Color x:Key="Primitive.Warm700">#FF243246</Color> <!-- pressed -->
    <Color x:Key="Primitive.Warm600">#FF475973</Color> <!-- strong boundary -->
    <Color x:Key="Primitive.Warm500">#FF2B3A50</Color> <!-- subtle divider -->
    <Color x:Key="Primitive.Warm400">#FF8E9CAF</Color> <!-- muted text -->
    <Color x:Key="Primitive.Warm300">#FFC6D0DF</Color> <!-- secondary text -->
    <Color x:Key="Primitive.Warm100">#FFF6F8FC</Color> <!-- primary text -->
    <Color x:Key="Primitive.White">#FFFFFFFF</Color>

    <!-- Focus cyan brand ramp. Dark ink is the only text colour on these fills. -->
    <Color x:Key="Primitive.Yellow300">#FF7DD7F8</Color> <!-- focus / hover -->
    <Color x:Key="Primitive.Yellow400">#FF58C7F3</Color> <!-- primary -->
    <Color x:Key="Primitive.Yellow500">#FF58C7F3</Color> <!-- border accent -->
    <Color x:Key="Primitive.Yellow600">#FF38A8D8</Color> <!-- pressed -->
    <Color x:Key="Primitive.Yellow900">#FF152F3E</Color> <!-- selected wash -->
    <Color x:Key="Primitive.Ink">#FF061116</Color>

    <!-- Status colours stay semantically distinct from the brand yellow. -->
    <Color x:Key="Primitive.Orange400">#FFF5B942</Color>
    <Color x:Key="Primitive.Emerald400">#FF45D6A2</Color>
    <Color x:Key="Primitive.Red500">#FFFF6B74</Color>
    <Color x:Key="Primitive.Red400">#FFFF8A91</Color>

    <!-- Canonical and legacy primitive aliases. -->
    <Color x:Key="Primitive.Graphite980">#FF080C12</Color>
    <Color x:Key="Primitive.Graphite950">#FF0B0F17</Color>
    <Color x:Key="Primitive.Graphite900">#FF101722</Color>
    <Color x:Key="Primitive.Graphite850">#FF151E2B</Color>
    <Color x:Key="Primitive.Graphite800">#FF1B2636</Color>
    <Color x:Key="Primitive.Graphite700">#FF243246</Color>
    <Color x:Key="Primitive.Graphite600">#FF475973</Color>
    <Color x:Key="Primitive.Graphite500">#FF2B3A50</Color>
    <Color x:Key="Primitive.Graphite400">#FF8E9CAF</Color>
    <Color x:Key="Primitive.Graphite300">#FFC6D0DF</Color>
    <Color x:Key="Primitive.Graphite100">#FFF6F8FC</Color>

    <Color x:Key="Primitive.Slate950">#FF080C12</Color>
    <Color x:Key="Primitive.Slate900">#FF0B0F17</Color>
    <Color x:Key="Primitive.Slate850">#FF101722</Color>
    <Color x:Key="Primitive.Slate800">#FF151E2B</Color>
    <Color x:Key="Primitive.Slate700">#FF2B3A50</Color>
    <Color x:Key="Primitive.Slate600">#FF475973</Color>
    <Color x:Key="Primitive.Slate400">#FF8E9CAF</Color>
    <Color x:Key="Primitive.Slate300">#FFC6D0DF</Color>
    <Color x:Key="Primitive.Slate100">#FFF6F8FC</Color>

    <Color x:Key="Primitive.Blue300">#FF7DD7F8</Color>
    <Color x:Key="Primitive.Blue400">#FF58C7F3</Color>
    <Color x:Key="Primitive.Blue500">#FF58C7F3</Color>
    <Color x:Key="Primitive.Blue600">#FF38A8D8</Color>
    <Color x:Key="Primitive.Blue900">#FF152F3E</Color>
    <Color x:Key="Primitive.Violet400">#FF7DD7F8</Color>
    <Color x:Key="Primitive.Violet500">#FF58C7F3</Color>
    <Color x:Key="Primitive.Violet600">#FF38A8D8</Color>
    <Color x:Key="Primitive.Violet900">#FF152F3E</Color>
    <Color x:Key="Primitive.Amber400">#FFF5B942</Color>
    <Color x:Key="Primitive.Emerald500">#FF45D6A2</Color>

    <!-- ============================================================= -->
    <!-- Semantic surfaces                                             -->
    <!-- ============================================================= -->
    <SolidColorBrush x:Key="Surface.Canvas" Color="{StaticResource Primitive.Warm980}" />
    <SolidColorBrush x:Key="Surface.Base" Color="{StaticResource Primitive.Warm950}" />
    <SolidColorBrush x:Key="Surface.Raised" Color="{StaticResource Primitive.Warm900}" />
    <SolidColorBrush x:Key="Surface.Overlay" Color="{StaticResource Primitive.Warm850}" />
    <SolidColorBrush x:Key="Surface.Floating" Color="#F2151E2B" />
    <SolidColorBrush x:Key="Surface.Sunken" Color="{StaticResource Primitive.Warm980}" />
    <SolidColorBrush x:Key="Surface.Hover" Color="{StaticResource Primitive.Warm800}" />
    <SolidColorBrush x:Key="Surface.Pressed" Color="{StaticResource Primitive.Warm700}" />
    <SolidColorBrush x:Key="Surface.Scrim" Color="#C2080C12" />
    <SolidColorBrush x:Key="Surface.Badge" Color="#E6080C12" />
    <SolidColorBrush x:Key="Surface.BadgeStrong" Color="#F2080C12" />

    <!-- ============================================================= -->
    <!-- Semantic text: AA body pairings on intended warm surfaces     -->
    <!-- ============================================================= -->
    <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Primitive.Warm100}" />
    <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Primitive.Warm300}" />
    <SolidColorBrush x:Key="Text.Muted" Color="{StaticResource Primitive.Warm400}" />
    <SolidColorBrush x:Key="Text.OnAccent" Color="{StaticResource Primitive.Ink}" />
    <SolidColorBrush x:Key="Text.Badge" Color="{StaticResource Primitive.White}" />

    <!-- ============================================================= -->
    <!-- Accent and state                                              -->
    <!-- ============================================================= -->
    <SolidColorBrush x:Key="Accent.Default" Color="{StaticResource Primitive.Yellow400}" />
    <SolidColorBrush x:Key="Accent.Hover" Color="{StaticResource Primitive.Yellow300}" />
    <SolidColorBrush x:Key="Accent.Pressed" Color="{StaticResource Primitive.Yellow600}" />
    <SolidColorBrush x:Key="Accent.Subtle" Color="{StaticResource Primitive.Yellow900}" />
    <SolidColorBrush x:Key="Accent.Cool" Color="{StaticResource Primitive.Yellow300}" />

    <!-- Compatibility alias: deliberately flat, never a GradientBrush. -->
    <SolidColorBrush x:Key="Accent.Gradient" Color="{StaticResource Primitive.Yellow400}" />

    <SolidColorBrush x:Key="State.Warning" Color="{StaticResource Primitive.Orange400}" />
    <SolidColorBrush x:Key="State.Success" Color="{StaticResource Primitive.Emerald400}" />
    <SolidColorBrush x:Key="State.Danger" Color="{StaticResource Primitive.Red500}" />
    <SolidColorBrush x:Key="State.DangerHover" Color="{StaticResource Primitive.Red400}" />

    <!-- ============================================================= -->
    <!-- Borders and focus                                             -->
    <!-- ============================================================= -->
    <SolidColorBrush x:Key="Border.Subtle" Color="{StaticResource Primitive.Warm500}" />
    <SolidColorBrush x:Key="Border.Strong" Color="{StaticResource Primitive.Warm600}" />
    <SolidColorBrush x:Key="Border.Focus" Color="{StaticResource Primitive.Yellow300}" />
    <SolidColorBrush x:Key="Border.Accent" Color="{StaticResource Primitive.Yellow500}" />
    <SolidColorBrush x:Key="Border.Badge" Color="#66F6F8FC" />

    <!-- Video timeline semantics: layer identity, playhead, and destructive trim. -->
    <SolidColorBrush x:Key="Timeline.Background" Color="{StaticResource Primitive.Graphite950}" />
    <SolidColorBrush x:Key="Timeline.Track" Color="{StaticResource Primitive.Graphite850}" />
    <SolidColorBrush x:Key="Timeline.TextLayer" Color="#FF3B82F6" />
    <SolidColorBrush x:Key="Timeline.FrameLayer" Color="#FF9B7EDE" />
    <SolidColorBrush x:Key="Timeline.Grid" Color="{StaticResource Primitive.Graphite500}" />
    <SolidColorBrush x:Key="Timeline.Playhead" Color="{StaticResource Primitive.Yellow300}" />
    <SolidColorBrush x:Key="Timeline.TrimDeleteFill" Color="#55FF6B74" />
    <SolidColorBrush x:Key="Timeline.TrimDeleteHandle" Color="{StaticResource Primitive.Red400}" />
    <SolidColorBrush x:Key="Timeline.TrimDeleteHatch" Color="#CCFFB0B6" />

    <!-- ============================================================= -->
    <!-- Capture overlay                                               -->
    <!-- ============================================================= -->
    <SolidColorBrush x:Key="Overlay.Dimmer" Color="#FF080C12" Opacity="0.52" />
    <SolidColorBrush x:Key="Overlay.SelectionBorder" Color="{StaticResource Primitive.Yellow300}" />
    <SolidColorBrush x:Key="Overlay.HandleFill" Color="{StaticResource Primitive.Warm100}" />
    <SolidColorBrush x:Key="Overlay.HandleStroke" Color="{StaticResource Primitive.Yellow600}" />

    <!-- ============================================================= -->
    <!-- 4px spacing rhythm (principal steps 8/12/16/24/32)            -->
    <!-- ============================================================= -->
    <sys:Double x:Key="Space.Xs">4</sys:Double>
    <sys:Double x:Key="Space.Sm">8</sys:Double>
    <sys:Double x:Key="Space.Md">12</sys:Double>
    <sys:Double x:Key="Space.Lg">16</sys:Double>
    <sys:Double x:Key="Space.Xl">24</sys:Double>
    <sys:Double x:Key="Space.Xxl">32</sys:Double>
    <sys:Double x:Key="Space.Hero">40</sys:Double>

    <Thickness x:Key="Padding.Control">14,8,14,8</Thickness>
    <Thickness x:Key="Padding.Panel">20</Thickness>
    <Thickness x:Key="Padding.Card">18</Thickness>
    <Thickness x:Key="Padding.Toolbar">10</Thickness>

    <!-- ============================================================= -->
    <!-- Shape: precise, compact, and consistently rounded             -->
    <!-- ============================================================= -->
    <CornerRadius x:Key="Radius.Sm">6</CornerRadius>
    <CornerRadius x:Key="Radius.Md">8</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">12</CornerRadius>
    <CornerRadius x:Key="Radius.Xl">16</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- ============================================================= -->
    <!-- Typography: local system fonts only (offline-safe)            -->
    <!-- ============================================================= -->
    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI, Malgun Gothic, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI, Malgun Gothic, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Malgun Gothic, monospace</FontFamily>

    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Control">13</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">17</sys:Double>
    <sys:Double x:Key="FontSize.Title">24</sys:Double>
    <sys:Double x:Key="FontSize.Display">28</sys:Double>

    <!-- ============================================================= -->
    <!-- Motion: shared Windows-aligned cadence. Render transforms and opacity only;
         precision capture geometry and semantic state changes never wait on motion. -->
    <!-- ============================================================= -->
    <Duration x:Key="Motion.Fast">0:0:0.083</Duration>
    <Duration x:Key="Motion.Normal">0:0:0.167</Duration>
    <Duration x:Key="Motion.Deliberate">0:0:0.250</Duration>
    <CubicEase x:Key="Motion.Ease.Standard" EasingMode="EaseOut" />
    <QuadraticEase x:Key="Motion.Ease.SoftLanding" EasingMode="EaseOut" />

    <!-- ============================================================= -->
    <!-- Desktop component sizing                                     -->
    <!-- ============================================================= -->
    <sys:Double x:Key="Size.HitTarget">36</sys:Double>
    <sys:Double x:Key="Size.HitTarget.Compact">32</sys:Double>
    <sys:Double x:Key="Size.IconGlyph">16</sys:Double>
    <sys:Double x:Key="Size.RailButton">44</sys:Double>

    <!-- ============================================================= -->
    <!-- Elevation: neutral shadow, floating surfaces only             -->
    <!-- ============================================================= -->
    <DropShadowEffect x:Key="Shadow.Floating"
                      BlurRadius="28" ShadowDepth="8" Opacity="0.42" Color="#FF02050A" />
    <DropShadowEffect x:Key="Shadow.Card"
                      BlurRadius="14" ShadowDepth="3" Opacity="0.28" Color="#FF02050A" />
</ResourceDictionary>
