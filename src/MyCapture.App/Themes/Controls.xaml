<!--
  MyCapture shared control styles.

  Direction (Focus Portal, with Windows-native glass palettes):
    * Quiet graphite hierarchy with one iris action/focus accent. Glass themes keep
      the same keys and let DWM Mica show through translucent Surface brushes.
    * Accent fills always pair with Text.OnAccent dark ink, including checks and glyphs.
    * Focus visuals are STABLE: templates never change BorderThickness on focus. Focus is
      shown by recolouring the fixed chrome border and revealing an inset ring with no layout
      footprint, so keyboard navigation never shifts neighbouring content.
    * Interaction states are overlay layers over the rest chrome. Triggers set
      FluidMotion.FadeTo on a layer: hover and press fade over Motion.Fast, selection and
      check indicators over Motion.Normal, and everything snaps when Windows animation
      effects are off. Shared brushes are never animated; only layer opacity moves.
    * Border.Subtle draws decorative lines; control outlines use Border.Control.
    * Every existing style/key is preserved for restored windows and external references.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:themes="clr-namespace:MyCapture.App.Themes">

    <!-- ============================================================= -->
    <!-- Window -->
    <!-- ============================================================= -->
    <!--
      WPF does not apply an implicit Window style to classes derived from Window. Keep a
      keyed style so every real application window can opt in explicitly, while retaining
      the implicit alias for plain Window hosts used by small dialogs and tests.
    -->
    <Style x:Key="Window.Standard" TargetType="{x:Type Window}">
        <Setter Property="Icon" Value="/MyCapture;component/Assets/app.ico" />
        <Setter Property="Background" Value="{DynamicResource Surface.Base}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="themes:ModernWindowChrome.Enabled" Value="True" />
        <Setter Property="themes:FluidMotion.WindowEntrance" Value="True" />
    </Style>
    <Style TargetType="{x:Type Window}" BasedOn="{StaticResource Window.Standard}" />

    <!-- ============================================================= -->
    <!-- Typography helpers -->
    <!-- ============================================================= -->
    <Style x:Key="Text.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>
    <Style x:Key="Text.Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Subtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.MutedBlock" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Mono caption for dimensions / timing / shortcuts. -->
    <Style x:Key="Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
    </Style>

    <!-- ============================================================= -->
    <!-- Cards -->
    <!-- ============================================================= -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Lg}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Card.Sunken" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
    </Style>
    <!-- Neutral information card: no heavy accent wash. Subtle accent border only. -->
    <Style x:Key="Card.Accent" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Accent}" />
    </Style>

    <!-- ============================================================= -->
    <!-- Buttons: three tiers                                            -->
    <!--   Primary   (Button.Primary)   filled accent: the one main action of a screen.  -->
    <!--   Secondary (Button.Secondary, the base, Button.Compact) bordered.               -->
    <!--   Tool      (Button.Ghost, GhostCompact, Icon, Danger) borderless; hover only    -->
    <!--             washes the background, so no border ever appears or disappears.      -->
    <!--   Disabled keeps each tier's shape (fill, border or none). Bordered and tool      -->
    <!--   tiers fade by Button.DisabledOpacity; the filled tier keeps its fill but turns  -->
    <!--   neutral (Surface.Overlay + Text.Disabled), as WinUI does, so it stays readable. -->
    <!--   Focus: recolour border to accent + fade in inset focus ring. Thickness fixed.   -->
    <!-- ============================================================= -->
    <sys:Double x:Key="Button.DisabledOpacity">0.46</sys:Double>

    <!-- Interaction state layers. A template stacks them over its rest chrome, with the same
         corner radius and BorderThickness so the fill sits inside the chrome border. Triggers
         set FluidMotion.FadeTo; the layer's border is transparent unless a Windows contrast
         theme is on (Border.Hover), where the outline is what shows hover. -->
    <Style x:Key="StateLayer" TargetType="Border">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Hover}" />
    </Style>
    <Style x:Key="StateLayer.Hover" TargetType="Border" BasedOn="{StaticResource StateLayer}">
        <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
    </Style>
    <Style x:Key="StateLayer.Pressed" TargetType="Border" BasedOn="{StaticResource StateLayer}">
        <Setter Property="Background" Value="{DynamicResource Surface.Pressed}" />
    </Style>
    <Style x:Key="StateLayer.Selected" TargetType="Border" BasedOn="{StaticResource StateLayer}">
        <Setter Property="Background" Value="{DynamicResource Accent.Subtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Accent}" />
        <Setter Property="themes:FluidMotion.Transition" Value="Normal" />
    </Style>
    <!-- Template parts set motion through these styles rather than attached-property attributes,
         so the dictionary also loads as loose XAML (diagnostic and test fixtures). -->
    <Style x:Key="StatePart.Normal" TargetType="FrameworkElement">
        <Setter Property="themes:FluidMotion.Transition" Value="Normal" />
    </Style>
    <!-- A check mark or radio dot that settles from half size as its indicator fades in. -->
    <Style x:Key="StatePart.SettlingGlyph" TargetType="FrameworkElement" BasedOn="{StaticResource StatePart.Normal}">
        <Setter Property="themes:FluidMotion.ScaleTo" Value="0.5" />
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Overlay}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Control}" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.HitTarget}" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="themes:FluidMotion.PressFeedback" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Md}"
                                SnapsToDevicePixels="True" />
                        <!-- Hover strengthens the outline as well as the fill: the layer's own border
                             covers the chrome border while it shows. -->
                        <Border x:Name="HoverLayer"
                                Style="{StaticResource StateLayer.Hover}"
                                BorderBrush="{DynamicResource Border.Strong}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="PressedLayer"
                                Style="{StaticResource StateLayer.Pressed}"
                                BorderBrush="{DynamicResource Border.Strong}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <!-- Inset focus ring: no layout impact, toggled by opacity. -->
                        <Border x:Name="FocusRing"
                                Margin="1"
                                BorderBrush="{DynamicResource Border.Focus}"
                                BorderThickness="{DynamicResource Focus.RingThickness}"
                                CornerRadius="{DynamicResource Radius.Sm}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                            <Setter TargetName="HoverLayer" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                            <Setter TargetName="PressedLayer" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Accent}" />
                            <Setter TargetName="HoverLayer" Property="BorderBrush" Value="{DynamicResource Border.Accent}" />
                            <Setter TargetName="PressedLayer" Property="BorderBrush" Value="{DynamicResource Border.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Button.DisabledOpacity}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Accent.Default}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Md}"
                                SnapsToDevicePixels="True" />
                        <!-- The accent fill and its border change together, so these layers cover
                             the whole chrome. -->
                        <Border x:Name="HoverLayer"
                                Style="{StaticResource StateLayer}"
                                Background="{DynamicResource Accent.Hover}" />
                        <Border x:Name="PressedLayer"
                                Style="{StaticResource StateLayer}"
                                Background="{DynamicResource Accent.Pressed}" />
                        <Border BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="FocusRing"
                                Margin="2"
                                BorderBrush="{DynamicResource Text.OnAccent}"
                                BorderThickness="{DynamicResource Focus.RingThickness}"
                                CornerRadius="{DynamicResource Radius.Sm}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <!-- Like WinUI's disabled accent button: the fill stays but turns neutral
                             with disabled text. Fading the accent fill made its ink-on-accent
                             caption and shortcut drop to about 2:1 on dark themes. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.Overlay}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Surface.Overlay}" />
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PressedLayer" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" />
    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Md}"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="HoverLayer"
                                Style="{StaticResource StateLayer.Hover}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="PressedLayer"
                                Style="{StaticResource StateLayer.Pressed}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="FocusRing"
                                Margin="1"
                                BorderBrush="{DynamicResource Border.Focus}"
                                BorderThickness="{DynamicResource Focus.RingThickness}"
                                CornerRadius="{DynamicResource Radius.Sm}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover and press wash the background only; the tool tier stays borderless. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                        </Trigger>
                        <!-- Keyboard focus still recolours the fixed border so focus stays visible. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Button.DisabledOpacity}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Every destructive command (delete, move to the Recycle Bin, delete permanently, stop):
         the bordered tier with danger text and a danger outline that stays on hover and press.
         It is never the default button. High contrast maps State.Danger to the system text
         colour, so the outline and caption stay visible there too. -->
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource State.Danger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource State.Danger}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Md}"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="HoverLayer"
                                Style="{StaticResource StateLayer.Hover}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="PressedLayer"
                                Style="{StaticResource StateLayer.Pressed}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="FocusRing"
                                Margin="1"
                                BorderBrush="{DynamicResource Border.Focus}"
                                BorderThickness="{DynamicResource Focus.RingThickness}"
                                CornerRadius="{DynamicResource Radius.Sm}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Button.DisabledOpacity}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Button.Compact" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="{DynamicResource Size.HitTarget.Compact}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
    </Style>
    <Style x:Key="Button.GhostCompact" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="MinHeight" Value="{DynamicResource Size.HitTarget.Compact}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
    </Style>

    <!-- ============================================================= -->
    <!-- ToggleButton (base) + Tool variant -->
    <!--   Selected state uses accent border + subtle wash; focus is colour-only. -->
    <!-- ============================================================= -->
    <Style TargetType="{x:Type ToggleButton}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.HitTarget.Compact}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="themes:FluidMotion.PressFeedback" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Md}" />
                        <Border x:Name="HoverLayer"
                                Style="{StaticResource StateLayer.Hover}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <!-- Above the hover wash, so a checked tool keeps its selected fill on hover. -->
                        <Border x:Name="CheckedLayer"
                                Style="{StaticResource StateLayer.Selected}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="FocusRing"
                                Margin="1"
                                BorderBrush="{DynamicResource Border.Focus}"
                                BorderThickness="{DynamicResource Focus.RingThickness}"
                                CornerRadius="{DynamicResource Radius.Sm}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ToggleButton.Tool" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}" />

    <!-- Optional dialog settings use the same toggle chrome and live palette as the controls below. -->
    <Style x:Key="Expander.Options" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderToggle" HorizontalAlignment="Left" Padding="6"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
                            <StackPanel Orientation="Horizontal">
                                <themes:SymbolIcon x:Name="Chevron" Size="16" Data="{StaticResource Icon.ChevronDown}"
                                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                   VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <themes:SymbolIcon.RenderTransform>
                                        <RotateTransform Angle="-90" />
                                    </themes:SymbolIcon.RenderTransform>
                                </themes:SymbolIcon>
                                <ContentPresenter ContentSource="Header" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ContentPresenter x:Name="Options" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Options" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Chevron" Property="UIElement.RenderTransform">
                                <Setter.Value><RotateTransform Angle="0" /></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================= -->
    <!-- TextBox -->
    <!-- ============================================================= -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent.Default}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- 7 + a 14px line (18.6) + 7 + border stays inside the 36 hit target. -->
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.HitTarget}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Md}" />
                        <!-- Hover strengthens the outline only; an input keeps its well colour. -->
                        <Border x:Name="HoverLayer"
                                Style="{StaticResource StateLayer}"
                                BorderBrush="{DynamicResource Border.Strong}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <!-- TextBoxBase already applies Padding inside PART_ContentHost; a Margin here
                             inset the text twice and made every themed box about 53 DIP tall. The
                             host fills the box (multi-line boxes scroll in it) unless the box asks
                             for centred content, as single-line time boxes do. -->
                        <Border BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <Border x:Name="FocusRing"
                                Margin="1"
                                BorderBrush="{DynamicResource Border.Focus}"
                                BorderThickness="{DynamicResource Focus.RingThickness}"
                                CornerRadius="{DynamicResource Radius.Sm}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                            <Setter TargetName="HoverLayer" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.Raised}" />
                        </Trigger>
                        <Trigger Property="VerticalContentAlignment" Value="Center">
                            <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Center" />
                        </Trigger>
                        <Trigger Property="VerticalContentAlignment" Value="Bottom">
                            <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Bottom" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================= -->
    <!-- CheckBox -->
    <!-- ============================================================= -->
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="themes:FluidMotion.PressFeedback" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- PART_PressTarget takes the press feedback, so the label never scales. -->
                        <Grid x:Name="PART_PressTarget" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Border x:Name="Box"
                                    Background="{DynamicResource Surface.Sunken}"
                                    BorderBrush="{DynamicResource Border.Control}"
                                    BorderThickness="1"
                                    CornerRadius="5" />
                            <Border x:Name="HoverLayer"
                                    Style="{StaticResource StateLayer}"
                                    BorderBrush="{DynamicResource Border.Focus}"
                                    BorderThickness="1"
                                    CornerRadius="5" />
                            <!-- The accent box fades in while the check mark settles from a smaller size. -->
                            <Border x:Name="CheckedLayer"
                                    Style="{StaticResource StateLayer.Selected}"
                                    Background="{DynamicResource Accent.Default}"
                                    BorderBrush="{DynamicResource Accent.Default}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <Path x:Name="Check"
                                      Style="{StaticResource StatePart.SettlingGlyph}"
                                      Data="M 3,8 L 7,12 L 15,4"
                                      Stroke="{DynamicResource Text.OnAccent}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Border>
                            <!-- Inset focus ring, opacity-toggled (stable thickness). -->
                            <Border x:Name="FocusRing"
                                    Margin="-2"
                                    BorderBrush="{DynamicResource Border.Focus}"
                                    BorderThickness="{DynamicResource Focus.RingThickness}"
                                    CornerRadius="7"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                            <Setter TargetName="Check" Property="themes:FluidMotion.ScaleTo" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="CheckedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                            <Setter TargetName="Check" Property="Path.Data" Value="M 4,8 L 14,8" />
                            <Setter TargetName="Check" Property="themes:FluidMotion.ScaleTo" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================= -->
    <!-- RadioButton: same token language as CheckBox, round instead of boxed. -->
    <!-- ============================================================= -->
    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="themes:FluidMotion.PressFeedback" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- PART_PressTarget takes the press feedback, so the label never scales. -->
                        <Grid x:Name="PART_PressTarget" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse x:Name="Dot"
                                     Fill="{DynamicResource Surface.Sunken}"
                                     Stroke="{DynamicResource Border.Control}"
                                     StrokeThickness="1" />
                            <Ellipse x:Name="HoverRing"
                                     Stroke="{DynamicResource Border.Focus}"
                                     StrokeThickness="1"
                                     IsHitTestVisible="False"
                                     Opacity="0" />
                            <!-- The accent disc fades in while the centre dot settles from a smaller size. -->
                            <Grid x:Name="CheckedLayer"
                                  Style="{StaticResource StatePart.Normal}"
                                  IsHitTestVisible="False"
                                  Opacity="0">
                                <Ellipse Fill="{DynamicResource Accent.Default}" />
                                <Ellipse x:Name="Check" Width="8" Height="8"
                                         Style="{StaticResource StatePart.SettlingGlyph}"
                                         Fill="{DynamicResource Text.OnAccent}" />
                            </Grid>
                            <!-- Inset focus ring, opacity-toggled (stable thickness). -->
                            <Ellipse x:Name="FocusRing"
                                     Margin="-2"
                                     Stroke="{DynamicResource Border.Focus}"
                                     StrokeThickness="{DynamicResource Focus.RingWidth}"
                                     IsHitTestVisible="False"
                                     Opacity="0" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverRing" Property="themes:FluidMotion.FadeTo" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                            <Setter TargetName="Check" Property="themes:FluidMotion.ScaleTo" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Border.Focus}" />
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================= -->
    <!-- Tabs / Lists -->
    <!-- ============================================================= -->
    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <!-- The gap between tabs lives inside the template. TabPanel arranges each tab in its
         desired size minus the tab's Margin, so a positive Margin clipped every tab's right and
         bottom border by the margin's width. -->
    <Style x:Key="Tab.Help" TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid Margin="0,0,6,4">
                        <Border x:Name="TabBorder" Background="{DynamicResource Surface.Raised}"
                                BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                                CornerRadius="8" />
                        <Border x:Name="HoverLayer" Style="{StaticResource StateLayer.Hover}"
                                BorderThickness="1" CornerRadius="8" />
                        <Border x:Name="SelectedLayer" Style="{StaticResource StateLayer.Selected}"
                                BorderBrush="{DynamicResource Accent.Default}" BorderThickness="1" CornerRadius="8" />
                        <Border BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Accent.Default}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <!-- ============================================================= -->
    <!-- Tooltip / Menus / Slider -->
    <!-- ============================================================= -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Floating}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
    </Style>
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource Surface.Floating}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Md}"
                            Padding="{TemplateBinding Padding}"
                            Effect="{DynamicResource Shadow.Card}"
                            SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Radius.Sm}"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="HoverLayer" Style="{StaticResource StateLayer.Hover}"
                                BorderThickness="1" CornerRadius="{DynamicResource Radius.Sm}" />
                        <Border x:Name="PressedLayer" Style="{StaticResource StateLayer.Pressed}"
                                BorderThickness="1" CornerRadius="{DynamicResource Radius.Sm}" />
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="IconHost"
                                              ContentSource="Icon"
                                              Width="18" Height="18"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,22,0"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                            <TextBlock x:Name="GestureText" Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource Text.Muted}"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       VerticalAlignment="Center" />
                            <Border x:Name="SubmenuArrow" Grid.Column="2" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <!-- Scale the authored 20px grid, including its 1.6 stroke. -->
                                <Viewbox Width="16" Height="16">
                                    <Viewbox.LayoutTransform>
                                        <RotateTransform Angle="-90" />
                                    </Viewbox.LayoutTransform>
                                    <Canvas Width="20" Height="20">
                                        <Path Data="{DynamicResource Icon.ChevronDown}"
                                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>
                        <!-- Native MenuItem owns pointer/keyboard opening and screen-edge placement. -->
                        <Popup x:Name="PART_Popup" Placement="Right" AllowsTransparency="True"
                               Focusable="False" IsOpen="{TemplateBinding IsSubmenuOpen}"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="{DynamicResource Surface.Floating}"
                                    BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Md}" Padding="5"
                                    SnapsToDevicePixels="True"
                                    MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}">
                                <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                    KeyboardNavigation.TabNavigation="Cycle" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="SubmenuArrow" Property="UIElement.Visibility" Value="Visible" />
                            <Setter TargetName="GestureText" Property="UIElement.Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="PressedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.46" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type Separator}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="1" Margin="30,5,8,5"
                            Background="{DynamicResource Border.Subtle}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Keep the native ComboBox selection, text search and popup behaviour, but own its chrome. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid>
                        <Border x:Name="ItemChrome" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" />
                        <Border x:Name="SelectedLayer" Style="{StaticResource StateLayer.Selected}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" />
                        <Border x:Name="HoverLayer" Style="{StaticResource StateLayer.Hover}"
                                BorderBrush="{DynamicResource Border.Focus}" BorderThickness="1" CornerRadius="4" />
                        <Border BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                        </Trigger>
                        <!-- A contrast theme keeps ordinary washes on Window; the selected and highlighted
                             rows use the system selection pair instead. Bound to the live setting. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True" />
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                            <Setter TargetName="SelectedLayer" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True" />
                                <Condition Binding="{Binding IsHighlighted, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                            <Setter TargetName="HoverLayer" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            <Setter TargetName="HoverLayer" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                        </MultiDataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.46" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource Surface.Overlay}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5,32,5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="ComboChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" />
                        <Border x:Name="HoverLayer" Style="{StaticResource StateLayer}"
                                BorderBrush="{DynamicResource Border.Strong}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" />
                        <ToggleButton x:Name="DropDownToggle" Style="{x:Null}" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                              StrokeThickness="1.5" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" Margin="0,0,12,0" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Selection" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Visibility="Collapsed" MinHeight="0"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" Background="Transparent"
                                 Foreground="{TemplateBinding Foreground}" BorderThickness="0"
                                 Padding="0" Margin="{TemplateBinding Padding}" VerticalContentAlignment="Center" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border x:Name="PopupChrome" Background="{DynamicResource Surface.Overlay}" BorderBrush="{DynamicResource Border.Strong}"
                                    BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,3,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <!-- Contrast themes need no extra triggers here: every token the chrome uses
                         already resolves to the system palette (ThemeService). -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                            <Setter TargetName="HoverLayer" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                            <Setter TargetName="HoverLayer" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="Selection" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.46" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ============================================================= -->
    <!-- Slider: 4px rounded track, Foreground fills the value part,    -->
    <!-- 16px round thumb whose accent centre grows on hover. The Track -->
    <!-- stays PART_Track with its two page RepeatButtons and Thumb, so -->
    <!-- Slider keeps keyboard steps, Home/End, tick snapping, move-to- -->
    <!-- point and its RangeValue automation peer.                      -->
    <!-- ============================================================= -->
    <Style x:Key="Slider.TrackButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <!-- The full control height pages the value; only the 4px bar is drawn. -->
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Slider.TrackButton.Vertical" TargetType="RepeatButton" BasedOn="{StaticResource Slider.TrackButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Width="4" CornerRadius="2" HorizontalAlignment="Center"
                                Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Slider.Thumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!-- Transparent across the track height, so the grab area is taller than the disc. -->
                    <Grid Background="Transparent">
                        <Ellipse Width="16" Height="16"
                                 Fill="{DynamicResource Surface.Raised}"
                                 Stroke="{DynamicResource Border.Control}"
                                 StrokeThickness="1" />
                        <Ellipse x:Name="Centre" Width="10" Height="10"
                                 Fill="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Centre" Property="themes:FluidMotion.ScaleTo" Value="1.2" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Centre" Property="themes:FluidMotion.ScaleTo" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Slider.Thumb.Vertical" TargetType="Thumb" BasedOn="{StaticResource Slider.Thumb}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="16" />
    </Style>
    <ControlTemplate x:Key="Slider.HorizontalTemplate" TargetType="Slider">
        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TickBar x:Name="TopTick" Grid.Row="0" Height="4" Placement="Top"
                     Fill="{DynamicResource Text.Muted}" Visibility="Collapsed" />
            <Track x:Name="PART_Track" Grid.Row="1">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource Slider.TrackButton}"
                                  Background="{TemplateBinding Foreground}"
                                  Command="{x:Static Slider.DecreaseLarge}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="Thumb" Style="{StaticResource Slider.Thumb}" Foreground="{TemplateBinding Foreground}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource Slider.TrackButton}"
                                  Background="{DynamicResource Border.Control}"
                                  Command="{x:Static Slider.IncreaseLarge}" />
                </Track.IncreaseRepeatButton>
            </Track>
            <TickBar x:Name="BottomTick" Grid.Row="2" Height="4" Placement="Bottom"
                     Fill="{DynamicResource Text.Muted}" Visibility="Collapsed" />
            <!-- Outset ring: the thumb reaches both ends of the control at its limits. -->
            <Border x:Name="FocusRing" Grid.RowSpan="3" Margin="-4,0"
                    BorderBrush="{DynamicResource Border.Focus}"
                    BorderThickness="{DynamicResource Focus.RingThickness}"
                    CornerRadius="{DynamicResource Radius.Sm}"
                    IsHitTestVisible="False" Opacity="0" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="TickPlacement" Value="TopLeft">
                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="BottomRight">
                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="Both">
                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.46" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="Slider.VerticalTemplate" TargetType="Slider">
        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TickBar x:Name="TopTick" Grid.Column="0" Width="4" Placement="Left"
                     Fill="{DynamicResource Text.Muted}" Visibility="Collapsed" />
            <Track x:Name="PART_Track" Grid.Column="1">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource Slider.TrackButton.Vertical}"
                                  Background="{TemplateBinding Foreground}"
                                  Command="{x:Static Slider.DecreaseLarge}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="Thumb" Style="{StaticResource Slider.Thumb.Vertical}" Foreground="{TemplateBinding Foreground}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource Slider.TrackButton.Vertical}"
                                  Background="{DynamicResource Border.Control}"
                                  Command="{x:Static Slider.IncreaseLarge}" />
                </Track.IncreaseRepeatButton>
            </Track>
            <TickBar x:Name="BottomTick" Grid.Column="2" Width="4" Placement="Right"
                     Fill="{DynamicResource Text.Muted}" Visibility="Collapsed" />
            <Border x:Name="FocusRing" Grid.ColumnSpan="3" Margin="0,-4"
                    BorderBrush="{DynamicResource Border.Focus}"
                    BorderThickness="{DynamicResource Focus.RingThickness}"
                    CornerRadius="{DynamicResource Radius.Sm}"
                    IsHitTestVisible="False" Opacity="0" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="TickPlacement" Value="TopLeft">
                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="BottomRight">
                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="Both">
                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.46" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="{x:Type Slider}">
        <Setter Property="Foreground" Value="{DynamicResource Accent.Default}" />
        <Setter Property="Background" Value="Transparent" />
        <!-- The track is 4px, but the whole 32px row takes pointer input. -->
        <Setter Property="MinHeight" Value="{DynamicResource Size.HitTarget.Compact}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource Slider.HorizontalTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="{DynamicResource Size.HitTarget.Compact}" />
                <Setter Property="Template" Value="{StaticResource Slider.VerticalTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================= -->
    <!-- Reusable icon styles (consume Symbols.xaml geometries)          -->
    <!--   themes:SymbolIcon draws the 20x20 grid scaled as a whole, so   -->
    <!--   every glyph keeps its proportions and one size has one stroke. -->
    <!--   Sizes: 16 menus/inline, 20 commands, 12-14 only for badges.    -->
    <!--   Usage: <themes:SymbolIcon Style="{StaticResource Icon.Symbol}" -->
    <!--               Data="{StaticResource Icon.Save}" Size="20"/>       -->
    <!--   Without a style the stroke follows the control's Foreground.   -->
    <!-- ============================================================= -->
    <Style x:Key="Icon.Symbol" TargetType="themes:SymbolIcon">
        <Setter Property="Size" Value="20" />
        <Setter Property="Stroke" Value="{DynamicResource Text.Secondary}" />
    </Style>
    <Style x:Key="Icon.Symbol.Primary" TargetType="themes:SymbolIcon" BasedOn="{StaticResource Icon.Symbol}">
        <Setter Property="Stroke" Value="{DynamicResource Text.Primary}" />
    </Style>
    <Style x:Key="Icon.Symbol.Muted" TargetType="themes:SymbolIcon" BasedOn="{StaticResource Icon.Symbol}">
        <Setter Property="Stroke" Value="{DynamicResource Text.Muted}" />
    </Style>
    <Style x:Key="Icon.Symbol.Accent" TargetType="themes:SymbolIcon" BasedOn="{StaticResource Icon.Symbol}">
        <Setter Property="Stroke" Value="{DynamicResource Accent.Default}" />
    </Style>
    <Style x:Key="Icon.Symbol.OnAccent" TargetType="themes:SymbolIcon" BasedOn="{StaticResource Icon.Symbol}">
        <Setter Property="Stroke" Value="{DynamicResource Text.OnAccent}" />
    </Style>
    <Style x:Key="Icon.Symbol.Danger" TargetType="themes:SymbolIcon" BasedOn="{StaticResource Icon.Symbol}">
        <Setter Property="Stroke" Value="{DynamicResource State.DangerHover}" />
    </Style>
    <Style x:Key="Icon.Symbol.Filled" TargetType="themes:SymbolIcon" BasedOn="{StaticResource Icon.Symbol}">
        <Setter Property="Fill" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="StrokeThickness" Value="0.6" />
    </Style>

    <!-- Compatibility names use the same fixed-grid renderer as Icon.Symbol. -->
    <Style x:Key="Icon.Glyph" TargetType="themes:SymbolIcon" BasedOn="{StaticResource Icon.Symbol}" />
    <Style x:Key="Icon.Glyph.Primary" TargetType="themes:SymbolIcon" BasedOn="{StaticResource Icon.Symbol.Primary}" />
    <Style x:Key="Icon.Glyph.Muted" TargetType="themes:SymbolIcon" BasedOn="{StaticResource Icon.Symbol.Muted}" />
    <Style x:Key="Icon.Glyph.Accent" TargetType="themes:SymbolIcon" BasedOn="{StaticResource Icon.Symbol.Accent}" />
    <Style x:Key="Icon.Glyph.OnAccent" TargetType="themes:SymbolIcon" BasedOn="{StaticResource Icon.Symbol.OnAccent}" />
    <Style x:Key="Icon.Glyph.Danger" TargetType="themes:SymbolIcon" BasedOn="{StaticResource Icon.Symbol.Danger}" />
    <Style x:Key="Icon.Glyph.Filled" TargetType="themes:SymbolIcon" BasedOn="{StaticResource Icon.Symbol.Filled}" />

    <!-- The embedded multi-resolution ICO is used consistently in window chrome and
         top-level product headers. It remains decorative beside the visible product name. -->
    <Style x:Key="Brand.AppIcon" TargetType="Image">
        <Setter Property="Source" Value="/MyCapture;component/Assets/app.ico" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Icon-only button: square hit target, transparent chrome, glyph inherits colour.
         Consumers set Content to a themes:SymbolIcon (stroke follows Foreground) and MUST supply
         AutomationProperties.Name + ToolTip for accessibility. -->
    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="MinWidth" Value="{DynamicResource Size.HitTarget}" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.HitTarget}" />
        <Setter Property="Padding" Value="6" />
    </Style>
    <Style x:Key="Button.Icon.Compact" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="5" />
    </Style>

    <!-- ============================================================= -->
    <!-- Left tool rail: compact desktop activity rail                  -->
    <!--   Fixed 40px icon targets; meaning is carried by tooltip,      -->
    <!--   automation name, shortcut and the contextual inspector.      -->
    <!-- ============================================================= -->
    <Style x:Key="Rail.Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="6,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Rail.ToolButton" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Md}" />
                        <Border x:Name="HoverLayer" Style="{StaticResource StateLayer.Hover}" BorderThickness="1" />
                        <Border x:Name="PressedLayer" Style="{StaticResource StateLayer.Pressed}" BorderThickness="1" />
                        <!-- Selection fills the tool's own tile. -->
                        <Border x:Name="CheckedLayer" Style="{StaticResource StateLayer.Selected}"
                                Background="{DynamicResource Accent.Default}"
                                BorderBrush="Transparent" BorderThickness="1" />
                        <Border BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="FocusRing"
                                Margin="1"
                                BorderBrush="{DynamicResource Border.Focus}"
                                BorderThickness="{DynamicResource Focus.RingThickness}"
                                CornerRadius="{DynamicResource Radius.Sm}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckedLayer" Property="themes:FluidMotion.FadeTo" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.46" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================= -->
    <!-- Right inspector                                                -->
    <!-- ============================================================= -->
    <Style x:Key="Inspector.Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Panel}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- Inspector section heading (small, uppercase-free sentence case). -->
    <Style x:Key="Inspector.SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <!-- Inspector guidance sentence: plain-language instruction. -->
    <Style x:Key="Inspector.Guidance" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <!-- ============================================================= -->
    <!-- Status bar + status chip                                       -->
    <!--   Live instruction / completion feedback surface.              -->
    <!-- ============================================================= -->
    <Style x:Key="StatusBar.Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Overlay}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="StatusBar.Text" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Compact rounded status chip (neutral by default). -->
    <Style x:Key="StatusChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="StatusChip.Success" TargetType="Border" BasedOn="{StaticResource StatusChip}">
        <Setter Property="BorderBrush" Value="{DynamicResource State.Success}" />
    </Style>
    <Style x:Key="StatusChip.Warning" TargetType="Border" BasedOn="{StaticResource StatusChip}">
        <Setter Property="BorderBrush" Value="{DynamicResource State.Warning}" />
    </Style>
    <Style x:Key="StatusChip.Text" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Native scrolling behaviour, with the same graphite surfaces as the surrounding UI.
         Resolve palette brushes on the control so separately loaded merged dictionaries also
         work in isolated window/diagnostic hosts without Application.Resources. -->
    <Style x:Key="ScrollBar.PageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource Border.Strong}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Grip" Background="{TemplateBinding Background}"
                            CornerRadius="4" Margin="3" MinWidth="8" MinHeight="8" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Text.Muted}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent.Default}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource Surface.Base}" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="Decrease" Style="{StaticResource ScrollBar.PageButton}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBar.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="Increase" Style="{StaticResource ScrollBar.PageButton}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand" />
                            <Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="16" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
