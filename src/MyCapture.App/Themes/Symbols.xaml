<!--
  MyCapture desktop symbol family.

  Every glyph is authored on the same 20x20 coordinate grid and rendered with a 1.6px
  round stroke. The fixed grid is intentional: the editor wraps these geometries in a
  20x20 canvas before scaling, so narrow symbols no longer inflate while wide symbols
  shrink. Regular outline glyphs provide wayfinding; selected state comes from the control's
  accent foreground, background wash, and indicator rather than a second mismatched family.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Editing tools -->
    <PathGeometry x:Key="Icon.Select"
                  Figures="M4.25,2.75 L4.25,15.75 L7.55,12.55 L10.15,17.25 L12.3,16.05 L9.7,11.55 L14.5,11.55 Z" />
