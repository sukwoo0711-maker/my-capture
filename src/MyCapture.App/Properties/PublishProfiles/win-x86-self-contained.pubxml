<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PlatformTarget>x86</PlatformTarget>
    <SelfContained>true</SelfContained>
    <PublishSelfContained>true</PublishSelfContained>
    <UseAppHost>true</UseAppHost>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Only the Windows projection is linked; -p:MyCaptureTrimWindowsProjection=false diagnoses the original SDK. -->
    <MyCaptureTrimWindowsProjection Condition="'$(Configuration)' == 'Release'">true</MyCaptureTrimWindowsProjection>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
