<Project Sdk="Microsoft.NET.Sdk">

  <!--
    No UseWPF here on purpose. The domain layer (annotation model, capture queue,
    settings) is deliberately free of WPF types so it can be exercised by unit
    tests without a dispatcher, and so the persisted JSON shape is owned by this
    project rather than inherited from a UI framework. Conversion to WPF types
    happens at the App boundary.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>MyCapture.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
