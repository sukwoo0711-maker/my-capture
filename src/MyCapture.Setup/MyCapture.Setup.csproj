<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- In-box on Windows 10 22H2 and Windows 11: setup needs no PowerShell and no .NET 10 runtime. -->
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>MyCaptureSetup</AssemblyName>
    <RootNamespace>MyCapture.Setup</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Serialization" />
    <!-- Tests substitute the updater boundary folders without touching real system folders. -->
    <InternalsVisibleTo Include="MyCapture.Setup.Tests" />
  </ItemGroup>
</Project>
