<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- In-box on Windows 10 22H2 and Windows 11: setup needs no PowerShell and no .NET 10 runtime. -->
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MyCaptureSetup</AssemblyName>
    <RootNamespace>MyCapture.Setup</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../MyCapture.App/Assets/app.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'arm64'">
    <!-- Setup runs on the in-box .NET Framework 4.8, and a native ARM64 process needs 4.8.1. The
         arm64 package therefore carries the x64 setup, which Windows 11 on ARM runs under
         emulation exactly as it does for the x64 package. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- Tests substitute the updater boundary folders without touching real system folders. -->
    <InternalsVisibleTo Include="MyCapture.Setup.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\RecoverableFileRemoval.cs" Link="Storage\RecoverableFileRemoval.cs" />
  </ItemGroup>
</Project>
