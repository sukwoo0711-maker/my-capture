<Project>

  <PropertyGroup>
    <!--
      Windows 10 22H2 (build 19045) is the x64 and x86 host floor. SupportedOSPlatformVersion selects
      its shared 19041 API contract; WindowsSupportPolicy and package metadata enforce 19045.
      Keep the 22000 TFM for optional Windows 11 WinRT members, guarded at runtime.
      arm64 is the native Windows on ARM build. x64 stays the default platform on every build host.
    -->
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Platforms>x64;x86;arm64</Platforms>
    <PlatformTarget Condition="'$(PlatformTarget)' == '' and ('$(Platform)' == 'x86' or '$(RuntimeIdentifier)' == 'win-x86')">x86</PlatformTarget>
    <PlatformTarget Condition="'$(PlatformTarget)' == '' and ('$(Platform)' == 'arm64' or '$(RuntimeIdentifier)' == 'win-arm64')">arm64</PlatformTarget>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>

    <InvariantGlobalization>false</InvariantGlobalization>
    <NeutralLanguage>ko-KR</NeutralLanguage>

    <Company>MyCapture</Company>
    <Product>MyCapture</Product>
    <Authors>MyCapture contributors</Authors>
    <RepositoryUrl>https://github.com/sukwoo0711-maker/my-capture</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- The application and its implementation libraries are shipped together as the
         verified desktop bundle; none is an independently supported NuGet package. -->
    <IsPackable>false</IsPackable>
    <Version>5.3.1</Version>
    <FileVersion>5.3.1.0</FileVersion>
    <AssemblyVersion>5.3.1.0</AssemblyVersion>
    <Copyright>Copyright (c) 2026 MyCapture contributors</Copyright>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>

